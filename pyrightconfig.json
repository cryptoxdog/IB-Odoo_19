{
  "include": [
    "plasticos_*/**/*.py",
    "ci/**/*.py",
    "scripts/**/*.py",
    "tools/**/*.py"
  ],
  "exclude": [
    "**/__pycache__",
    "**/node_modules",
    ".venv",
    "venv",
    "addons",
    "tests-odoo",
    "docs"
  ],
  "extraPaths": [
    "/opt/odoo/odoo",
    "/opt/odoo/addons"
  ],
  "pythonVersion": "3.12",
  "typeCheckingMode": "off",
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none",
  "reportOptionalMemberAccess": "none",
  "reportGeneralTypeIssues": "none"
}
