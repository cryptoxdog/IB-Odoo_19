<?xml version="1.0" encoding="utf-8"?>
<!--
    Linda buyer SO issuance message (WP01b; BRS-01-R001, BRS-05-R029, plan A03/A19).
    Buyer-only content: no supplier, purchase order, buying cost or pickup identity.
    The attachment is the native Odoo sale order PDF for the released revision.
    Recipients are set by plasticos.logistics.request, never from followers or CC.
-->
<odoo noupdate="1">
    <record id="mail_template_linda_so_issue" model="mail.template">
        <field name="name">Linda: Sale Order to Buyer</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="email_from">Scrap Management Logistics &lt;logistics2@scrapmanagement.com&gt;</field>
        <field name="reply_to">Scrap Management Logistics &lt;logistics2@scrapmanagement.com&gt;</field>
        <field name="subject">Sales Order {{ object.name }} - order confirmation</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="use_default_to" eval="False"/>
        <field name="auto_delete" eval="False"/>
        <field name="report_template_ids" eval="[(6, 0, [ref('sale.action_report_saleorder')])]"/>
        <field name="description">Initial buyer issue of a confirmed sale order, sent by Linda in live mode.</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 14px;">
    <p>Hello <t t-out="object.partner_id.name or ''">Buyer</t>,</p>
    <p>
        Please find attached sales order <strong t-out="object.name or ''">S00001</strong>
        <t t-if="object.client_order_ref">(your reference <t t-out="object.client_order_ref or ''">REF</t>)</t>.
    </p>
    <ul>
        <t t-foreach="object.order_line.filtered(lambda line: not line.display_type)" t-as="line">
            <li>
                <t t-out="line.product_id.display_name or line.name or ''">Material</t>:
                <t t-out="line.product_uom_qty">1.0</t> <t t-out="line.product_uom_id.name or ''">lb</t>
            </li>
        </t>
    </ul>
    <p>Please reply to confirm this order and send your receiving details:</p>
    <ul>
        <li>Receiving hours and any appointment requirement</li>
        <li>Receiving contact name and phone</li>
    </ul>
    <p>Thank you,<br/>Scrap Management Logistics</p>
</div>
        </field>
    </record>
</odoo>
