<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Linda supplier copy of the native purchase order report.
        The Print menu stays on purchase.report_purchaseorder. This variant is
        attached only when a dropship PO is issued to the supplier. The context
        flag hides dest_address_id; without it the native shipping block is unchanged.
        purchase_stock's following t-else then prints the warehouse, not the buyer.
    -->
    <template id="report_purchaseorder_document_linda_supplier" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//t[@t-if='o.dest_address_id']" position="attributes">
            <attribute name="t-if">o.dest_address_id and not o.env.context.get('linda_supplier_copy')</attribute>
        </xpath>
    </template>

    <template id="report_purchaseorder_supplier">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="purchase.report_purchaseorder_document" t-lang="o.partner_id.lang">
                    <t t-set="o" t-value="o.with_context(linda_supplier_copy=True)"/>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_purchase_order_supplier" model="ir.actions.report">
        <field name="name">Purchase Order</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">plasticos_logistics.report_purchaseorder_supplier</field>
        <field name="report_file">plasticos_logistics.report_purchaseorder_supplier</field>
        <field name="print_report_name">'Purchase Order - %s' % (object.name)</field>
    </record>
</odoo>
