<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════
         DELIVERY ORDER
         Dispatch/routing instructions for carrier
         ═══════════════════════════════════════════════════════════════════ -->

    <template id="report_delivery_order">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Header with Company Info -->
                        <table class="table" style="margin-bottom: 20px;">
                            <tr>
                                <td style="width: 60%; vertical-align: top;">
                                    <h1 style="margin: 0; font-weight: bold; font-size: 28px;">DELIVERY ORDER</h1>
                                </td>
                                <td style="width: 40%; text-align: right; vertical-align: top;">
                                    <div style="font-size: 18px; font-weight: bold;">
                                        NO. <t t-out="doc.name"/>
                                    </div>
                                    <div>
                                        <t t-out="doc.create_date" t-options='{"widget": "date", "format": "MM/dd/yyyy"}'/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Company Header -->
                        <div style="margin-bottom: 20px;">
                            <t t-if="doc.sale_order_id.company_id">
                                <strong style="font-size: 14px;"><t t-out="doc.sale_order_id.company_id.name"/></strong><br/>
                                <t t-out="doc.sale_order_id.company_id.street or ''"/><br/>
                                <t t-out="doc.sale_order_id.company_id.city or ''"/>
                                <t t-out="doc.sale_order_id.company_id.state_id.code or ''"/>
                                <t t-out="doc.sale_order_id.company_id.zip or ''"/><br/>
                                <t t-if="doc.sale_order_id.company_id.website">
                                    <t t-out="doc.sale_order_id.company_id.website"/>
                                </t>
                            </t>
                        </div>

                        <!-- Carrier Assignment -->
                        <table class="table table-bordered" style="margin-bottom: 15px;">
                            <tr style="background-color: #f0f0f0;">
                                <th>TO:</th>
                                <th>ATTENTION:</th>
                                <th>PHONE NO:</th>
                            </tr>
                            <tr>
                                <td>
                                    <t t-out="doc.carrier_id.name or ''"/><br/>
                                    <t t-out="doc.carrier_contact_phone or ''"/>
                                </td>
                                <td><t t-out="doc.carrier_contact_name or ''"/></td>
                                <td><t t-out="doc.carrier_contact_phone or ''"/></td>
                            </tr>
                        </table>

                        <!-- Rate and Special Instructions -->
                        <table class="table table-bordered" style="margin-bottom: 15px;">
                            <tr>
                                <td style="width: 50%;">
                                    <strong>RATE:</strong>
                                    <t t-out="'%.2f' % doc.rate_amount"/> USD
                                </td>
                                <td style="width: 50%;">
                                    <t t-if="doc.double_blind">
                                        <strong>DOUBLE BLIND</strong>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <t t-if="doc.straps_bars_needed">
                                        <strong>STRAPS/BARS NEEDED TO SECURE CARGO</strong>
                                    </t>
                                </td>
                            </tr>
                        </table>

                        <!-- Comments -->
                        <div style="margin-bottom: 15px;">
                            <strong>COMMENTS:</strong><br/>
                            <t t-out="doc.notes or ''"/>
                        </div>

                        <!-- Shipper Info -->
                        <div style="margin-bottom: 10px; border: 1px solid #ccc; padding: 10px;">
                            <strong>SHIPPER NAME:</strong> <t t-out="doc.sale_order_id.company_id.name or ''"/><br/>
                            <strong>CONTACTS:</strong>
                            <!-- Company contacts would go here - using company email/phone -->
                            <t t-if="doc.sale_order_id.company_id.email">
                                <t t-out="doc.sale_order_id.company_id.email"/>
                            </t>
                            <t t-if="doc.sale_order_id.company_id.phone">
                                (<t t-out="doc.sale_order_id.company_id.phone"/>)
                            </t>
                        </div>

                        <!-- PICKUP Section -->
                        <table class="table table-bordered" style="margin-bottom: 15px;">
                            <tr style="background-color: #e8e8e8;">
                                <th colspan="2">PICKUP INFORMATION</th>
                            </tr>
                            <tr>
                                <td style="width: 50%;">
                                    <strong>PICKUP FOR:</strong> <t t-out="doc.sale_order_id.company_id.name or ''"/>
                                </td>
                                <td style="width: 50%;">
                                    <strong>PICKUP DATE:</strong>
                                    <t t-out="doc.pickup_datetime" t-options='{"widget": "datetime", "format": "MM/dd/yy h:mma"}'/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>PICKUP AT:</strong><br/>
                                    <t t-if="doc.pickup_partner_id">
                                        <t t-out="doc.pickup_partner_id.name"/><br/>
                                        <t t-out="doc.pickup_partner_id.street or ''"/><br/>
                                        <t t-out="(doc.pickup_partner_id.city or '').upper()"/>,
                                        <t t-out="doc.pickup_partner_id.state_id.code or ''"/>
                                        <t t-out="doc.pickup_partner_id.zip or ''"/>
                                    </t>
                                </td>
                                <td>
                                    <strong>PO #:</strong> <t t-out="doc.pickup_reference or ''"/><br/>
                                    <strong>PICKUP #:</strong>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>CONTACT:</strong> <t t-out="doc.pickup_contact_name or ''"/><br/>
                                    <strong>WORK:</strong> <t t-out="doc.pickup_contact_phone or ''"/><br/>
                                    <strong>MOBILE:</strong> <t t-out="doc.pickup_contact_mobile or ''"/>
                                </td>
                                <td>
                                    <strong>LOADING HOURS:</strong> <t t-out="doc.pickup_hours or 'M-F: CALL FOR APPOINTMENT'"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>SPECIAL INSTRUCTIONS:</strong><br/>
                                    <t t-out="doc.pickup_instructions or ''"/>
                                </td>
                            </tr>
                        </table>

                        <!-- DELIVERY Section -->
                        <table class="table table-bordered" style="margin-bottom: 15px;">
                            <tr style="background-color: #e8e8e8;">
                                <th colspan="2">DELIVERY INFORMATION</th>
                            </tr>
                            <tr>
                                <td style="width: 50%;">
                                    <strong>DELIVERY FOR:</strong> <t t-out="doc.sale_order_id.company_id.name or ''"/>
                                </td>
                                <td style="width: 50%;">
                                    <strong>REFERENCE/PO #:</strong> <t t-out="doc.delivery_reference or ''"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>DELIVERY TO:</strong><br/>
                                    <t t-if="doc.delivery_partner_id">
                                        <t t-out="doc.delivery_partner_id.name"/><br/>
                                        <t t-out="doc.delivery_partner_id.street or ''"/><br/>
                                        <t t-out="(doc.delivery_partner_id.city or '').upper()"/>,
                                        <t t-out="doc.delivery_partner_id.state_id.code or ''"/>
                                        <t t-out="doc.delivery_partner_id.zip or ''"/>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>CONTACT:</strong> <t t-out="doc.delivery_contact_name or ''"/><br/>
                                    <strong>WORK:</strong> <t t-out="doc.delivery_contact_phone or ''"/><br/>
                                    <strong>MOBILE:</strong> <t t-out="doc.delivery_contact_mobile or ''"/>
                                </td>
                                <td>
                                    <strong>UNLOADING HOURS:</strong> <t t-out="doc.delivery_hours or 'M-F: 9:00 AM - 3:00 PM'"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>SPECIAL INSTRUCTIONS:</strong><br/>
                                    <t t-out="doc.delivery_instructions or ''"/><br/>
                                    <t t-if="doc.delivery_datetime">
                                        Delivery <t t-out="doc.delivery_datetime" t-options='{"widget": "datetime", "format": "MM/dd/yy h-ha"}'/>
                                    </t>
                                </td>
                            </tr>
                        </table>

                        <!-- Document Submission -->
                        <div style="margin-bottom: 15px; text-align: center;">
                            <strong>Send All Docs to
                                <t t-if="doc.sale_order_id.company_id.email">
                                    <t t-out="doc.sale_order_id.company_id.email"/>
                                </t>
                            </strong>
                        </div>

                        <!-- Legal Footer -->
                        <div style="font-size: 10px; text-align: justify; border-top: 2px solid #000; padding-top: 10px;">
                            By Accepting This Delivery Order, The Above Named Trucker Agrees To Obtain LIGHT &amp; HEAVY 3rd Party Certified Scale
                            Tickets &amp; PROTECT THE BLIND PICK UP By Using The BOL-PICKUP Document Prepared By
                            <t t-out="doc.sale_order_id.company_id.name or 'Company'"/>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
