<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- S11 (OP11-E02): Linda's edge cases waiting for their owning role (DEC-011).
         Approve runs the held command as Linda; Reject records the refusal. The
         buttons enforce the (command, edge case) authority table server-side, so they are
         shown to all readers: a hidden or shown button is never the control. -->
    <record id="view_linda_approval_search" model="ir.ui.view">
        <field name="name">plasticos.linda.approval.search</field>
        <field name="model">plasticos.linda.approval</field>
        <field name="arch" type="xml">
            <search>
                <field name="operation_key"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="filter_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_decided" string="Decided" domain="[('state', 'in', ('approved', 'rejected'))]"/>
                <filter name="filter_refused" string="Refusals" domain="[('state', '=', 'refused')]"/>
                <separator/>
                <filter name="filter_logistics" string="Logistics Decides"
                        domain="[('state', '=', 'pending'), ('routed_role', '=', 'logistics_ops')]"/>
                <filter name="filter_operations" string="Operations Manager Decides"
                        domain="[('state', '=', 'pending'), ('routed_role', '=', 'operations_manager')]"/>
                <filter name="filter_rerouted" string="Re-routed" domain="[('rerouted_at', '!=', False)]"/>
                <separator/>
                <filter name="group_routed_role" string="Owning Role" context="{'group_by': 'routed_role'}"/>
                <filter name="group_command" string="Command" context="{'group_by': 'command'}"/>
                <filter name="group_edge_case" string="Edge Case" context="{'group_by': 'edge_case'}"/>
            </search>
        </field>
    </record>

    <record id="view_linda_approval_list" model="ir.ui.view">
        <field name="name">plasticos.linda.approval.list</field>
        <field name="model">plasticos.linda.approval</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="requested_at"/>
                <field name="command"/>
                <field name="edge_case"/>
                <field name="edge_reason" optional="show"/>
                <field name="routed_role"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="operation_key" optional="hide"/>
                <field name="subject_key" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-success="state == 'approved'"
                       decoration-muted="state in ('rejected', 'refused')"/>
                <field name="result_status" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_linda_approval_form" model="ir.ui.view">
        <field name="name">plasticos.linda.approval.form</field>
        <field name="model">plasticos.linda.approval</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"
                            invisible="state != 'pending'"/>
                    <button name="action_view_affected_load" string="Open Load" type="object"
                            invisible="not affected_load_id"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="can_decide" invisible="1"/>
                    <div class="alert alert-info" role="status" invisible="state != 'pending'">
                        <field name="next_action" readonly="1"/>
                    </div>
                    <group string="Case">
                        <group>
                            <field name="affected_load_id"/>
                            <field name="original_reply_id" invisible="not original_reply_id"/>
                            <field name="conflict_fact_ref_id" invisible="not conflict_fact_ref_id"/>
                        </group>
                        <group>
                            <field name="routed_role"/>
                            <field name="edge_reason"/>
                        </group>
                    </group>
                    <group>
                        <group string="Held Command">
                            <field name="command"/>
                            <field name="edge_case"/>
                            <field name="edge_reason"/>
                            <field name="operation_key"/>
                            <field name="subject_key"/>
                            <field name="subject_model"/>
                            <field name="subject_id"/>
                            <field name="conflict_fact_id" invisible="not conflict_fact_id"/>
                            <field name="routed_role"/>
                        </group>
                        <group string="Request">
                            <field name="requested_by"/>
                            <field name="requested_at"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Re-routed" invisible="not rerouted_at">
                        <field name="rerouted_by"/>
                        <field name="rerouted_at"/>
                        <field name="result_status"/>
                        <field name="result_reason"/>
                    </group>
                    <group string="Arguments">
                        <field name="arguments" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Decision" invisible="state in ('pending', 'refused')">
                        <field name="decided_by"/>
                        <field name="decided_at"/>
                        <field name="decision_note"/>
                        <field name="result_status"/>
                        <field name="result_record_id"/>
                        <field name="result_reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_linda_approval" model="ir.actions.act_window">
        <field name="name">Linda Approvals</field>
        <field name="res_model">plasticos.linda.approval</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_linda_approval_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting for approval</p>
            <p>Linda's edge cases (fact corrections, unverified replies, acceptances, conflicts, out-of-sequence events, unit mismatches, unverified evidence, retries) wait here. Logistics Operations decides the routine operational classes; an Operations Manager decides every case, and a Logistics approval whose replay still meets a guard is re-routed to the Operations Manager.</p>
        </field>
    </record>

    <!-- Readable only by Logistics, Operations Manager and System (grants in plasticos_security_base). -->
    <menuitem id="menu_linda_approval" name="Linda Approvals"
              parent="menu_plasticos_logistics_root" action="action_linda_approval" sequence="45"/>
</odoo>
