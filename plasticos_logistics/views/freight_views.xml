<odoo>
    <record id="view_freight_quote_request_list" model="ir.ui.view">
        <field name="name">plasticos.freight.quote.request.list</field>
        <field name="model">plasticos.freight.quote.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="load_id"/>
                <field name="origin_partner_id"/>
                <field name="destination_partner_id"/>
                <field name="sal_decision"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_freight_quote_request_form" model="ir.ui.view">
        <field name="name">plasticos.freight.quote.request.form</field>
        <field name="model">plasticos.freight.quote.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_select_quote" string="Confirm Selected Quote" type="object" class="btn-primary" invisible="state in ('resolved', 'cancelled', 'failed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,collecting,resolved,cancelled,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="load_id" readonly="1"/>
                            <field name="transaction_id" readonly="1"/>
                            <field name="sal_decision" readonly="1"/>
                            <field name="sal_miss_reason" readonly="1"/>
                        </group>
                        <group>
                            <field name="origin_partner_id" readonly="1"/>
                            <field name="destination_partner_id" readonly="1"/>
                            <field name="response_deadline"/>
                            <field name="failure_code" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Recipients">
                            <field name="recipient_ids">
                                <list editable="bottom">
                                    <field name="carrier_id"/>
                                    <field name="channel"/>
                                    <field name="destination_snapshot"/>
                                    <field name="state" readonly="1"/>
                                    <field name="attempt_count" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Carrier Responses">
                            <field name="quote_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="carrier_id"/>
                                    <field name="response_kind"/>
                                    <field name="quoted_amount"/>
                                    <field name="currency_id"/>
                                    <field name="timeliness"/>
                                    <field name="selected"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_freight_quote_list" model="ir.ui.view">
        <field name="name">plasticos.freight.quote.list</field>
        <field name="model">plasticos.freight.quote</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="request_id"/>
                <field name="carrier_id"/>
                <field name="response_kind"/>
                <field name="quoted_amount"/>
                <field name="currency_id"/>
                <field name="selected"/>
            </list>
        </field>
    </record>
    <record id="view_freight_quote_form" model="ir.ui.view">
        <field name="name">plasticos.freight.quote.form</field>
        <field name="model">plasticos.freight.quote</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_select" string="Select Quote" type="object" class="btn-primary" invisible="selected or response_kind != 'quote' or lifecycle_state != 'active'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="request_id"/>
                            <field name="recipient_id"/>
                            <field name="carrier_id" readonly="1"/>
                            <field name="response_kind"/>
                            <field name="responded_at"/>
                            <field name="source_channel"/>
                            <field name="source_message_id"/>
                        </group>
                        <group>
                            <field name="quoted_amount"/>
                            <field name="currency_id"/>
                            <field name="valid_until"/>
                            <field name="timeliness"/>
                            <field name="lifecycle_state"/>
                            <field name="selected" readonly="1"/>
                        </group>
                    </group>
                    <group string="Conditions">
                        <field name="conditions" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_freight_estimate_list" model="ir.ui.view">
        <field name="name">plasticos.freight.estimate.list</field>
        <field name="model">plasticos.freight.estimate</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="source_model"/>
                <field name="source_record_id"/>
                <field name="haversine_miles"/>
                <field name="estimate_target"/>
                <field name="status"/>
                <field name="generated_at"/>
            </list>
        </field>
    </record>
    <record id="view_freight_estimate_form" model="ir.ui.view">
        <field name="name">plasticos.freight.estimate.form</field>
        <field name="model">plasticos.freight.estimate</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="status" readonly="1"/>
                            <field name="failure_code" readonly="1"/>
                            <field name="origin_partner_id" readonly="1"/>
                            <field name="destination_partner_id" readonly="1"/>
                            <field name="haversine_miles" readonly="1"/>
                        </group>
                        <group>
                            <field name="estimate_floor" readonly="1"/>
                            <field name="estimate_target" readonly="1"/>
                            <field name="estimate_ceiling" readonly="1"/>
                            <field name="pricing_assumption" readonly="1"/>
                            <field name="confidence" readonly="1"/>
                            <field name="model_version" readonly="1"/>
                        </group>
                    </group>
                    <group string="Evidence Summary">
                        <field name="evidence_summary" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_freight_quote_request" model="ir.actions.act_window">
        <field name="name">Freight Quote Requests</field>
        <field name="res_model">plasticos.freight.quote.request</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_freight_estimate" model="ir.actions.act_window">
        <field name="name">Freight Estimates</field>
        <field name="res_model">plasticos.freight.estimate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
