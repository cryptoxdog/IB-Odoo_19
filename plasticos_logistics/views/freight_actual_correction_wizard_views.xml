<odoo>
    <record id="view_freight_actual_correction_wizard_form" model="ir.ui.view">
        <field name="name">plasticos.freight.actual.correction.wizard.form</field>
        <field name="model">plasticos.freight.actual.correction.wizard</field>
        <field name="arch" type="xml">
            <form string="Correct Actual Freight">
                <group>
                    <field name="load_id"/>
                    <field name="actual_cost"/>
                    <field name="currency_id"/>
                    <field name="reason" placeholder="Explain why the immutable calibration evidence is being corrected."/>
                </group>
                <footer>
                    <button name="action_apply" string="Record Superseding Correction" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
