<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         SEARCH VIEW
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_load_search" model="ir.ui.view">
        <field name="name">plasticos.load.search</field>
        <field name="model">plasticos.load</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="carrier_id"/>
                <field name="pickup_partner_id"/>
                <field name="delivery_partner_id"/>
                <field name="sale_order_id"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_scheduled" string="Scheduled"
                        domain="[('state', 'in', ('rate_confirmed', 'scheduled'))]"/>
                <filter name="filter_in_transit" string="In Transit"
                        domain="[('state', 'in', ('dispatched', 'picked_up'))]"/>
                <filter name="filter_delivered" string="Delivered"
                        domain="[('state', '=', 'delivered')]"/>
                <filter name="filter_closed" string="Closed"
                        domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="filter_sla_breached" string="SLA Breached"
                        domain="[('sla_breached', '=', True)]"/>
                <filter name="filter_today_pickup" string="Pickup Today"
                        domain="[('pickup_datetime', '&gt;=', context_today()),
                                 ('pickup_datetime', '&lt;', context_today() + relativedelta(days=1))]"/>
                <filter name="filter_today_delivery" string="Delivery Today"
                        domain="[('delivery_datetime', '&gt;=', context_today()),
                                 ('delivery_datetime', '&lt;', context_today() + relativedelta(days=1))]"/>
                <separator/>
                <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
                <filter name="group_carrier" string="Carrier"
                        context="{'group_by': 'carrier_id'}"/>
                <filter name="group_pickup" string="Pickup Location"
                        context="{'group_by': 'pickup_partner_id'}"/>
                <filter name="group_delivery" string="Delivery Location"
                        context="{'group_by': 'delivery_partner_id'}"/>
                <filter name="group_pickup_date" string="Pickup Date"
                        context="{'group_by': 'pickup_datetime:day'}"/>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         TREE VIEW
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_load_tree" model="ir.ui.view">
        <field name="name">plasticos.load.tree</field>
        <field name="model">plasticos.load</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'"
                  decoration-warning="state in ('dispatched', 'picked_up')"
                  decoration-success="state in ('delivered', 'closed')"
                  decoration-danger="sla_breached">
                <field name="name"/>
                <field name="carrier_id"/>
                <field name="pickup_partner_id"/>
                <field name="delivery_partner_id"/>
                <field name="pickup_datetime"/>
                <field name="delivery_datetime"/>
                <field name="rate_amount" sum="Total Rate"/>
                <field name="sla_breached" optional="show" widget="boolean"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-info="state in ('rate_confirmed', 'scheduled')"
                       decoration-warning="state in ('dispatched', 'picked_up')"
                       decoration-success="state in ('delivered', 'closed')"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         KANBAN VIEW
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_load_kanban" model="ir.ui.view">
        <field name="name">plasticos.load.kanban</field>
        <field name="model">plasticos.load</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="carrier_id"/>
                <field name="pickup_partner_id"/>
                <field name="delivery_partner_id"/>
                <field name="pickup_datetime"/>
                <field name="delivery_datetime"/>
                <field name="rate_amount"/>
                <field name="state"/>
                <field name="sla_breached"/>
                <progressbar field="state"
                             colors='{"draft": "secondary", "rate_confirmed": "info", "scheduled": "info", "dispatched": "warning", "picked_up": "warning", "delivered": "success", "closed": "muted"}'/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="#{record.sla_breached.raw_value ? 'border-danger border-2' : ''}">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <span t-if="record.sla_breached.raw_value" class="badge bg-danger">SLA!</span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-truck" title="Carrier"/> <field name="carrier_id"/></div>
                                <div class="mt-1">
                                    <div><i class="fa fa-arrow-up text-success" title="Pickup"/> <field name="pickup_partner_id"/></div>
                                    <div><i class="fa fa-arrow-down text-primary" title="Delivery"/> <field name="delivery_partner_id"/></div>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span t-if="record.pickup_datetime.raw_value" class="text-muted">
                                        <i class="fa fa-calendar" title="Pickup date"/> <field name="pickup_datetime"/>
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span class="badge bg-success" t-if="record.rate_amount.raw_value">
                                        $<field name="rate_amount"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         CALENDAR VIEW
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_load_calendar" model="ir.ui.view">
        <field name="name">plasticos.load.calendar</field>
        <field name="model">plasticos.load</field>
        <field name="arch" type="xml">
            <calendar string="Load Schedule"
                      date_start="pickup_datetime"
                      date_stop="delivery_datetime"
                      color="state"
                      mode="week"
                      quick_create="0">
                <field name="name"/>
                <field name="carrier_id"/>
                <field name="pickup_partner_id"/>
                <field name="delivery_partner_id"/>
            </calendar>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         FORM VIEW
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_load_form" model="ir.ui.view">
        <field name="name">plasticos.load.form</field>
        <field name="model">plasticos.load</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_dispatch" string="Dispatch" type="object" class="btn-primary" invisible="state not in ('scheduled', 'rate_confirmed')"/>
                    <button name="action_close" string="Close Load" type="object" class="btn-success" invisible="state != 'delivered'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,rate_confirmed,scheduled,dispatched,picked_up,delivered,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_send_dispatch_packet" type="object" class="oe_stat_button" icon="fa-paper-plane"
                                invisible="state in ('draft', 'awaiting_ready', 'ready_confirmed')">
                            <span>Send Dispatch Packet</span>
                        </button>
                        <button name="action_send_delivery_order" type="object" class="oe_stat_button" icon="fa-envelope-o"
                                invisible="state in ('draft', 'awaiting_ready', 'ready_confirmed')">
                            <span>Send Delivery Order</span>
                        </button>
                        <button name="action_send_bol_pickup" type="object" class="oe_stat_button" icon="fa-envelope-o"
                                invisible="state in ('draft', 'awaiting_ready', 'ready_confirmed')">
                            <span>Send BOL Pickup</span>
                        </button>
                        <button name="action_send_bol_delivery" type="object" class="oe_stat_button" icon="fa-envelope-o"
                                invisible="state in ('draft', 'awaiting_ready', 'ready_confirmed')">
                            <span>Send BOL Delivery</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Load Number"/>
                        </h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="sale_order_id"/>
                            <field name="carrier_id"/>
                            <field name="rate_amount"/>
                            <field name="rate_confirmed_at" readonly="1"/>
                            <field name="rate_auto_reused" readonly="1"/>
                        </group>
                        <group string="Carrier Details">
                            <field name="carrier_contact_name"/>
                            <field name="carrier_contact_phone"/>
                            <field name="trailer_number"/>
                            <field name="seal_number"/>
                        </group>
                    </group>

                    <group>
                        <group string="Delivery Terms">
                            <field name="delivery_term"/>
                            <field name="delivery_term_overridden" invisible="1"/>
                            <field name="delivery_term_override_reason"
                                   invisible="not delivery_term_overridden"
                                   required="delivery_term_overridden"/>
                        </group>
                        <group string="Dispatch Tracking">
                            <field name="dispatch_method"/>
                            <field name="dispatch_sent"/>
                            <field name="dispatch_acknowledged"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Pickup" name="pickup">
                            <group>
                                <group string="Location">
                                    <field name="pickup_partner_id"/>
                                    <field name="pickup_datetime"/>
                                    <field name="pickup_reference"/>
                                    <field name="pickup_hours"/>
                                </group>
                                <group string="Contact">
                                    <field name="pickup_contact_name"/>
                                    <field name="pickup_contact_phone"/>
                                    <field name="pickup_contact_mobile"/>
                                </group>
                            </group>
                            <group string="Special Instructions">
                                <field name="pickup_instructions" nolabel="1" placeholder="Enter pickup instructions..."/>
                            </group>
                        </page>

                        <page string="Delivery" name="delivery">
                            <group>
                                <group string="Location">
                                    <field name="delivery_partner_id"/>
                                    <field name="delivery_datetime"/>
                                    <field name="delivery_reference"/>
                                    <field name="delivery_hours"/>
                                </group>
                                <group string="Contact">
                                    <field name="delivery_contact_name"/>
                                    <field name="delivery_contact_phone"/>
                                    <field name="delivery_contact_mobile"/>
                                </group>
                            </group>
                            <group string="Special Instructions">
                                <field name="delivery_instructions" nolabel="1" placeholder="Enter delivery instructions..."/>
                            </group>
                        </page>

                        <page string="Cargo" name="cargo">
                            <group>
                                <group>
                                    <field name="product_description"/>
                                    <field name="quantity"/>
                                    <field name="quantity_uom"/>
                                    <field name="reference_weight"/>
                                </group>
                                <group>
                                    <field name="double_blind"/>
                                    <field name="straps_bars_needed"/>
                                </group>
                            </group>
                            <group string="Notes">
                                <field name="notes" nolabel="1" placeholder="Additional notes..."/>
                            </group>
                        </page>

                        <page string="Status" name="status">
                            <group>
                                <group string="Ready Confirmation">
                                    <field name="ready_confirmed_by" readonly="1"/>
                                    <field name="ready_confirmed_at" readonly="1"/>
                                </group>
                                <group string="Timing">
                                    <field name="entered_state_at" readonly="1"/>
                                    <field name="dispatched_at" readonly="1"/>
                                    <field name="delivered_at" readonly="1"/>
                                    <field name="cycle_time_hours" readonly="1"/>
                                </group>
                            </group>
                            <group>
                                <group string="Documents" name="documents">
                                    <field name="bol_pickup_attached"/>
                                    <field name="bol_delivery_attached"/>
                                </group>
                                <group string="SLA">
                                    <field name="sla_breached" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         ACTION
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="action_plasticos_load" model="ir.actions.act_window">
        <field name="name">Loads</field>
        <field name="res_model">plasticos.load</field>
        <field name="view_mode">kanban,list,calendar,form</field>
        <field name="search_view_id" ref="view_load_search"/>
        <field name="context">{'search_default_filter_draft': 1, 'search_default_filter_scheduled': 1, 'search_default_filter_in_transit': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No loads scheduled yet
            </p>
            <p>
                Create loads to schedule pickups and deliveries with carriers.
            </p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         MENU
         ═══════════════════════════════════════════════════════════════════ -->
    <menuitem id="menu_plasticos_logistics_root" name="Logistics" sequence="50"/>
    <menuitem id="menu_plasticos_loads" name="Loads" parent="menu_plasticos_logistics_root" action="action_plasticos_load" sequence="10"/>

</odoo>
