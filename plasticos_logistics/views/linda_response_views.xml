<?xml version="1.0" encoding="utf-8"?>
<!-- Read-only visibility of Linda reply evidence (WP02); no inbox or workflow. -->
<odoo>
    <record id="view_linda_response_list" model="ir.ui.view">
        <field name="name">plasticos.logistics.response.list</field>
        <field name="model">plasticos.logistics.response</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date" string="Received"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="purchase_order_id" optional="show"/>
                <field name="sale_order_id" optional="show"/>
                <field name="request_id"/>
                <field name="email_from"/>
                <field name="binding"/>
                <field name="candidate_kind"/>
                <field name="disposition" decoration-warning="disposition != 'identity_unverified'"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <record id="view_linda_response_form" model="ir.ui.view">
        <field name="name">plasticos.logistics.response.form</field>
        <field name="model">plasticos.logistics.response</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="mail_message_id"/>
                            <field name="email_from"/>
                            <field name="purchase_order_id" invisible="not purchase_order_id"/>
                            <field name="sale_order_id" invisible="not sale_order_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="request_id"/>
                            <field name="request_revision"/>
                            <field name="binding"/>
                            <field name="interpretation"/>
                            <field name="candidate_kind"/>
                            <field name="disposition"/>
                            <field name="reason"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_linda_response_search" model="ir.ui.view">
        <field name="name">plasticos.logistics.response.search</field>
        <field name="model">plasticos.logistics.response</field>
        <field name="arch" type="xml">
            <search>
                <field name="purchase_order_id"/>
                <field name="sale_order_id"/>
                <field name="email_from"/>
                <filter name="needs_attention" string="Needs Attention" domain="[('disposition', '!=', 'identity_unverified')]"/>
                <filter name="group_disposition" string="Disposition" context="{'group_by': 'disposition'}"/>
            </search>
        </field>
    </record>

    <record id="action_linda_response" model="ir.actions.act_window">
        <field name="name">Linda Replies</field>
        <field name="res_model">plasticos.logistics.response</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_needs_attention': 1}</field>
    </record>

    <menuitem id="menu_linda_response"
              name="Linda Replies"
              parent="menu_plasticos_logistics_root"
              action="action_linda_response"
              sequence="90"/>
</odoo>
