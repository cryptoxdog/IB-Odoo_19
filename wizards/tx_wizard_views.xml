<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Transaction Bulk Update Wizard -->
    <record id="view_tx_bulk_update_wizard_form" model="ir.ui.view">
        <field name="name">sm.tx.bulk.update.wizard.form</field>
        <field name="model">sm.tx.bulk.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Update Transaction Status">
                <group>
                    <field name="new_state" required="1"/>
                    <field name="reason" required="1" placeholder="Reason for status change..."/>
                </group>
                <group string="Selected Transactions">
                    <field name="tx_ids" nolabel="1" readonly="1">
                        <tree>
                            <field name="name"/>
                            <field name="supplier_id"/>
                            <field name="buyer_id"/>
                            <field name="state"/>
                        </tree>
                    </field>
                </group>
                <footer>
                    <button name="action_update_status" string="Update Status" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Wizard Action -->
    <record id="action_tx_bulk_update_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Update Status</field>
        <field name="res_model">sm.tx.bulk.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_sm_tx"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
