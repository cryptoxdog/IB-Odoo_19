<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Private Contact toggle: visible to system_admin and operations_manager only -->
    <record id="view_partner_form_private" model="ir.ui.view">
        <field name="name">res.partner.form.private</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="before">
                <field name="is_private"
                       groups="plasticos_security_base.group_system_admin,plasticos_security_base.group_operations_manager"
                       widget="boolean_toggle"
                       help="When enabled, only you and System Administrators can see this contact."/>
            </xpath>
        </field>
    </record>

    <!-- Hide unused fields from partner form: Tax ID, Website -->
    <record id="view_partner_form_hide_fields" model="ir.ui.view">
        <field name="name">res.partner.form.hide.fields</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <!-- Tax ID (vat) -->
            <xpath expr="//field[@name='vat']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Website -->
            <xpath expr="//field[@name='website']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Make Account Receivable/Payable non-required for easier contact creation.
         Sales can create contacts without accounting setup; backfill later. -->
    <record id="view_partner_form_optional_accounts" model="ir.ui.view">
        <field name="name">res.partner.form.optional.accounts</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <!-- Account Receivable - make optional -->
            <xpath expr="//field[@name='property_account_receivable_id']" position="attributes">
                <attribute name="required">0</attribute>
            </xpath>
            <!-- Account Payable - make optional -->
            <xpath expr="//field[@name='property_account_payable_id']" position="attributes">
                <attribute name="required">0</attribute>
            </xpath>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         PARTNER FORM UX OVERHAUL
         - Promote key fields (Salesperson, Payment Terms, Notes) to main area
         - Reorder tabs: Material Profile → Facility → Sales → Invoicing → Geolocation
         - Hide empty Contacts tab and Notes tab (content moved to main area)
         ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_partner_form_plasticos_layout" model="ir.ui.view">
        <field name="name">res.partner.form.plasticos.layout</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">

            <!-- ═══ PROMOTED FIELDS: Add key fields above notebook ═══ -->
            <!-- Salesperson and Payment Terms moved to upper right (plasticos_facility_profile) -->
            <xpath expr="//sheet/notebook" position="before">

                <!-- Internal Notes - prominent, always visible for companies -->
                <group string="Notes" invisible="not is_company" class="mt-3">
                    <field name="comment"
                           placeholder="Add notes about this contact..."
                           nolabel="1" colspan="2"
                           widget="html"/>
                </group>

            </xpath>

            <!-- ═══ HIDE TABS ═══ -->

            <!-- Hide Contacts tab (empty, not used in PlasticOS workflow) -->
            <xpath expr="//page[@name='contact_addresses']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide Notes tab (content moved to main area above) -->
            <xpath expr="//page[@name='internal_notes']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- ═══ HIDE REDUNDANT FIELDS IN TABS ═══ -->

            <!-- Hide Salesperson in Sales &amp; Purchase tab (already in upper section) -->
            <xpath expr="//page[@name='sales_purchases']//field[@name='user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- ═══ TAB SEQUENCING ═══ -->
            <!-- Order: Material Profile (1) → Facility Profile (2) → Sales &amp; Purchase (50) → Invoicing (60) -->

            <!-- Sales &amp; Purchase = 50 -->
            <xpath expr="//page[@name='sales_purchases']" position="attributes">
                <attribute name="sequence">50</attribute>
            </xpath>

            <!-- Invoicing = 60 -->
            <xpath expr="//page[@name='accounting']" position="attributes">
                <attribute name="sequence">60</attribute>
                <attribute name="string">Invoicing</attribute>
            </xpath>

        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         HIDE PURCHASE MODULE FIELDS (Group RFQ, Buyer)
         These come from Odoo's purchase module and are not used in PlasticOS workflow.
         ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_partner_form_hide_purchase_fields" model="ir.ui.view">
        <field name="name">res.partner.form.hide.purchase.fields</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="purchase.view_partner_property_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='buyer_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='purchase_group_method']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         GEOLOCATION TAB - HIDDEN
         Hide geolocation tab from base_geolocalize module
         ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_partner_form_hide_geolocation" model="ir.ui.view">
        <field name="name">res.partner.form.hide.geolocation</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_geolocalize.view_crm_partner_geo_form"/>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='geo_location']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
