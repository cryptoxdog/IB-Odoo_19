<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Private Contact toggle: visible to system_admin and operations_manager only -->
    <record id="view_partner_form_private" model="ir.ui.view">
        <field name="name">res.partner.form.private</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="before">
                <field name="is_private"
                       groups="plasticos_security_base.group_system_admin,plasticos_security_base.group_operations_manager"
                       widget="boolean_toggle"
                       help="When enabled, only you and System Administrators can see this contact."/>
            </xpath>
        </field>
    </record>

    <!-- Hide unused fields from partner form: Tax ID, Website, Partner Level -->
    <record id="view_partner_form_hide_fields" model="ir.ui.view">
        <field name="name">res.partner.form.hide.fields</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <!-- Tax ID (vat) -->
            <xpath expr="//field[@name='vat']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Website -->
            <xpath expr="//field[@name='website']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Partner Level (grade_id) - hide if present -->
            <xpath expr="//field[@name='grade_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Partner form tab ordering and visibility -->
    <record id="view_partner_form_tab_order" model="ir.ui.view">
        <field name="name">res.partner.form.tab.order</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">

            <!-- Hide child_ids field (Contacts tab content) -->
            <xpath expr="//field[@name='child_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Tab order: Material Profiles, Facility Profile, Notes, Sales, Partner Assignment, Accounting -->
            <xpath expr="//page[@name='material_profiles_tab']" position="attributes">
                <attribute name="sequence">10</attribute>
            </xpath>
            <xpath expr="//page[@name='facility_profile']" position="attributes">
                <attribute name="sequence">20</attribute>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="attributes">
                <attribute name="sequence">30</attribute>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="attributes">
                <attribute name="sequence">40</attribute>
            </xpath>
            <xpath expr="//page[@name='partner_assign']" position="attributes">
                <attribute name="sequence">50</attribute>
            </xpath>
            <xpath expr="//page[@name='accounting']" position="attributes">
                <attribute name="sequence">60</attribute>
            </xpath>

        </field>
    </record>

</odoo>
