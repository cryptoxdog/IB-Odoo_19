<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!-- 1. Private Partner Rule
         If is_private is True, only the creator and Admins can see it.
         Non-private partners remain visible to everyone. -->
    <record id="rule_partner_private" model="ir.rule">
        <field name="name">Plasticos: Private Partner - Owner Only</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[
            '|',
            ('is_private', '=', False),
            ('create_uid', '=', user.id)
        ]</field>
        <field name="groups" eval="[
            (4, ref('plasticos_security_base.group_sales_rep')),
            (4, ref('plasticos_security_base.group_logistics')),
            (4, ref('plasticos_security_base.group_accounting')),
        ]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- 2. Transaction: Sales Rep sees own only
         user_id = user OR create_uid = user
         Logistics and Accounting are NOT in this rule's groups,
         so they fall through to the global ACL (which grants read). -->
    <record id="rule_transaction_sales_rep" model="ir.rule">
        <field name="name">Plasticos: Transaction - Sales Rep Own Records</field>
        <field name="model_id" ref="plasticos_transaction.model_plasticos_transaction"/>
        <field name="domain_force">[
            '|',
            ('user_id', '=', user.id),
            ('create_uid', '=', user.id)
        ]</field>
        <field name="groups" eval="[
            (4, ref('plasticos_security_base.group_sales_rep')),
        ]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- 3. Sale Order: Sales Rep sees own only -->
    <record id="rule_sale_order_sales_rep" model="ir.rule">
        <field name="name">Plasticos: Sale Order - Sales Rep Own Records</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[
            '|',
            ('user_id', '=', user.id),
            ('create_uid', '=', user.id)
        ]</field>
        <field name="groups" eval="[
            (4, ref('plasticos_security_base.group_sales_rep')),
        ]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- 4. Purchase Order: Sales Rep sees own only -->
    <record id="rule_purchase_order_sales_rep" model="ir.rule">
        <field name="name">Plasticos: Purchase Order - Sales Rep Own Records</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[
            '|',
            ('user_id', '=', user.id),
            ('create_uid', '=', user.id)
        ]</field>
        <field name="groups" eval="[
            (4, ref('plasticos_security_base.group_sales_rep')),
        ]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- 5. Account Move (Invoice/Bill): Sales Rep sees own only -->
    <record id="rule_account_move_sales_rep" model="ir.rule">
        <field name="name">Plasticos: Invoice - Sales Rep Own Records</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[
            '|',
            ('invoice_user_id', '=', user.id),
            ('create_uid', '=', user.id)
        ]</field>
        <field name="groups" eval="[
            (4, ref('plasticos_security_base.group_sales_rep')),
        ]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- 6. Load: Sales Rep sees loads linked to own sale orders
         Uses related field path: sale_order_id.user_id -->
    <record id="rule_load_sales_rep" model="ir.rule">
        <field name="name">Plasticos: Load - Sales Rep Own Orders</field>
        <field name="model_id" ref="plasticos_logistics.model_plasticos_load"/>
        <field name="domain_force">[
            '|',
            ('sale_order_id.user_id', '=', user.id),
            ('create_uid', '=', user.id)
        ]</field>
        <field name="groups" eval="[
            (4, ref('plasticos_security_base.group_sales_rep')),
        ]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>


  <!-- ══════════════════════════════════════════════════════════════════════
       Sales Dashboard Record Rules
       Sales reps see ONLY their own deals. Managers/accounting see all.
  ══════════════════════════════════════════════════════════════════════ -->

  <!-- Rep: filter to own user_id -->
  <record id="rule_sales_dashboard_rep_own" model="ir.rule">
    <field name="name">Sales Dashboard: Sales Reps see own deals only</field>
    <field name="model_id" ref="plasticos_commission.model_plasticos_sales_dashboard"/>
    <field name="domain_force">[("user_id", "=", user.id)]</field>
    <field name="groups" eval="[(4, ref('plasticos_security_base.group_sales_rep'))]"/>
    <field name="perm_read"   eval="True"/>
    <field name="perm_write"  eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <!-- Manager: global read — no domain restriction -->
  <record id="rule_sales_dashboard_manager_all" model="ir.rule">
    <field name="name">Sales Dashboard: Managers see all deals</field>
    <field name="model_id" ref="plasticos_commission.model_plasticos_sales_dashboard"/>
    <field name="domain_force">[(1, "=", 1)]</field>
    <field name="groups" eval="[(4, ref('plasticos_security_base.group_operations_manager'))]"/>
    <field name="perm_read"   eval="True"/>
    <field name="perm_write"  eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <!-- Accounting: global read — no domain restriction -->
  <record id="rule_sales_dashboard_accounting_all" model="ir.rule">
    <field name="name">Sales Dashboard: Accounting sees all deals</field>
    <field name="model_id" ref="plasticos_commission.model_plasticos_sales_dashboard"/>
    <field name="domain_force">[(1, "=", 1)]</field>
    <field name="groups" eval="[(4, ref('plasticos_security_base.group_accounting_ops'))]"/>
    <field name="perm_read"   eval="True"/>
    <field name="perm_write"  eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <!-- Commission Payout: rep can read their own payouts only -->
  <record id="rule_commission_payout_rep_own" model="ir.rule">
    <field name="name">Commission Payout: Sales Reps see own payouts only</field>
    <field name="model_id" ref="plasticos_commission.model_plasticos_commission_payout"/>
    <field name="domain_force">[("sales_rep_id", "=", user.id)]</field>
    <field name="groups" eval="[(4, ref('plasticos_security_base.group_sales_rep'))]"/>
    <field name="perm_read"   eval="True"/>
    <field name="perm_write"  eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

</odoo>
