<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!-- Application Category -->
    <record id="module_category_plasticos" model="ir.module.category">
        <field name="name">Plasticos</field>
        <field name="description">Plasticos platform roles and permissions.</field>
        <field name="sequence">200</field>
    </record>

    <!-- ============================================
         SECURITY GROUPS (Odoo 19 format)
         Note: category_id removed in Odoo 19
         ============================================ -->

    <!-- Sales Rep -->
    <record id="group_sales_rep" model="res.groups">
        <field name="name">Sales Rep</field>
        <field name="comment">
            Owns relationships and deals.  Row-level isolation ensures
            Sales Reps only see their own partners, transactions, orders,
            invoices, loads, documents, and offers.
        </field>
    </record>

    <!-- Logistics -->
    <record id="group_logistics" model="res.groups">
        <field name="name">Logistics</field>
        <field name="comment">
            Manages freight, loads, dispatching, and rate memory.
            Broad read access on operational data.  Read-only on
            pipeline models (intake, matching, offers).
        </field>
    </record>

    <!-- Accounting -->
    <record id="group_accounting" model="res.groups">
        <field name="name">Accounting</field>
        <field name="comment">
            Owns commission rules and financial documents.
            Read-only on most operational data.
        </field>
    </record>

    <!-- Logistics Operations (extends base Logistics) -->
    <record id="group_logistics_ops" model="res.groups">
        <field name="name">Logistics Operations</field>
        <field name="implied_ids" eval="[(4, ref('group_logistics'))]"/>
        <field name="comment">Full access to logistics automation features including freight rate requests, supplier confirmations, and trucker communications</field>
    </record>

    <!-- Quality Control Manager -->
    <record id="group_qc_manager" model="res.groups">
        <field name="name">QC Manager</field>
        <field name="comment">Quality control claim management and resolution authority</field>
    </record>

    <!-- Accounting Operations (extends base Accounting) -->
    <record id="group_accounting_ops" model="res.groups">
        <field name="name">Accounting Operations</field>
        <field name="implied_ids" eval="[(4, ref('group_accounting'))]"/>
        <field name="comment">Invoice processing, penalty calculations, and financial reconciliation</field>
    </record>

    <!-- Operations Manager (inherits all operational groups) -->
    <record id="group_operations_manager" model="res.groups">
        <field name="name">Operations Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_logistics_ops')), (4, ref('group_qc_manager')), (4, ref('group_accounting_ops'))]"/>
        <field name="comment">Full operational oversight with escalation authority</field>
    </record>

    <!-- System Administrator -->
    <record id="group_system_admin" model="res.groups">
        <field name="name">PlasticOS System Admin</field>
        <field name="implied_ids" eval="[(4, ref('group_operations_manager'))]"/>
        <field name="comment">Complete system administration including configuration and advanced settings</field>
    </record>

</odoo>
