<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_crm_sync" model="ir.ui.view">
        <field name="name">res.partner.form.plasticos.crm.sync</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook[page[@name='internal_notes']]" position="inside">
                <page string="CRM Sync" name="plasticos_crm_sync" invisible="not crm_call_event_ids and not crm_external_table_row_ids">
                    <separator string="Call History"/>
                    <field name="crm_call_event_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="call_datetime_utc"/>
                            <field name="user_name"/>
                            <field name="result_code"/>
                            <field name="duration_seconds"/>
                            <field name="comment"/>
                        </list>
                    </field>
                    <separator string="Custom Tables"/>
                    <field name="crm_external_table_row_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="table_name"/>
                            <field name="table_id"/>
                            <field name="external_row_id"/>
                            <field name="fields_json"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
