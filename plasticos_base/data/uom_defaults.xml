<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Default weight unit: Pounds (lb) instead of Kilograms -->
    <record id="config_weight_in_lbs" model="ir.config_parameter">
        <field name="key">product.weight_in_lbs</field>
        <field name="value">1</field>
    </record>

    <!-- Default volume unit: Cubic Feet (ft³) instead of Cubic Meters -->
    <record id="config_volume_in_cubic_feet" model="ir.config_parameter">
        <field name="key">product.volume_in_cubic_feet</field>
        <field name="value">1</field>
    </record>

</odoo>
