<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_claim_created" model="mail.template">
        <field name="name">Claim: New Claim Notification</field>
        <field name="model_id" ref="model_plasticos_claim"/>
        <field name="subject">New Claim Created: {{ object.name }}</field>
        <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
        <field name="email_to">{{ object.transaction_id.user_id.email or '' }}</field>
        <field name="body_html"><![CDATA[
<div style="margin: 0px; padding: 0px;">
    <p>Hello,</p>
    <p>A new claim has been created and requires attention:</p>
    <table style="border-collapse: collapse; width: 100%;">
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Reference</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.name }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Transaction</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.transaction_id.name }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Type</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.case_type }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Severity</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.severity }}</td>
        </tr>
    </table>
    <p style="margin-top: 16px;">
        <strong>Note:</strong> The Quality Manager will handle all buyer communication.
        Please review the claim in Odoo for updates.
    </p>
    <p>Best regards,<br/>PlasticOS</p>
</div>
]]></field>
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="mail_template_claim_escalated" model="mail.template">
        <field name="name">Claim: Escalation Notification</field>
        <field name="model_id" ref="model_plasticos_claim"/>
        <field name="subject">ESCALATED: Claim {{ object.name }} - SLA Breach</field>
        <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
        <field name="body_html"><![CDATA[
<div style="margin: 0px; padding: 0px;">
    <p><strong style="color: #e74c3c;">⚠️ SLA BREACH</strong></p>
    <p>The following claim has been automatically escalated due to exceeding the {{ object.sla_hours }}-hour SLA:</p>
    <table style="border-collapse: collapse; width: 100%;">
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Reference</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.name }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Transaction</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.transaction_id.name }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Opened At</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.opened_at }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Escalated At</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.escalated_at }}</td>
        </tr>
    </table>
    <p style="margin-top: 16px;">Please review and take immediate action.</p>
</div>
]]></field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
