<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_claim_list" model="ir.ui.view">
        <field name="name">plasticos.claim.list</field>
        <field name="model">plasticos.claim</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'escalated'" decoration-muted="state == 'archived'">
                <field name="name"/>
                <field name="transaction_id"/>
                <field name="load_id" optional="show"/>
                <field name="case_type"/>
                <field name="severity"/>
                <field name="assignee_id" optional="show" widget="many2one_avatar_user"/>
                <field name="claimed_amount" optional="hide" sum="Total Claimed"/>
                <field name="recovery_amount" optional="hide" sum="Total Recovered"/>
                <field name="opened_at" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-warning="state == 'in_progress'"
                       decoration-danger="state == 'escalated'"
                       decoration-success="state == 'resolved'"
                       decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_claim_form" model="ir.ui.view">
        <field name="name">plasticos.claim.form</field>
        <field name="model">plasticos.claim</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start"
                            invisible="state != 'pending'" class="btn-primary"/>
                    <button name="action_escalate" type="object" string="Escalate"
                            invisible="state not in ('pending', 'in_progress')" class="btn-warning"/>
                    <button name="action_resolve" type="object" string="Resolve"
                            invisible="state not in ('pending', 'in_progress', 'escalated')" class="btn-success"/>
                    <button name="action_archive" type="object" string="Archive"
                            invisible="state != 'resolved'"/>
                    <button name="action_reopen" type="object" string="Re-open"
                            invisible="state not in ('resolved', 'archived')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,in_progress,escalated,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Classification">
                            <field name="case_type"/>
                            <field name="severity"/>
                            <field name="assignee_id"/>
                        </group>
                        <group string="Links">
                            <field name="transaction_id"/>
                            <field name="load_id"/>
                            <field name="source_document_id"/>
                        </group>
                    </group>

                    <group>
                        <group string="Financial">
                            <field name="claimed_amount"/>
                            <field name="recovery_amount"/>
                        </group>
                        <group string="SLA Tracking">
                            <field name="sla_hours"/>
                            <field name="opened_at"/>
                            <field name="escalated_at" invisible="not escalated_at"/>
                            <field name="resolved_at" invisible="not resolved_at"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Internal notes and discussion..."/>
                        </page>
                        <page string="Resolution" invisible="state not in ('resolved', 'archived')">
                            <field name="resolution_note" placeholder="Required: Explain how this claim was resolved..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_claim_kanban" model="ir.ui.view">
        <field name="name">plasticos.claim.kanban</field>
        <field name="model">plasticos.claim</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="transaction_id"/>
                <field name="case_type"/>
                <field name="severity"/>
                <field name="assignee_id"/>
                <field name="state"/>
                <field name="recovery_amount"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="#{record.severity.raw_value == 'high' ? 'border-danger' : record.severity.raw_value == 'medium' ? 'border-warning' : ''}">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <span class="badge" t-att-class="{'bg-danger': record.severity.raw_value == 'high', 'bg-warning': record.severity.raw_value == 'medium', 'bg-secondary': record.severity.raw_value == 'low'}">
                                    <field name="severity"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="transaction_id"/>
                                <br/>
                                <field name="case_type"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="recovery_amount" widget="monetary" invisible="not recovery_amount"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="assignee_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_claim_search" model="ir.ui.view">
        <field name="name">plasticos.claim.search</field>
        <field name="model">plasticos.claim</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="transaction_id"/>
                <field name="load_id"/>
                <field name="assignee_id"/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Escalated" name="escalated" domain="[('state', '=', 'escalated')]"/>
                <filter string="Resolved" name="resolved" domain="[('state', '=', 'resolved')]"/>
                <separator/>
                <filter string="High Severity" name="high" domain="[('severity', '=', 'high')]"/>
                <filter string="Buyer Claims" name="buyer_claims" domain="[('case_type', '=', 'buyer_claim')]"/>
                <filter string="Chargebacks" name="chargebacks" domain="[('case_type', '=', 'freight_chargeback')]"/>
                <filter string="Penalties" name="penalties" domain="[('case_type', '=', 'lightweight_penalty')]"/>
                <separator/>
                <filter string="My Claims" name="my_claims" domain="[('assignee_id', '=', uid)]"/>
                <group name="group_by">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'case_type'}"/>
                    <filter string="Severity" name="group_severity" context="{'group_by': 'severity'}"/>
                    <filter string="Assignee" name="group_assignee" context="{'group_by': 'assignee_id'}"/>
                    <filter string="Transaction" name="group_tx" context="{'group_by': 'transaction_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_claims" model="ir.actions.act_window">
        <field name="name">Claims</field>
        <field name="res_model">plasticos.claim</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_pending': 1, 'search_default_in_progress': 1, 'search_default_escalated': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No claims yet
            </p>
            <p>
                Claims are automatically created when Claim Pics documents are uploaded,
                or you can create them manually.
            </p>
        </field>
    </record>
</odoo>
