<?xml version="1.0" encoding="UTF-8"?>
<!--
    Cron: Refresh Admin KPI singleton every 15 minutes.
    Set interval_number to 30 or 60 in production if load is a concern.
-->
<odoo>
<data noupdate="1">

<record id="cron_refresh_admin_kpi" model="ir.cron">
    <field name="name">PlasticOS: Refresh Admin KPI Dashboard</field>
    <field name="model_id" ref="model_plasticos_admin_kpi"/>
    <field name="state">code</field>
    <field name="code">
env["plasticos.admin.kpi"]._get_or_create().action_refresh()
    </field>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">15</field>
    <field name="interval_type">minutes</field>
    <field name="numbercall">-1</field>
    <field name="doall">False</field>
    <field name="active">True</field>
</record>

</data>
</odoo>
