# direnv config — auto-activates the pinned project virtualenv on entry.
#
# One-time setup:
#   brew install direnv && eval "$(direnv hook zsh)"   # add hook to ~/.zshrc
#   make venv        # build the pinned .venv (ruff==0.15.5, semgrep, pytest...)
#   direnv allow     # trust this .envrc
#
# Why: pyproject pins ruff EXACTLY (==0.15.5). Activating .venv makes ruff,
# pytest, and semgrep resolve to the reproducible pinned set — no PATH surprises.
if [ -d .venv ]; then
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add "$PWD/.venv/bin"
else
  log_status "⚠️  .venv missing — run: make venv"
fi
