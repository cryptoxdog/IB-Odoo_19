<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="normalizer_config_default" model="plasticos.normalizer.config">
            <field name="name">Normalizer Configuration</field>
            <field name="require_polymer_in_canonical" eval="True"/>
