<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="view_crm_lead_import_wizard_form" model="ir.ui.view">
        <field name="name">plasticos.crm.lead.import.wizard.form</field>
        <field name="model">plasticos.crm.lead.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import CRM Leads">
                <group invisible="state != 'draft'">
                    <group string="Import Options">
                        <field name="use_default_file"/>
                        <field name="dry_run"/>
                        <field name="skip_duplicates"/>
                    </group>
                    <group string="Custom File" invisible="use_default_file">
                        <field name="crm_file" filename="crm_filename"/>
                        <field name="crm_filename" invisible="1"/>
                    </group>
                </group>
                <group invisible="state != 'draft'">
                    <div class="alert alert-info" role="alert">
                        <strong>Default File:</strong>
                        <code>3. VanillaSoft CRM - All Contacts (ALL).csv</code>
                        <br/><br/>
                        <strong>Expected Columns:</strong>
                        ContactID, Company, First Name, Last Name, Email, Direct, Mobile 1,
                        Address 1, City, State, Zip Code, Country, Lead Status, Lead Source,
                        Company Type, Buyer/Supplier, Notes
                    </div>
                </group>
                <group invisible="state != 'done'">
                    <group>
                        <field name="total_rows"/>
                        <field name="leads_created"/>
                        <field name="leads_skipped"/>
                        <field name="error_count"/>
                    </group>
                </group>
                <group invisible="state != 'done' and not result_message">
                    <field name="result_message" readonly="1" nolabel="1"
                           widget="text" style="font-family: monospace; white-space: pre-wrap;"/>
                </group>
                <field name="state" invisible="1"/>
                <footer>
                    <button name="action_preview" type="object" string="Preview"
                            class="btn-secondary" invisible="state != 'draft'"
                            title="Preview first 10 rows of the CSV"/>
                    <button name="action_import" type="object" string="Import"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_view_leads" type="object" string="View Leads"
                            class="btn-secondary" invisible="state != 'done'"/>
                    <button name="action_close" type="object" string="Close"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_crm_lead_import_wizard" model="ir.actions.act_window">
        <field name="name">Import CRM Leads</field>
        <field name="res_model">plasticos.crm.lead.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item under CRM -->
    <menuitem id="menu_crm_lead_import_wizard"
              name="Import CRM Leads (VanillaSoft)"
              parent="crm.crm_menu_root"
              action="action_crm_lead_import_wizard"
              sequence="100"/>

    <!-- Also add to PlasticOS menu -->
    <menuitem id="menu_crm_lead_import_wizard_plasticos"
              name="Import CRM Leads"
              parent="plasticos_intake.plasticos_root_menu"
              action="action_crm_lead_import_wizard"
              sequence="91"/>

</odoo>
