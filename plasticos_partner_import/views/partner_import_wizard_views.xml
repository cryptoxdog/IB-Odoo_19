<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="view_partner_import_wizard_form" model="ir.ui.view">
        <field name="name">plasticos.partner.import.wizard.form</field>
        <field name="model">plasticos.partner.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Partners">
                <group invisible="state != 'draft'">
                    <group string="Import Options">
                        <field name="import_mode"/>
                        <field name="use_default_files"/>
                        <field name="dry_run"/>
                    </group>
                    <group string="Custom Files" invisible="use_default_files">
                        <field name="corporate_file" filename="corporate_filename"
                               invisible="import_mode == 'facility_only'"/>
                        <field name="corporate_filename" invisible="1"/>
                        <field name="facility_file" filename="facility_filename"
                               invisible="import_mode == 'corporate_only'"/>
                        <field name="facility_filename" invisible="1"/>
                    </group>
                </group>
                <group invisible="state != 'draft'">
                    <div class="alert alert-info" role="alert">
                        <strong>Default Files:</strong>
                        <ul>
                            <li>Corporate: <code>1. Counterparties - Parent - CORPORATE-Ready To Import.csv</code></li>
                            <li>Facilities: <code>2. Counterparties - Child - FACILITY LOCATIONS.csv</code></li>
                        </ul>
                        These files are located in the <code>plasticos_partner_import</code> module directory.
                    </div>
                </group>
                <group invisible="state != 'done'">
                    <field name="result_message" readonly="1" nolabel="1"
                           widget="text" style="font-family: monospace; white-space: pre-wrap;"/>
                </group>
                <field name="state" invisible="1"/>
                <footer>
                    <button name="action_import" type="object" string="Import"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_audit_import" type="object" string="Audit import"
                            class="btn-secondary" invisible="state != 'draft'"
                            title="Check for issues (old external IDs, missing facility role, etc.)"/>
                    <button name="action_repair_import" type="object" string="Repair import"
                            class="btn-secondary" invisible="state != 'draft'"
                            title="Fix facilities missing facility_role and migrate old external IDs"/>
                    <button name="action_view_partners" type="object" string="View Partners"
                            class="btn-secondary" invisible="state != 'done'"/>
                    <button name="action_close" type="object" string="Close"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_partner_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Partners</field>
        <field name="res_model">plasticos.partner.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item under Contacts -->
    <menuitem id="menu_partner_import_wizard"
              name="Import Partners (CSV)"
              parent="contacts.menu_contacts"
              action="action_partner_import_wizard"
              sequence="100"/>

    <!-- Also add to PlasticOS menu (parent from plasticos_intake; dependency guarantees it exists) -->
    <menuitem id="menu_partner_import_wizard_plasticos"
              name="Import Partners"
              parent="plasticos_base.plasticos_root_menu"
              action="action_partner_import_wizard"
              sequence="90"/>

</odoo>
