<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- Commission Manager group — moved from plasticos_transaction.commission_acl.xml
             to break the circular dependency. Referenced in plasticos_base/hooks.py as
             plasticos_commission.group_plasticos_commission_manager -->
        <record id="group_plasticos_commission_manager" model="res.groups">
            <field name="name">Plasticos Commission Manager</field>
        </record>

        <record id="access_commission_rule_mgr" model="ir.model.access">
            <field name="name">commission_rule_manager</field>
            <field name="model_id" ref="plasticos_commission.model_plasticos_commission_rule"/>
            <field name="group_id" ref="plasticos_commission.group_plasticos_commission_manager"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

    </data>
</odoo>
