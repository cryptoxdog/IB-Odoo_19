<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ═══════════════════════════════════════════════════════════
       LIST VIEW
       Color coding:
         green  = closed + paid
         yellow = delivered/invoiced but docs missing  (chase docs)
         blue   = in transit / active
         red    = load exception
         muted  = draft
  ═══════════════════════════════════════════════════════════ -->
  <record id="view_sales_dashboard_list" model="ir.ui.view">
    <field name="name">plasticos.sales.dashboard.list</field>
    <field name="model">plasticos.sales.dashboard</field>
    <field name="arch" type="xml">
      <list string="My Deals"
            create="false" edit="false" delete="false"
            decoration-success="transaction_state == 'closed' and commission_payout_state == 'paid'"
            decoration-warning="transaction_state in ('delivered','invoiced') and not docs_all_clear"
            decoration-info="transaction_state in ('dispatched','in_transit','in_progress')"
            decoration-danger="load_state == 'exception'"
            decoration-muted="transaction_state == 'draft'">

        <field name="transaction_ref"         string="Deal #"        optional="show"/>
        <field name="buyer_id"                string="Buyer"         optional="show"/>
        <field name="supplier_id"             string="Supplier"      optional="show"/>
        <field name="product_id"              string="Material"      optional="show"/>
        <field name="purchase_cost_total"     string="Buy $"         widget="monetary" optional="show"/>
        <field name="revenue_total"           string="Sell $"        widget="monetary" optional="show"/>
        <field name="freight_cost_total"      string="Freight $"     widget="monetary" optional="show"/>
        <field name="gross_margin"            string="Margin $"      widget="monetary" optional="hide"/>
        <field name="final_weight"            string="Net Wt (lbs)"  optional="show"/>
        <field name="weight_source"           string="Wt Source"
               widget="badge"
               decoration-success="weight_source == 'scale'"
               decoration-warning="weight_source in ('buyer','supplier')"
               decoration-danger="weight_source == 'none'"
               optional="show"/>
        <field name="transaction_state"       string="Deal Status"
               widget="badge"
               decoration-success="transaction_state == 'closed'"
               decoration-warning="transaction_state in ('pending_supplier','supplier_not_ready')"
               decoration-info="transaction_state in ('dispatched','in_transit','in_progress')"
               optional="show"/>
        <field name="load_count"              string="Loads" optional="show"/>
        <field name="load_state"              string="Load"
               widget="badge"
               decoration-danger="load_state == 'exception'"
               decoration-info="load_state in ('dispatched','picked_up')"
               decoration-success="load_state == 'delivered'"
               optional="show"/>
        <field name="pickup_dock_rule"        string="Pickup Rule"   optional="hide"/>
        <field name="delivery_term"           string="Delivery Rule" optional="hide"/>
        <field name="pickup_datetime"         string="Pickup"        optional="hide"/>
        <field name="delivery_datetime"       string="Est. Delivery" optional="hide"/>
        <!-- Document traffic lights -->
        <field name="doc_bol"                 string="BOL"
               widget="badge"
               decoration-success="doc_bol == 'ok'"
               decoration-warning="doc_bol == 'pending'"
               decoration-danger="doc_bol == 'missing'"
               optional="show"/>
        <field name="doc_scale_ticket"        string="Scale"
               widget="badge"
               decoration-success="doc_scale_ticket == 'ok'"
               decoration-warning="doc_scale_ticket == 'pending'"
               decoration-danger="doc_scale_ticket == 'missing'"
               optional="show"/>
        <field name="doc_invoice"             string="Invoice"
               widget="badge"
               decoration-success="doc_invoice == 'ok'"
               decoration-warning="doc_invoice == 'pending'"
               decoration-danger="doc_invoice == 'missing'"
               optional="show"/>
        <field name="doc_customer_order"      string="CO"
               widget="badge"
               decoration-success="doc_customer_order == 'ok'"
               decoration-warning="doc_customer_order == 'pending'"
               decoration-danger="doc_customer_order == 'missing'"
               optional="show"/>
        <field name="commission_amount"       string="Est. Commission" widget="monetary" optional="show"/>
        <field name="commission_locked_amount" string="Final Commission" widget="monetary" optional="hide"/>
        <field name="commission_payout_state" string="Pay Status"
               widget="badge"
               decoration-success="commission_payout_state == 'paid'"
               decoration-warning="commission_payout_state == 'confirmed'"
               decoration-muted="commission_payout_state in ('unpaid','draft')"
               optional="show"/>
        <!-- Hidden helpers for list decorations -->
        <field name="docs_all_clear"          column_invisible="1"/>
        <field name="currency_id"             column_invisible="1"/>
      </list>
    </field>
  </record>

  <!-- ═══════════════════════════════════════════════════════════
       FORM VIEW — drill into a single deal
  ═══════════════════════════════════════════════════════════ -->
  <record id="view_sales_dashboard_form" model="ir.ui.view">
    <field name="name">plasticos.sales.dashboard.form</field>
    <field name="model">plasticos.sales.dashboard</field>
    <field name="arch" type="xml">
      <form string="My Deal" create="false" edit="false" delete="false">
        <sheet>
          <div class="oe_button_box" name="button_box">
            <field name="can_open_transaction" invisible="1"/>
            <button name="action_view_transaction" type="object"
                    string="Open Deal" icon="fa-external-link" class="oe_stat_button"
                    invisible="not can_open_transaction"/>
          </div>
          <div class="oe_title">
            <h1><field name="transaction_ref" readonly="1"/></h1>
          </div>
          <field name="transaction_state" widget="statusbar"
                 statusbar_visible="active,dispatched,in_transit,delivered,invoiced,closed"
                 readonly="1"/>

          <group>
            <group string="Deal">
              <field name="supplier_id"         readonly="1"/>
              <field name="buyer_id"            readonly="1"/>
              <field name="product_id"          string="Material" readonly="1"/>
              <field name="quantity"            readonly="1"/>
              <field name="uom_id"              readonly="1"/>
            </group>
            <group string="Financials">
              <field name="purchase_cost_total" string="Buy Total"    widget="monetary" readonly="1"/>
              <field name="revenue_total"       string="Sell Total"   widget="monetary" readonly="1"/>
              <field name="freight_cost_total"  string="Freight"      widget="monetary" readonly="1"/>
              <field name="gross_margin"        string="Gross Margin" widget="monetary" readonly="1"/>
              <field name="currency_id"         invisible="1"/>
            </group>
          </group>

          <group>
            <group string="Weight">
              <field name="final_weight"          string="Final Net Weight (lbs)" readonly="1"/>
              <field name="weight_source"         readonly="1" widget="badge"
                     decoration-success="weight_source == 'scale'"
                     decoration-warning="weight_source in ('buyer','supplier')"
                     decoration-danger="weight_source == 'none'"/>
              <field name="weight_discrepancy_flagged" string="Discrepancy Flagged" readonly="1"/>
              <field name="weight_discrepancy_pct" string="Discrepancy %" readonly="1"
                     invisible="not weight_discrepancy_flagged"/>
              <button name="action_view_scale_docs" type="object"
                      string="↗ View Scale Ticket" class="btn-link text-warning"
                      invisible="weight_source == 'scale' and doc_scale_ticket == 'ok'"/>
            </group>
            <group string="Logistics">
              <field name="load_count"        readonly="1"/>
              <field name="load_state"        readonly="1" widget="badge"
                     decoration-danger="load_state == 'exception'"
                     decoration-success="load_state == 'delivered'"/>
              <field name="carrier_name"      string="Carrier" readonly="1"/>
              <field name="trailer_number"    readonly="1"/>
              <field name="pickup_dock_rule"  string="Pickup Dock Rule" readonly="1"/>
              <field name="delivery_term"     string="Delivery Dock Rule" readonly="1"/>
              <field name="pickup_datetime"   readonly="1"/>
              <field name="delivery_datetime" string="Est. Delivery" readonly="1"/>
              <field name="delivered_at"      readonly="1" invisible="not delivered_at"/>
              <button name="action_view_load" type="object"
                      string="↗ Track Load" class="btn-link"/>
            </group>
          </group>

          <group string="Documents — Missing = Blocking Payment">
            <group>
              <field name="doc_bol" string="Bill of Lading" readonly="1" widget="badge"
                     decoration-success="doc_bol == 'ok'"
                     decoration-warning="doc_bol == 'pending'"
                     decoration-danger="doc_bol == 'missing'"/>
              <button name="action_view_bol_docs" type="object"
                      string="↗ View BOL" class="btn-link"
                      invisible="doc_bol == 'missing'"/>

              <field name="doc_scale_ticket" string="Scale Ticket" readonly="1" widget="badge"
                     decoration-success="doc_scale_ticket == 'ok'"
                     decoration-warning="doc_scale_ticket == 'pending'"
                     decoration-danger="doc_scale_ticket == 'missing'"/>
              <button name="action_view_scale_docs" type="object"
                      string="↗ View Scale Ticket" class="btn-link"
                      invisible="doc_scale_ticket == 'missing'"/>
            </group>
            <group>
              <field name="doc_invoice" string="Invoice" readonly="1" widget="badge"
                     decoration-success="doc_invoice == 'ok'"
                     decoration-warning="doc_invoice == 'pending'"
                     decoration-danger="doc_invoice == 'missing'"/>
              <field name="doc_customer_order" string="Customer Order" readonly="1" widget="badge"
                     decoration-success="doc_customer_order == 'ok'"
                     decoration-warning="doc_customer_order == 'pending'"
                     decoration-danger="doc_customer_order == 'missing'"/>
              <field name="docs_all_clear" string="All Docs ✓" readonly="1" widget="boolean"/>
            </group>
            <div class="text-muted o_field_widget mt4">
              <i class="fa fa-info-circle" title="Info"/> ⏳ Pending Review = uploaded but flagged for human verification.
            </div>
          </group>

          <group string="My Commission">
            <field name="commission_amount"         string="Estimated"      widget="monetary" readonly="1"/>
            <field name="commission_locked"         invisible="1"/>
            <field name="commission_locked_amount"  string="Final (Locked)" widget="monetary" readonly="1"
                   invisible="not commission_locked"/>
            <field name="commission_payout_state"   string="Pay Status" widget="badge"
                   decoration-success="commission_payout_state == 'paid'"
                   decoration-warning="commission_payout_state == 'confirmed'"
                   decoration-muted="commission_payout_state in ('unpaid','draft')"
                   readonly="1"/>
            <button name="action_view_payout" type="object"
                    string="↗ View Payout Details" class="btn-link"
                    invisible="commission_payout_state == 'unpaid'"/>
          </group>

          <notebook>
            <page string="All Documents" name="documents">
              <p class="text-muted">All documents linked to this deal, including buyer documents.</p>
              <button name="action_view_my_docs" type="object"
                      string="Open Full Document List" class="btn-secondary"/>
            </page>
          </notebook>

        </sheet>
      </form>
    </field>
  </record>

  <!-- ═══════════════════════════════════════════════════════════
       SEARCH VIEW
  ═══════════════════════════════════════════════════════════ -->
  <record id="view_sales_dashboard_search" model="ir.ui.view">
    <field name="name">plasticos.sales.dashboard.search</field>
    <field name="model">plasticos.sales.dashboard</field>
    <field name="arch" type="xml">
      <search>
        <field name="transaction_ref" string="Deal #"/>
        <field name="buyer_id"/>
        <field name="supplier_id"/>
        <separator/>
        <filter name="docs_missing"
                string="⚠ Docs Missing"
                domain="[('docs_all_clear','=',False),('transaction_state','not in',['draft','cancelled'])]"/>
        <filter name="in_transit"
                string="In Transit"
                domain="[('load_state','in',['dispatched','picked_up'])]"/>
        <filter name="delivered_not_closed"
                string="Delivered — Awaiting Docs"
                domain="[('transaction_state','in',['delivered','invoiced']),('docs_all_clear','=',False)]"/>
        <filter name="active_deals"
                string="Active"
                domain="[('transaction_state','not in',['closed','cancelled','draft'])]"/>
        <filter name="commission_unpaid"
                string="Commission Unpaid"
                domain="[('commission_payout_state','!=','paid'),('transaction_state','=','closed')]"/>
        <filter name="load_exception"
                string="Load Exception"
                domain="[('load_state','=','exception')]"/>
        <separator/>
        <filter name="group_deal_status"   string="Group by Deal Status"   context="{'group_by': 'transaction_state'}"/>
        <filter name="group_load_status"   string="Group by Load Status"   context="{'group_by': 'load_state'}"/>
        <filter name="group_pay_status"    string="Group by Pay Status"    context="{'group_by': 'commission_payout_state'}"/>
        <filter name="group_weight_source" string="Group by Weight Source" context="{'group_by': 'weight_source'}"/>
      </search>
    </field>
  </record>

  <!-- ═══════════════════════════════════════════════════════════
       PIVOT + GRAPH — margin and expected commission by deal status
  ═══════════════════════════════════════════════════════════ -->
  <record id="view_sales_dashboard_pivot" model="ir.ui.view">
    <field name="name">plasticos.sales.dashboard.pivot</field>
    <field name="model">plasticos.sales.dashboard</field>
    <field name="arch" type="xml">
      <pivot string="My Deals Analysis" sample="1">
        <field name="transaction_state" type="row"/>
        <field name="gross_margin" type="measure"/>
        <field name="commission_amount" type="measure" string="Expected Commission"/>
        <field name="revenue_total" type="measure"/>
      </pivot>
    </field>
  </record>

  <record id="view_sales_dashboard_graph" model="ir.ui.view">
    <field name="name">plasticos.sales.dashboard.graph</field>
    <field name="model">plasticos.sales.dashboard</field>
    <field name="arch" type="xml">
      <graph string="My Deals" type="bar" sample="1">
        <field name="transaction_state"/>
        <field name="gross_margin" type="measure"/>
      </graph>
    </field>
  </record>

  <!-- ═══════════════════════════════════════════════════════════
       ACTION + MENU
  ═══════════════════════════════════════════════════════════ -->
  <record id="action_sales_dashboard" model="ir.actions.act_window">
    <field name="name">My Deals</field>
    <field name="res_model">plasticos.sales.dashboard</field>
    <field name="view_mode">list,form,pivot,graph</field>
    <field name="context">{"search_default_active_deals": 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No deals yet.</p>
      <p>Your transactions will appear here once assigned.</p>
    </field>
  </record>

  <menuitem id="menu_sales_rep_root"
            name="My Deals"
            sequence="1"
            groups="plasticos_security_base.group_sales_rep"/>

  <menuitem id="menu_sales_dashboard"
            name="My Deals"
            parent="menu_sales_rep_root"
            action="action_sales_dashboard"
            sequence="1"
            groups="plasticos_security_base.group_sales_rep"/>

  <!-- ═══════════════════════════════════════════════════════════
       SALES COMMAND CENTER (TASK-033) — one drill per declared KPI.
       Each server action calls action_open_sales_kpi(key), which builds the
       window from the same declaration that computes the KPI value (DEC-007).
  ═══════════════════════════════════════════════════════════ -->
  <!-- ═══════════════════════════════════════════════════════════
       SALES COMMAND CENTER TILES (TASK-033) — read-only presentation row.
       Each tile shows get_sales_kpis() for the current user and opens the
       KPI's drill; an unavailable KPI reads "Unavailable", never 0.
  ═══════════════════════════════════════════════════════════ -->
  <record id="view_sales_command_center_form" model="ir.ui.view">
    <field name="name">plasticos.sales.command.center.form</field>
    <field name="model">plasticos.sales.command.center</field>
    <field name="arch" type="xml">
      <form string="Sales Command Center" create="false" edit="false" delete="false">
        <sheet>
          <field name="open_opportunities_available" invisible="1"/>
          <field name="outstanding_offers_available" invisible="1"/>
          <field name="active_deals_available" invisible="1"/>
          <field name="pending_confirmations_available" invisible="1"/>
          <field name="margin_available" invisible="1"/>
          <field name="expected_commission_available" invisible="1"/>
          <field name="missing_customer_documents_available" invisible="1"/>
          <div class="oe_button_box" name="button_box">
            <button name="action_open_kpi" type="object" class="oe_stat_button" icon="fa-bar-chart"
                    context="{'kpi_key': 'open_opportunities'}" invisible="not open_opportunities_available">
              <div class="o_stat_info">
                <span class="o_stat_value"><field name="open_opportunities_value"/></span>
                <span class="o_stat_text">My Open Opportunities</span>
              </div>
            </button>
            <div class="o_stat_info text-muted" invisible="open_opportunities_available">
              <span class="o_stat_value">Unavailable</span>
              <span class="o_stat_text">My Open Opportunities</span>
            </div>
            <button name="action_open_kpi" type="object" class="oe_stat_button" icon="fa-bar-chart"
                    context="{'kpi_key': 'outstanding_offers'}" invisible="not outstanding_offers_available">
              <div class="o_stat_info">
                <span class="o_stat_value"><field name="outstanding_offers_value"/></span>
                <span class="o_stat_text">My Outstanding Offers</span>
              </div>
            </button>
            <div class="o_stat_info text-muted" invisible="outstanding_offers_available">
              <span class="o_stat_value">Unavailable</span>
              <span class="o_stat_text">My Outstanding Offers</span>
            </div>
            <button name="action_open_kpi" type="object" class="oe_stat_button" icon="fa-bar-chart"
                    context="{'kpi_key': 'active_deals'}" invisible="not active_deals_available">
              <div class="o_stat_info">
                <span class="o_stat_value"><field name="active_deals_value"/></span>
                <span class="o_stat_text">My Active Deals</span>
              </div>
            </button>
            <div class="o_stat_info text-muted" invisible="active_deals_available">
              <span class="o_stat_value">Unavailable</span>
              <span class="o_stat_text">My Active Deals</span>
            </div>
            <button name="action_open_kpi" type="object" class="oe_stat_button" icon="fa-bar-chart"
                    context="{'kpi_key': 'pending_confirmations'}" invisible="not pending_confirmations_available">
              <div class="o_stat_info">
                <span class="o_stat_value"><field name="pending_confirmations_value"/></span>
                <span class="o_stat_text">Pending Supplier Confirmations</span>
              </div>
            </button>
            <div class="o_stat_info text-muted" invisible="pending_confirmations_available">
              <span class="o_stat_value">Unavailable</span>
              <span class="o_stat_text">Pending Supplier Confirmations</span>
            </div>
            <button name="action_open_kpi" type="object" class="oe_stat_button" icon="fa-bar-chart"
                    context="{'kpi_key': 'margin'}" invisible="not margin_available">
              <div class="o_stat_info">
                <span class="o_stat_value"><field name="margin_value"/></span>
                <span class="o_stat_text">Margin on Active Deals</span>
              </div>
            </button>
            <div class="o_stat_info text-muted" invisible="margin_available">
              <span class="o_stat_value">Unavailable</span>
              <span class="o_stat_text">Margin on Active Deals</span>
            </div>
            <button name="action_open_kpi" type="object" class="oe_stat_button" icon="fa-bar-chart"
                    context="{'kpi_key': 'expected_commission'}" invisible="not expected_commission_available">
              <div class="o_stat_info">
                <span class="o_stat_value"><field name="expected_commission_value"/></span>
                <span class="o_stat_text">Expected Commission</span>
              </div>
            </button>
            <div class="o_stat_info text-muted" invisible="expected_commission_available">
              <span class="o_stat_value">Unavailable</span>
              <span class="o_stat_text">Expected Commission</span>
            </div>
            <button name="action_open_kpi" type="object" class="oe_stat_button" icon="fa-bar-chart"
                    context="{'kpi_key': 'missing_customer_documents'}" invisible="not missing_customer_documents_available">
              <div class="o_stat_info">
                <span class="o_stat_value"><field name="missing_customer_documents_value"/></span>
                <span class="o_stat_text">Deals Missing Customer Documents</span>
              </div>
            </button>
            <div class="o_stat_info text-muted" invisible="missing_customer_documents_available">
              <span class="o_stat_value">Unavailable</span>
              <span class="o_stat_text">Deals Missing Customer Documents</span>
            </div>
          </div>
          <p class="text-muted">
            Your records only, in your active companies. Deals without a sale order are not counted.
          </p>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_sales_command_center" model="ir.actions.server">
    <field name="name">Sales Command Center</field>
    <field name="model_id" ref="plasticos_commission.model_plasticos_sales_command_center"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open_command_center()</field>
  </record>

  <menuitem id="menu_sales_command_center"
            name="Command Center"
            parent="menu_sales_rep_root"
            sequence="5"
            groups="plasticos_security_base.group_sales_rep"/>

  <menuitem id="menu_sales_command_center_overview"
            name="Overview"
            parent="menu_sales_command_center"
            action="action_sales_command_center"
            sequence="1"
            groups="plasticos_security_base.group_sales_rep"/>

  <record id="action_sales_kpi_open_opportunities" model="ir.actions.server">
    <field name="name">My Open Opportunities</field>
    <field name="model_id" ref="plasticos_commission.model_plasticos_sales_dashboard"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open_sales_kpi("open_opportunities")</field>
  </record>
  <menuitem id="menu_sales_kpi_open_opportunities"
            name="My Open Opportunities"
            parent="menu_sales_command_center"
            action="action_sales_kpi_open_opportunities"
            sequence="10"
            groups="plasticos_security_base.group_sales_rep"/>

  <record id="action_sales_kpi_active_deals" model="ir.actions.server">
    <field name="name">My Active Deals</field>
    <field name="model_id" ref="plasticos_commission.model_plasticos_sales_dashboard"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open_sales_kpi("active_deals")</field>
  </record>
  <menuitem id="menu_sales_kpi_active_deals"
            name="My Active Deals"
            parent="menu_sales_command_center"
            action="action_sales_kpi_active_deals"
            sequence="20"
            groups="plasticos_security_base.group_sales_rep"/>

  <record id="action_sales_kpi_pending_confirmations" model="ir.actions.server">
    <field name="name">Pending Supplier Confirmations</field>
    <field name="model_id" ref="plasticos_commission.model_plasticos_sales_dashboard"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open_sales_kpi("pending_confirmations")</field>
  </record>
  <menuitem id="menu_sales_kpi_pending_confirmations"
            name="Pending Supplier Confirmations"
            parent="menu_sales_command_center"
            action="action_sales_kpi_pending_confirmations"
            sequence="30"
            groups="plasticos_security_base.group_sales_rep"/>

  <record id="action_sales_kpi_margin" model="ir.actions.server">
    <field name="name">Margin on Active Deals</field>
    <field name="model_id" ref="plasticos_commission.model_plasticos_sales_dashboard"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open_sales_kpi("margin")</field>
  </record>
  <menuitem id="menu_sales_kpi_margin"
            name="Margin on Active Deals"
            parent="menu_sales_command_center"
            action="action_sales_kpi_margin"
            sequence="40"
            groups="plasticos_security_base.group_sales_rep"/>

  <record id="action_sales_kpi_expected_commission" model="ir.actions.server">
    <field name="name">Expected Commission on Active Deals</field>
    <field name="model_id" ref="plasticos_commission.model_plasticos_sales_dashboard"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open_sales_kpi("expected_commission")</field>
  </record>
  <menuitem id="menu_sales_kpi_expected_commission"
            name="Expected Commission on Active Deals"
            parent="menu_sales_command_center"
            action="action_sales_kpi_expected_commission"
            sequence="50"
