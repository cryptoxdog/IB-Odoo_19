/reports/

# Explicit override: memory-bank/ is excluded by this machine's global
# gitignore (~/.gitignore_global) but must be tracked in THIS repo so a fresh
# clone gets T0 session-resume context. Negation must come after any blanket
# ignore in this file (none currently exists here for memory-bank).
!/memory-bank/
!/memory-bank/**

# Local PR-check / tool caches
.cache/
.l9/autonomy/

# ═══════════════════════════════════════════════════════════
# Claude Code machine-local settings + governance bootstrap output
# ═══════════════════════════════════════════════════════════
# `.claude/settings.json` IS tracked — it holds the repo's shared hooks, all
# defined inline. These two are per-machine and regenerated by the governance
# sessionStart bootstrap on every clone, so tracking them would commit local
# environment config and duplicate the governance SSOT into this repo.
.claude/settings.local.json
.claude/hooks/
