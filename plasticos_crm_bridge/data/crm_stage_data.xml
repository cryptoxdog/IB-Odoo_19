<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--
            VanillaSoft stages stay as xmlids for historical refs and the
            unapproved-status fallback. They are pinned to a retired team so
            the pipeline shows the native New / Qualified / Proposition / Won
            stages. Opportunities are moved onto those native stages by
            migrations/19.0.3.4.24/post-migrate.py.
        -->
        <record id="team_vanillasoft_retired" model="crm.team">
            <field name="name">Retired VanillaSoft Stages</field>
            <field name="active" eval="False"/>
        </record>

        <record id="stage_new" model="crm.stage">
            <field name="name">New</field>
            <field name="sequence">901</field>
            <field name="fold" eval="True"/>
            <field name="team_ids" eval="[(6, 0, [ref('plasticos_crm_bridge.team_vanillasoft_retired')])]"/>
        </record>

        <record id="stage_qualified_hot" model="crm.stage">
            <field name="name">Qualified — HOT</field>
            <field name="sequence">910</field>
            <field name="fold" eval="True"/>
            <field name="team_ids" eval="[(6, 0, [ref('plasticos_crm_bridge.team_vanillasoft_retired')])]"/>
        </record>

        <record id="stage_qualified_warm" model="crm.stage">
            <field name="name">Qualified — WARM</field>
            <field name="sequence">920</field>
            <field name="fold" eval="True"/>
            <field name="team_ids" eval="[(6, 0, [ref('plasticos_crm_bridge.team_vanillasoft_retired')])]"/>
        </record>

        <record id="stage_resistant" model="crm.stage">
            <field name="name">Resistant</field>
            <field name="sequence">930</field>
            <field name="fold" eval="True"/>
            <field name="team_ids" eval="[(6, 0, [ref('plasticos_crm_bridge.team_vanillasoft_retired')])]"/>
        </record>

        <record id="stage_active_supplier" model="crm.stage">
            <field name="name">Active Supplier</field>
            <field name="is_won">True</field>
            <field name="sequence">1000</field>
            <field name="fold" eval="True"/>
            <field name="team_ids" eval="[(6, 0, [ref('plasticos_crm_bridge.team_vanillasoft_retired')])]"/>
        </record>

        <record id="stage_dead_lead" model="crm.stage">
            <field name="name">Dead Lead</field>
            <field name="sequence">1099</field>
            <field name="fold" eval="True"/>
            <field name="team_ids" eval="[(6, 0, [ref('plasticos_crm_bridge.team_vanillasoft_retired')])]"/>
        </record>

    </data>
</odoo>
