<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--
            Business Classification Tags for PlastOS
            Applied to res.partner via category_id (Many2many tags).
            Derived from VanillaSoft "Company Type" field values.
        -->

        <record id="categ_distribution_center" model="res.partner.category">
            <field name="name">Distribution Center</field>
            <field name="color">1</field>
        </record>

        <record id="categ_commercial_recycler" model="res.partner.category">
            <field name="name">Commercial Recycler</field>
            <field name="color">2</field>
        </record>

        <record id="categ_pallet_recycler" model="res.partner.category">
            <field name="name">Pallet Recycler</field>
            <field name="color">3</field>
        </record>

        <record id="categ_compounder" model="res.partner.category">
            <field name="name">Compounder</field>
            <field name="color">4</field>
        </record>

        <record id="categ_grinder_processor" model="res.partner.category">
            <field name="name">Grinder/Processor</field>
            <field name="color">5</field>
        </record>

        <record id="categ_ewaste" model="res.partner.category">
            <field name="name">E-Waste</field>
            <field name="color">6</field>
        </record>

        <record id="categ_mrf" model="res.partner.category">
            <field name="name">MRF</field>
            <field name="color">7</field>
        </record>

        <record id="categ_manufacturer" model="res.partner.category">
            <field name="name">Manufacturer</field>
            <field name="color">8</field>
        </record>

        <record id="categ_broker" model="res.partner.category">
            <field name="name">Broker</field>
            <field name="color">9</field>
        </record>

        <record id="categ_carrier" model="res.partner.category">
            <field name="name">Carrier</field>
            <field name="color">10</field>
        </record>

        <!-- Role tags (from Buyer/Supplier column) -->
        <record id="categ_buyer" model="res.partner.category">
            <field name="name">Buyer</field>
            <field name="color">11</field>
        </record>

        <record id="categ_supplier" model="res.partner.category">
            <field name="name">Supplier</field>
            <field name="color">14</field>
        </record>

    </data>
</odoo>
