<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adopt an existing crm.tag of this name. Do not insert a second Buyer or Supplier. -->
    <function model="crm.lead" name="_plasticos_adopt_crm_role_tag">
        <value>Buyer</value>
        <value>plasticos_crm_bridge.crm_tag_buyer</value>
    </function>
    <function model="crm.lead" name="_plasticos_adopt_crm_role_tag">
        <value>Supplier</value>
        <value>plasticos_crm_bridge.crm_tag_supplier</value>
    </function>
</odoo>
