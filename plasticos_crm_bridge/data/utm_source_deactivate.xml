<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Deactivate Odoo-default utm.source records that are not relevant
            to the plastics brokerage workflow.
            Our business sources are defined in lead_source_data.xml.
        -->

        <record id="utm.utm_source_search_engine" model="utm.source">
            <field name="active" eval="False"/>
        </record>

        <!-- "Lead Recall" was renamed to utm_source_mailing in Odoo 19 -->
        <record id="utm.utm_source_mailing" model="utm.source">
            <field name="active" eval="False"/>
        </record>

        <record id="utm.utm_source_newsletter" model="utm.source">
            <field name="active" eval="False"/>
        </record>

        <record id="utm.utm_source_facebook" model="utm.source">
            <field name="active" eval="False"/>
        </record>

        <record id="utm.utm_source_twitter" model="utm.source">
            <field name="active" eval="False"/>
        </record>

        <record id="utm.utm_source_monster" model="utm.source">
            <field name="active" eval="False"/>
        </record>

        <record id="utm.utm_source_glassdoor" model="utm.source">
            <field name="active" eval="False"/>
        </record>

        <record id="utm.utm_source_craigslist" model="utm.source">
            <field name="active" eval="False"/>
        </record>

        <!--
            KEPT ACTIVE:
            - utm.utm_source_linkedin  (we have our own too in lead_source_data.xml)
            - utm.utm_source_referral  (used by CRM referral workflow)
        -->
    </data>
</odoo>
