<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend CRM Lead form view with PlastOS bridge fields -->
    <record id="crm_lead_plasticos_bridge_form" model="ir.ui.view">
        <field name="name">crm.lead.plasticos.bridge.form</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- Smart buttons for Web Leads and Material Profiles -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(plasticos_web_leads.action_plasticos_web_lead)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-globe"
                        invisible="web_lead_count == 0">
                    <field name="web_lead_count" string="Web Leads" widget="statinfo"/>
                </button>
                <button type="object"
                        name="action_view_material_profiles"
                        class="oe_stat_button"
                        icon="fa-recycle"
                        invisible="material_profile_count == 0">
                    <field name="material_profile_count" string="Profiles" widget="statinfo"/>
                </button>
            </xpath>

            <!-- PlastOS summary tab -->
            <xpath expr="//notebook" position="inside">
                <page string="PlastOS Summary" name="plasticos_summary_tab">
                    <group>
                        <group string="Match &amp; Transaction Stats">
                            <field name="total_match_count" readonly="1"/>
                            <field name="total_transaction_count" readonly="1"/>
                            <field name="partner_total_revenue" readonly="1"/>
                            <field name="partner_last_pickup" readonly="1"/>
                        </group>
                    </group>
                    <field name="web_lead_ids" readonly="1">
                        <list>
                            <field name="lead_id"/>
                            <field name="company_name"/>
                            <field name="contact_name"/>
                            <field name="contact_email"/>
                            <field name="decision"/>
                            <field name="create_date"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
