<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         CRM Lead Form — PlastOS Pipeline Overhaul
         Inherits: crm.crm_lead_view_form (Odoo core)
         ═══════════════════════════════════════════════════════════════ -->

    <record id="crm_lead_plastos_bridge_form" model="ir.ui.view">
        <field name="name">crm.lead.plastos.bridge.form</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">

            <!-- ═══ Convert to Intake — header button (green, between CTO and Enrich) ═══ -->
            <xpath expr="//header/button[@name='%(crm.action_crm_lead2opportunity_partner)d']" position="attributes">
                <attribute name="title">Standard Odoo CRM action. Converts this lead into a sales opportunity and creates/links a contact. Use for general CRM pipeline tracking.</attribute>
            </xpath>
            <xpath expr="//header/button[@name='%(crm.action_crm_lead2opportunity_partner)d']" position="after">
                <button name="action_convert_to_intake"
                        type="object"
                        string="Convert to Intake"
                        class="btn btn-success"
                        data-hotkey="i"
                        title="PlasticOS: Creates a material intake record from this lead, starting the plastics brokerage pipeline (Intake &#8594; Matching &#8594; Offer &#8594; Transaction)."
                        invisible="not active or (type == 'opportunity' and not source_intake_id)"/>
                <!-- The one Opportunity matching command: approve a frozen lot, match it through Gate. -->
                <button name="action_match_opportunity"
                        type="object"
                        string="Match via Gate"
                        class="btn btn-primary"
                        title="PlasticOS: Approves an immutable lot from the linked Partner and Material Profile (Facility optional) and runs the Gate match. HOT, manual and VanillaSoft opportunities all use this command."
                        invisible="not active or type != 'opportunity' or not partner_id or not material_profile_id"/>
                <button name="action_create_offers_from_results"
                        type="object"
                        string="Create Offers"
                        class="btn btn-secondary"
                        title="PlasticOS: Creates one unsent draft offer per reviewed (accepted) Gate result of the current lot. Re-running creates nothing new."
                        invisible="not active or type != 'opportunity' or not match_run_ids"/>
                <button name="action_submit_release"
                        type="object"
                        string="Submit"
                        class="btn btn-primary"
                        title="PlasticOS: Creates one draft purchase order at the accepted offer price, one draft sale order at the buyer price, and one draft transaction."
                        invisible="type != 'opportunity' or not stage_id.is_won or release_sale_order_id"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="after">
                <group string="Opportunity Material" invisible="type != 'opportunity' or not opportunity_material_ids">
                    <field name="opportunity_material_ids" nolabel="1" colspan="2">
                        <list create="false" delete="false" editable="bottom">
                            <field name="polymer_id"/>
                            <field name="material_grade_id"/>
                            <field name="form_id"/>
                            <field name="color_id"/>
                            <field name="packaging_type_id"/>
                            <field name="source_type_id"/>
                            <field name="filler_type_id"/>
                            <field name="material_attribute_ids" widget="many2many_tags"/>
                            <field name="melt_flow_index"/>
                            <field name="density"/>
                            <field name="moisture_percent"/>
                            <field name="contamination_percent"/>
                            <field name="filler_pct"/>
                            <field name="quantity_per_load_lbs"/>
                            <field name="loads_per_month"/>
                            <field name="freeform_notes"/>
                            <field name="image_attachment_ids" widget="many2many_binary"/>
                        </list>
                    </field>
                </group>
                <group string="Admin Release" invisible="type != 'opportunity' or not stage_id.is_won">
                    <field name="release_buyer_company_id"/>
                    <field name="release_buyer_facility_id"/>
                    <field name="release_buyer_price"/>
                    <field name="release_purchase_order_id" readonly="1"/>
                    <field name="release_sale_order_id" readonly="1"/>
                    <field name="release_transaction_id" readonly="1"/>
                </group>
            </xpath>

            <!-- ═══ Smart Buttons ═══ -->
            <xpath expr="//div[@name='button_box']" position="inside">

                <button name="action_view_web_leads"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-globe"
                        invisible="web_lead_count == 0">
                    <field name="web_lead_count"
                           string="Web Leads"
                           widget="statinfo"/>
                </button>

                <button name="action_view_material_profiles"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cubes"
                        invisible="material_profile_count == 0">
                    <field name="material_profile_count"
                           string="Profiles"
                           widget="statinfo"/>
                </button>

                <button name="action_view_match_results"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-handshake-o"
                        invisible="total_match_count == 0 and not match_run_ids">
                    <field name="total_match_count"
                           string="Matches"
                           widget="statinfo"/>
                </button>

                <button name="action_view_match_runs"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-random"
                        invisible="not match_run_ids"
                        title="Gate match runs on this opportunity's approved lots.">
                    <span class="o_stat_text">Gate Runs</span>
                </button>

                <button name="action_view_offers"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-tags"
                        invisible="not match_run_ids"
                        title="Offers created from this opportunity's reviewed Gate results.">
                    <span class="o_stat_text">Offers</span>
                </button>

                <button name="action_view_transactions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exchange"
                        invisible="total_transaction_count == 0">
                    <field name="total_transaction_count"
                           string="Transactions"
                           widget="statinfo"/>
                </button>

                <button name="action_view_intakes"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-clipboard"
                        invisible="intake_count == 0">
                    <field name="intake_count"
                           string="Intakes"
                           widget="statinfo"/>
                </button>

                <button name="action_sync_commercial_images"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-picture-o"
                        invisible="not source_intake_id and web_lead_count == 0"
                        title="Copy currently available web-lead, intake, and offer images to this CRM lead and its material profile.">
                    <field name="commercial_image_count"
                           string="Images"
                           widget="statinfo"/>
                </button>

            </xpath>

            <!-- ═══ LEAD VIEW: Add mobile, function, source below phone ═══ -->
            <xpath expr="//group[@name='lead_info']//field[@name='phone']/.." position="after">
                <field name="mobile" widget="phone"/>
                <field name="function"/>
                <field name="source_id"/>
            </xpath>

            <!-- ═══ OPPORTUNITY VIEW: Add mobile below phone ═══ -->
            <xpath expr="//group[@name='opportunity_partner']//field[@name='phone']/.." position="after">
                <field name="mobile" widget="phone"/>
            </xpath>

            <!-- ═══ Probability widget — hide from top, show at bottom ═══ -->
            <xpath expr="//div[@id='probability']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- ═══ Notes — promote to main form, hide Notes tab ═══ -->
            <xpath expr="//notebook[page[@name='internal_notes']]" position="before">
                <group string="Notes" class="mt-3">
                    <field name="description"
                           placeholder="Add notes about this lead..."
                           nolabel="1" colspan="2"
                           widget="html"/>
                </group>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- ═══ Probability — add at bottom after notebook ═══ -->
            <xpath expr="//notebook[page[@name='internal_notes']]" position="after">
                <group string="Scoring" class="mt-3"
                       invisible="type == 'lead'">
                    <group>
                        <field name="probability" widget="float" string="Win Probability (%)"/>
                        <field name="automated_probability" string="AI Probability (%)" readonly="1"/>
                    </group>
                </group>
            </xpath>

            <!-- ═══ PlastOS Pipeline Tab ═══ -->
            <xpath expr="//notebook[page[@name='internal_notes']]" position="inside">
                <page string="PlastOS Pipeline" name="plastos_pipeline_tab">

                    <div class="alert alert-info" role="alert"
                         invisible="total_transaction_count == 0">
                        <div class="d-flex justify-content-between">
                            <span>
                                <strong>Revenue:</strong>
                                $<field name="partner_total_revenue"
                                       nolabel="1"/>
                            </span>
                            <span>
                                <strong>Last Load Shipped:</strong>
                                <field name="partner_last_pickup" nolabel="1"/>
                            </span>
                        </div>
                    </div>

                    <group string="Web Lead Origins"
                           invisible="web_lead_count == 0">
                        <field name="web_lead_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="lead_id"/>
                                <field name="company_name"/>
                                <field name="decision" widget="badge"
                                       decoration-success="decision == 'hot'"
                                       decoration-muted="decision == 'cold'"/>
                                <field name="state" widget="badge"
                                       decoration-info="state == 'received'"
                                       decoration-success="state == 'intake_created'"
                                       decoration-muted="state == 'skipped'"
                                       decoration-danger="state == 'error'"/>
                                <field name="material_description"/>
                                <field name="estimated_lbs_per_load"/>
                                <field name="create_date"/>
                            </list>
                        </field>
                    </group>

                    <group string="Delivery Preferences">
                        <field name="delivery_term"/>
                    </group>

                    <group string="Commercial Material Context">
                        <field name="source_intake_id" readonly="1"/>
                        <field name="material_profile_id"
                               domain="[('partner_id', 'in', [partner_id, False])]"
                               readonly="type != 'opportunity'"/>
                        <field name="facility_profile_id"
                               readonly="type != 'opportunity'"
                               placeholder="Optional — no facility evidence is sent when empty"/>
                    </group>

                    <group string="Approved Lots" name="opportunity_lots" invisible="not approval_ids">
                        <field name="approval_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="create_date" string="Approved"/>
                                <field name="source" widget="badge"/>
                                <field name="partner_id"/>
                                <field name="material_profile_id"/>
                                <field name="facility_profile_id" optional="show"/>
                                <field name="source_intake_id" optional="hide"/>
                                <field name="snapshot_digest" optional="hide"/>
                                <field name="approved_by" optional="hide"/>
                            </list>
                        </field>
                    </group>

                    <group string="Gate Match Runs" name="opportunity_runs" invisible="not match_run_ids">
                        <field name="match_run_ids" nolabel="1" readonly="1">
                            <list decoration-danger="state in ('failed', 'degraded')"
                                  decoration-warning="state == 'retryable'"
                                  decoration-success="state == 'ok'">
                                <field name="create_date"/>
                                <field name="approval_id"/>
                                <field name="state" widget="badge"/>
                                <field name="match_count"/>
                                <field name="request_attempt" optional="hide"/>
                                <field name="operation_id" optional="hide"/>
                                <field name="gate_packet_id" optional="hide"/>
                            </list>
                        </field>
                    </group>

                    <group string="Pipeline Summary">
                        <group>
                            <field name="material_profile_count"
                                   string="Material Profiles"/>
                            <field name="total_match_count"
                                   string="Total Matches"/>
                        </group>
                        <group>
                            <field name="total_transaction_count"
                                   string="Transactions"/>
                            <field name="partner_total_revenue"
                                   string="Total Revenue"/>
                            <field name="partner_last_pickup"
                                   string="Last Load Shipped"/>
                        </group>
                    </group>

                </page>

                <page string="Personal Intel"
                      name="personal_intel_tab"
                      invisible="not partner_id or partner_id.is_company">
                    <group>
                        <field name="partner_personal_intel"
                               nolabel="1" colspan="2"
                               readonly="1"
                               placeholder="No Personal Intel recorded yet. Open the Contact to add notes."/>
                    </group>
                </page>

            </xpath>

        </field>
    </record>

    <record id="crm_lead_hide_new_quotation" model="ir.ui.view">
        <field name="name">crm.lead.hide.new.quotation</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="sale_crm.crm_case_form_view_oppor"/>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_sale_quotations_new']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         CRM Lead List — Dense view with toggleable columns
         ═══════════════════════════════════════════════════════════════ -->

    <record id="crm_lead_plastos_bridge_list" model="ir.ui.view">
        <field name="name">crm.lead.plastos.bridge.list</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <!-- Contact info -->
                <field name="phone" string="Phone" optional="show"/>
                <field name="mobile" string="Mobile" optional="show"/>
                <field name="function" string="Job Position" optional="hide"/>
                <field name="city" string="City" optional="show"/>
                <field name="state_id" string="State" optional="show"/>
                <field name="country_id" string="Country" optional="hide"/>
                <field name="source_id" string="Source" optional="show"/>
                <field name="vanillasoft_id" string="VS ID" optional="hide"/>
                <!-- Pipeline stats -->
                <field name="material_profile_count" string="Profiles" optional="show"/>
                <field name="total_match_count" string="Matches" optional="show"/>
                <field name="total_transaction_count" string="Txns" optional="show"/>
                <field name="partner_total_revenue" string="Revenue" optional="hide" sum="Total Revenue"/>
                <field name="partner_last_pickup" string="Last Shipped" optional="show"/>
                <field name="intake_count" string="Intakes" optional="show"/>
                <field name="web_lead_count" string="Web Leads" optional="hide"/>
                <field name="delivery_term" string="Delivery" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         CRM Lead Pivot View — Leads by Source x Stage
         ═══════════════════════════════════════════════════════════════ -->

    <record id="crm_lead_plastos_pivot" model="ir.ui.view">
        <field name="name">crm.lead.plastos.pivot</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <pivot string="CRM Leads Analysis">
                <field name="source_id" type="row"/>
                <field name="stage_id" type="col"/>
                <field name="expected_revenue" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         CRM Lead Calendar View — Leads by Create Date
         ═══════════════════════════════════════════════════════════════ -->

    <record id="crm_lead_plastos_calendar" model="ir.ui.view">
        <field name="name">crm.lead.plastos.calendar</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <calendar string="CRM Leads" date_start="create_date"
                      color="stage_id" event_open_popup="1" quick_create="0">
                <field name="partner_name"/>
                <field name="contact_name"/>
                <field name="stage_id" filters="1"/>
                <field name="user_id" filters="1" invisible="1"/>
            </calendar>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         NOTE: crm.crm_lead_all_pipeline override REMOVED.
         That XML ID was deleted in Odoo 19 — attempting to update it raises
         "Cannot update missing record 'crm.crm_lead_all_pipeline'" and crashes
         the registry at install/upgrade. The replacement action
         crm.crm_lead_action_pipeline already includes pivot + calendar in its
         view_mode, so no override is needed.
         DO NOT RE-ADD this record — it will crash the registry.
         ═══════════════════════════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════════════════════════
         Web Lead Form — Inject crm_lead_id field
         Inherits: plasticos_web_leads.view_web_lead_form
         ═══════════════════════════════════════════════════════════════ -->

    <record id="web_lead_crm_bridge_form" model="ir.ui.view">
        <field name="name">plasticos.web.lead.crm.bridge.form</field>
        <field name="model">plasticos.web.lead</field>
        <field name="inherit_id" ref="plasticos_web_leads.view_web_lead_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='links']" position="inside">
                <field name="crm_lead_id"/>
            </xpath>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Web Lead List — Add crm_lead_id column
         ═══════════════════════════════════════════════════════════════ -->

    <record id="web_lead_crm_bridge_list" model="ir.ui.view">
        <field name="name">plasticos.web.lead.crm.bridge.list</field>
        <field name="model">plasticos.web.lead</field>
        <field name="inherit_id" ref="plasticos_web_leads.view_web_lead_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='intake_id']" position="after">
                <field name="crm_lead_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Match Run — Opportunity / Lot lineage (fields owned by CRM Bridge)
         ═══════════════════════════════════════════════════════════════ -->

    <record id="match_run_opportunity_lineage_list" model="ir.ui.view">
        <field name="name">plasticos.match.run.opportunity.lineage.list</field>
        <field name="model">plasticos.match.run</field>
        <field name="inherit_id" ref="plasticos_matching.view_match_run_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='intake_id']" position="after">
                <field name="opportunity_id" optional="show"/>
                <field name="approval_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="match_run_opportunity_lineage_form" model="ir.ui.view">
        <field name="name">plasticos.match.run.opportunity.lineage.form</field>
        <field name="model">plasticos.match.run</field>
        <field name="inherit_id" ref="plasticos_matching.view_match_run_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form//field[@name='intake_id']" position="before">
                <field name="opportunity_id" readonly="1"/>
                <field name="approval_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Offer — Gate result lineage (field owned by CRM Bridge)
         ═══════════════════════════════════════════════════════════════ -->

    <record id="offer_match_result_lineage_form" model="ir.ui.view">
        <field name="name">plasticos.offer.match.result.lineage.form</field>
        <field name="model">plasticos.offer</field>
        <field name="inherit_id" ref="plasticos_offer.view_offer_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='origin']/field[@name='intake_id']" position="before">
                <field name="match_result_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="offer_match_result_lineage_list" model="ir.ui.view">
        <field name="name">plasticos.offer.match.result.lineage.list</field>
        <field name="model">plasticos.offer</field>
        <field name="inherit_id" ref="plasticos_offer.view_offer_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='intake_id']" position="after">
                <field name="match_result_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
