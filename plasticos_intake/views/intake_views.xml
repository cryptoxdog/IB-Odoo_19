<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════
         Search View (from #16 - enhanced with facility/contact)
         ═══════════════════════════════════════════════════════ -->

    <record id="view_plasticos_intake_search" model="ir.ui.view">
        <field name="name">plasticos.intake.search</field>
        <field name="model">plasticos.intake</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="facility_id"/>
                <field name="contact_id"/>
                <field name="assigned_user_id"/>
                <field name="polymer_id"/>
                <field name="form_id"/>
                <field name="source_type_id"/>
                <field name="material_profile_id"/>
                <filter name="filter_draft"
                        string="Draft"
                        domain="[('status', '=', 'draft')]"/>
                <filter name="filter_matched"
                        string="Matched"
                        domain="[('status', '=', 'matched')]"/>
                <filter name="filter_unassigned"
                        string="Unassigned"
                        domain="[('assigned_user_id', '=', False)]"/>
                <filter name="filter_my_intakes"
                        string="My Intakes"
                        domain="[('assigned_user_id', '=', uid)]"/>
                <separator/>
                <filter name="group_partner"
                        string="Company"
                        context="{'group_by': 'partner_id'}"/>
                <filter name="group_facility"
                        string="Facility"
                        context="{'group_by': 'facility_id'}"/>
                <filter name="group_assigned"
                        string="Assigned To"
                        context="{'group_by': 'assigned_user_id'}"/>
                <filter name="group_polymer"
                        string="Polymer"
                        context="{'group_by': 'polymer_id'}"/>
                <filter name="group_status"
                        string="Status"
                        context="{'group_by': 'status'}"/>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         List View
         ═══════════════════════════════════════════════════════ -->

    <record id="view_plasticos_intake_tree" model="ir.ui.view">
        <field name="name">plasticos.intake.tree</field>
        <field name="model">plasticos.intake</field>
        <field name="arch" type="xml">
            <list decoration-info="status == 'draft'"
                  decoration-success="status == 'matched'"
                  decoration-warning="status == 'draft' and assigned_user_id == False">
                <field name="partner_id"/>
                <field name="facility_id" optional="show"/>
                <field name="contact_id" optional="hide"/>
                <field name="assigned_user_id" optional="show" widget="many2one_avatar_user"/>
                <field name="polymer_id"/>
                <field name="form_id"/>
                <field name="source_type_id" optional="show"/>
                <field name="quantity_per_load_lbs" sum="Total Lbs/Load"/>
                <field name="loads_per_month" optional="show" sum="Total Loads/Mo"/>
                <field name="match_count" optional="show" sum="Total Matches"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'draft'"
                       decoration-success="status == 'matched'"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         Pivot View
         ═══════════════════════════════════════════════════════ -->

    <record id="view_plasticos_intake_pivot" model="ir.ui.view">
        <field name="name">plasticos.intake.pivot</field>
        <field name="model">plasticos.intake</field>
        <field name="arch" type="xml">
            <pivot string="Intake Analysis">
                <field name="status" type="col"/>
                <field name="polymer_id" type="row"/>
                <field name="quantity_per_load_lbs" type="measure"/>
                <field name="loads_per_month" type="measure"/>
                <field name="match_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         Graph View
         ═══════════════════════════════════════════════════════ -->

    <record id="view_plasticos_intake_graph" model="ir.ui.view">
        <field name="name">plasticos.intake.graph</field>
        <field name="model">plasticos.intake</field>
        <field name="arch" type="xml">
            <graph string="Intakes by Polymer" type="bar">
                <field name="polymer_id"/>
                <field name="quantity_per_load_lbs" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         Kanban View
         ═══════════════════════════════════════════════════════ -->

    <record id="view_plasticos_intake_kanban" model="ir.ui.view">
        <field name="name">plasticos.intake.kanban</field>
        <field name="model">plasticos.intake</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="partner_id"/>
                <field name="facility_id"/>
                <field name="polymer_id"/>
                <field name="form_id"/>
                <field name="quantity_per_load_lbs"/>
                <field name="loads_per_month"/>
                <field name="match_count"/>
                <field name="status"/>
                <field name="assigned_user_id"/>
                <progressbar field="status"
                             colors='{"draft": "info", "matched": "success"}'/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="partner_id"/>
                                </strong>
                                <span class="o_kanban_record_subtitle text-muted">
                                    <field name="facility_id"/>
                                </span>
                            </div>
                            <span class="badge bg-primary">
                                <field name="polymer_id"/>
                            </span>
                        </div>
                        <div class="o_kanban_record_body">
                            <div><strong>Form:</strong> <field name="form_id"/></div>
                            <div class="mt-2">
                                <span class="badge bg-secondary">
                                    <field name="quantity_per_load_lbs"/> lbs/load
                                </span>
                                <span class="badge bg-secondary">
                                    <field name="loads_per_month"/> loads/mo
                                </span>
                            </div>
                            <div t-if="record.match_count.raw_value" class="mt-1">
                                <span class="badge bg-success">
                                    <field name="match_count"/> matches
                                </span>
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left">
                                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         Form View (merged: #14 tab order + #16 contact fields)
         ═══════════════════════════════════════════════════════ -->

    <record id="view_plasticos_intake_form" model="ir.ui.view">
        <field name="name">plasticos.intake.form</field>
        <field name="model">plasticos.intake</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_match_to_buyers"
                        type="object"
                        string="Match To Buyers"
                        class="btn-primary"
                        invisible="status != 'draft'"
                    />
                    <button
                        name="action_reset_to_draft"
                        type="object"
                        string="Edit"
                        class="btn-secondary"
                        invisible="status != 'matched'"
                    />
                    <button
                        name="action_send_offers"
                        type="object"
                        string="Send Offers to Selected"
                        class="btn-success"
                        invisible="status != 'matched' or selected_count == 0"
                    />
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,matched"/>
                </header>
                <sheet>
                    <!-- Identity + Contact Header -->
                    <group>
                        <group string="Company &amp; Facility">
                            <field name="partner_id"/>
                            <field name="facility_id"/>
                            <field name="material_profile_id"/>
                        </group>
                        <group string="Contact &amp; Assignment">
                            <field name="contact_id"/>
                            <field name="contact_phone"/>
                            <field name="contact_email" widget="email"/>
                            <field name="assigned_user_id"/>
                        </group>
                    </group>

                    <!-- Material Section (main page, not in tab) -->
                    <group>
                        <group string="Material">
                            <field name="polymer_id"/>
                            <field name="form_id"/>
                            <field name="origin_form_id"/>
                            <field name="color_id"/>
                            <field name="source_type_id"/>
                            <field name="packaging_type_id"/>
                            <field name="material_attribute_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Volume &amp; Frequency">
                            <field name="quantity_per_load_lbs"/>
                            <field name="loads_per_month"/>
                            <field name="grade_hint"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Tab 1: Origin -->
                        <page string="Origin">
                            <group>
                                <group string="Application">
                                    <field name="origin_application"/>
                                    <field name="origin_sector"/>
                                    <field name="origin_process_type"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 3: Quality -->
                        <page string="Quality">
                            <group>
                                <group string="Observed Quality">
                                    <field name="mfi_value"/>
                                    <field name="density_value"/>
                                    <field name="moisture_pct"/>
                                    <field name="contamination_pct"/>
                                </group>
                                <group string="Contaminants">
                                    <field name="has_metal"/>
                                    <field name="has_fr"/>
                                    <field name="has_residue"/>
                                    <field name="filler_type"/>
                                    <field name="filler_pct"/>
                                </group>
                            </group>
                            <group string="Notes">
                                <field name="contamination_notes"/>
                            </group>
                        </page>

                        <!-- Tab 4: Facility Info (from #16) -->
                        <page string="Facility Info">
                            <group>
                                <group string="Facility Address">
                                    <field name="facility_phone"/>
                                    <field name="facility_street"/>
                                    <field name="facility_city"/>
                                    <field name="facility_state"/>
                                </group>
                                <group string="Coordinates">
                                    <field name="lat"/>
                                    <field name="lon"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 5: Buyer Matches -->
                        <page string="Buyer Matches" invisible="status != 'matched'">
                            <group>
                                <group>
                                    <field name="match_count" string="Total Matches"/>
                                    <field name="selected_count" string="Selected for Offer"/>
                                </group>
                            </group>
                            <field name="match_line_ids" nolabel="1">
                                <list editable="bottom" decoration-success="selected">
                                    <field name="selected" string="Select"/>
                                    <field name="buyer_name" string="Buyer"/>
                                    <field name="buyer_city"/>
                                    <field name="buyer_state"/>
                                    <field name="match_reason" string="Why Matched"/>
                                    <field name="match_score" string="Match %"/>
                                    <field name="typical_price" string="$/lb" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         Root App Menu
         ═══════════════════════════════════════════════════════ -->

    <menuitem id="plasticos_root_menu"
              name="PlasticOS"
              sequence="5"/>

    <!-- Intake Action -->
    <record id="plasticos_intake_action" model="ir.actions.act_window">
        <field name="name">Material Intake</field>
        <field name="res_model">plasticos.intake</field>
        <field name="view_mode">kanban,list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_plasticos_intake_search"/>
        <field name="context">{'search_default_filter_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No material intakes yet
            </p>
            <p>
                Create intakes to capture material availability from suppliers
                and match them to buyer requirements.
            </p>
        </field>
    </record>

    <!-- Intake Menu -->
    <menuitem id="plasticos_intake_menu"
              name="Intake"
              parent="plasticos_root_menu"
              action="plasticos_intake_action"
              sequence="1"/>
</odoo>
