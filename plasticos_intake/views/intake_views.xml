<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════
         Search View (from #16 - enhanced with facility/contact)
         ═══════════════════════════════════════════════════════ -->

    <record id="view_plasticos_intake_search" model="ir.ui.view">
        <field name="name">plasticos.intake.search</field>
        <field name="model">plasticos.intake</field>
        <field name="arch" type="xml">
            <search string="Intake Search">
                <field name="partner_id"/>
                <field name="facility_id"/>
                <field name="contact_id"/>
                <field name="polymer"/>
                <field name="form"/>
                <field name="source_type_id"/>
                <field name="material_profile_id"/>
                <filter name="filter_draft"
                        string="Draft"
                        domain="[('onboarding_status', '=', 'draft')]"/>
                <filter name="filter_profiled"
                        string="Profiled"
                        domain="[('onboarding_status', '=', 'profiled')]"/>
                <filter name="filter_normalized"
                        string="Normalized"
                        domain="[('onboarding_status', '=', 'normalized')]"/>
                <filter name="filter_ready"
                        string="Ready"
                        domain="[('onboarding_status', '=', 'ready')]"/>
                <filter name="filter_matched"
                        string="Matched"
                        domain="[('match_status', '=', 'matched')]"/>
                <filter name="filter_pending"
                        string="Pending Match"
                        domain="[('match_status', '=', 'pending')]"/>
                <filter name="group_partner"
                        string="Company"
                        context="{'group_by': 'partner_id'}"/>
                <filter name="group_facility"
                        string="Facility"
                        context="{'group_by': 'facility_id'}"/>
                <filter name="group_polymer"
                        string="Polymer"
                        context="{'group_by': 'polymer'}"/>
                <filter name="group_onboarding"
                        string="Onboarding Status"
                        context="{'group_by': 'onboarding_status'}"/>
                <filter name="group_deal_type"
                        string="Deal Type"
                        context="{'group_by': 'deal_type'}"/>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         List View
         ═══════════════════════════════════════════════════════ -->

    <record id="view_plasticos_intake_tree" model="ir.ui.view">
        <field name="name">plasticos.intake.tree</field>
        <field name="model">plasticos.intake</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="facility_id" optional="show"/>
                <field name="contact_id" optional="hide"/>
                <field name="polymer"/>
                <field name="form"/>
                <field name="source_type_id" optional="show"/>
                <field name="quantity_per_load_lbs"/>
                <field name="loads_per_month" optional="show"/>
                <field name="deal_type"/>
                <field name="onboarding_status"
                       decoration-info="onboarding_status == 'draft'"
                       decoration-warning="onboarding_status == 'profiled'"
                       decoration-success="onboarding_status in ('normalized', 'ready')"
                       widget="badge"/>
                <field name="match_status"
                       decoration-info="match_status == 'pending'"
                       decoration-success="match_status in ('normalized', 'matched')"
                       decoration-danger="match_status in ('rejected', 'error')"
                       widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         Form View (merged: #14 tab order + #16 contact fields)
         ═══════════════════════════════════════════════════════ -->

    <record id="view_plasticos_intake_form" model="ir.ui.view">
        <field name="name">plasticos.intake.form</field>
        <field name="model">plasticos.intake</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_mark_normalized"
                        type="object"
                        string="Mark Normalized"
                        class="btn-primary"
                        invisible="normalized"
                    />
                    <button
                        name="action_mark_ready"
                        type="object"
                        string="Mark Ready"
                        class="btn-primary"
                        invisible="onboarding_status != 'normalized'"
                    />
                    <button
                        name="action_run_buyer_match"
                        type="object"
                        string="Run Buyer Match"
                        class="btn-success"
                        invisible="onboarding_status != 'ready'"
                    />
                    <field name="onboarding_status" widget="statusbar"
                           statusbar_visible="draft,profiled,normalized,ready"/>
                </header>
                <sheet>
                    <!-- Identity + Contact Header -->
                    <group>
                        <group string="Company &amp; Facility">
                            <field name="partner_id"/>
                            <field name="facility_id"/>
                            <field name="material_profile_id"/>
                        </group>
                        <group string="Contact Person">
                            <field name="contact_id"/>
                            <field name="contact_phone"/>
                            <field name="contact_email" widget="email"/>
                        </group>
                    </group>

                    <!-- Material Section (main page, not in tab) -->
                    <group>
                        <group string="Material">
                            <field name="polymer"/>
                            <field name="form"/>
                            <field name="color"/>
                            <field name="source_type_id"/>
                            <field name="grade_hint"/>
                            <field name="packaging_type"/>
                        </group>
                        <group string="Volume &amp; Frequency">
                            <field name="quantity_per_load_lbs"/>
                            <field name="loads_per_month"/>
                            <field name="deal_type"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Tab 1: Origin -->
                        <page string="Origin">
                            <group>
                                <group string="Application">
                                    <field name="origin_application"/>
                                    <field name="origin_sector"/>
                                    <field name="origin_process_type"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 3: Quality -->
                        <page string="Quality">
                            <group>
                                <group string="Observed Quality">
                                    <field name="mfi_value"/>
                                    <field name="density_value"/>
                                    <field name="moisture_pct"/>
                                    <field name="contamination_pct"/>
                                </group>
                                <group string="Contaminants">
                                    <field name="has_metal"/>
                                    <field name="has_fr"/>
                                    <field name="has_residue"/>
                                    <field name="filler_type"/>
                                    <field name="filler_pct"/>
                                </group>
                            </group>
                            <group string="Notes">
                                <field name="contamination_notes"/>
                            </group>
                        </page>

                        <!-- Tab 4: Facility Info (from #16) -->
                        <page string="Facility Info">
                            <group>
                                <group string="Facility Address">
                                    <field name="facility_phone"/>
                                    <field name="facility_street"/>
                                    <field name="facility_city"/>
                                    <field name="facility_state"/>
                                </group>
                                <group string="Coordinates">
                                    <field name="lat"/>
                                    <field name="lon"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 5: Matching -->
                        <page string="Matching">
                            <group>
                                <group string="Status">
                                    <field name="match_status"/>
                                    <field name="normalized"/>
                                </group>
                                <group string="Packet">
                                    <field name="last_packet_id" readonly="1"/>
                                    <field name="last_packet_version" readonly="1"/>
                                    <field name="last_packet_ts" readonly="1"/>
                                </group>
                            </group>
                            <group string="Match Response">
                                <field name="match_response" readonly="1"/>
                            </group>
                            <group string="Last Packet Payload">
                                <field name="last_packet_payload" readonly="1"/>
                            </group>
                        </page>

                        <!-- Tab 6: Debug (admin-only per #14) -->
                        <page string="Debug"
                              groups="base.group_system">
                            <group string="JSON Payloads">
                                <field name="match_response"/>
                                <field name="last_packet_payload"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         Root App Menu
         ═══════════════════════════════════════════════════════ -->

    <menuitem id="plasticos_root_menu"
              name="PlasticOS"
              sequence="5"/>

    <!-- Intake Action -->
    <record id="plasticos_intake_action" model="ir.actions.act_window">
        <field name="name">Material Intake</field>
        <field name="res_model">plasticos.intake</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_plasticos_intake_search"/>
    </record>

    <!-- Intake Menu -->
    <menuitem id="plasticos_intake_menu"
              name="Intake"
              parent="plasticos_root_menu"
              action="plasticos_intake_action"
              sequence="1"/>
</odoo>
