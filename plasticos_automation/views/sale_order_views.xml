<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sale_order_form_logistics" model="ir.ui.view">
        <field name="name">sale.order.form.logistics.automation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Logistics Automation" name="logistics_automation">
                    <group>
                        <field name="delivery_term"/>
                    </group>
                    <group>
                        <field name="appointment_requested"/>
                        <field name="appointment_requested_on" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
