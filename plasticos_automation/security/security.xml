<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- Odoo 19: Category → Privilege → Group -->
        <record id="module_category_automation" model="ir.module.category">
            <field name="name">Automation</field>
            <field name="sequence">210</field>
        </record>

        <record id="privilege_automation" model="res.groups.privilege">
            <field name="name">Automation</field>
            <field name="category_id" ref="module_category_automation"/>
        </record>

        <record id="group_plasticos_automation_manager" model="res.groups">
            <field name="name">PlasticOS Automation Manager</field>
            <field name="privilege_id" ref="privilege_automation"/>
            <field name="comment">
                Full access to automation configuration, logs, and logistics automation.
                Assign to operations managers who control automation thresholds.
            </field>
        </record>

        <record id="group_logistics_automation_manager" model="res.groups">
            <field name="name">PlasticOS Logistics Automation Manager</field>
            <field name="privilege_id" ref="privilege_automation"/>
            <field name="comment">
                Manages logistics automation settings and reviews escalation logs.
            </field>
        </record>

        <!-- Do not patch base.group_system in XML: Odoo 19 / Odoo.sh can surface
             Access denied when Apps loads or installs modules that alter Settings
             group from declarative data. Merge is done in post_init_hook (sudo). -->
    </data>
</odoo>
