      "class_": "CODE_READ",
      "observed": "One SDK Gate EIE egress for enrich and graph-inference-result with idempotency keys; response header failure checked; no direct peer transport. Enrichment key excludes explicit input/source revision."
    },
    {
      "id": "E08",
      "repository": "Quantum-L9/Cognitive.Engine.Graphs",
      "revision": "0d84ec8531baf604383c5ddc012f40aa84fc4b76",
