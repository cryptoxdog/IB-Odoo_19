      "id": "E01",
      "repository": "Quantum-L9/Cognitive.Engine.Graphs",
      "revision": "0d84ec8531baf604383c5ddc012f40aa84fc4b76",
      "path": "engine/config/settings.py",
      "git_blob_sha": "119c8a16cfd436bd49e2b064bfba97defe0de3fb",
      "url": "https://github.com/Quantum-L9/Cognitive.Engine.Graphs/blob/0d84ec8531baf604383c5ddc012f40aa84fc4b76/engine/config/settings.py",
      "class_": "CODE_READ",
      "observed": "health_api_enabled, auto_enrich_via_gate and graph_inference_feedback_enabled default False. health_commercial_mode_enabled also False; batch limits 100 entities/$10 while nightly scanner elsewhere defaults $50."
    },
    {
      "id": "E02",
      "repository": "Quantum-L9/Cognitive.Engine.Graphs",
      "revision": "0d84ec8531baf604383c5ddc012f40aa84fc4b76",
      "path": "engine/health/nightly_health_scan.py",
      "git_blob_sha": "b0658bc2966b8ab7ea190260f8ae9c4246d462bf",
      "url": "https://github.com/Quantum-L9/Cognitive.Engine.Graphs/blob/0d84ec8531baf604383c5ddc012f40aa84fc4b76/engine/health/nightly_health_scan.py",
      "class_": "CODE_READ",
      "observed": "run_nightly_health_scan builds ROI-ranked queue; without injected entity_loader returns []; no dispatch call; process-global scanned_this_run set; MAX_QUEUE=100 and default $50 estimate ceiling."
    },
    {
      "id": "E03",
      "repository": "Quantum-L9/Cognitive.Engine.Graphs",
      "revision": "0d84ec8531baf604383c5ddc012f40aa84fc4b76",
      "path": "engine/health/enrichment_trigger.py",
      "git_blob_sha": "95c70a4c9d2a6f2c5000e5dea79c607c17c335f0",
      "url": "https://github.com/Quantum-L9/Cognitive.Engine.Graphs/blob/0d84ec8531baf604383c5ddc012f40aa84fc4b76/engine/health/enrichment_trigger.py",
      "class_": "CODE_READ",
      "observed": "trigger_reenrichment_v2 can use Gate request_enrichment with flag true; heuristic ROI assumes filling gaps and chooses average deal value from domain description or default $1000; financial ROI is estimate not proven observed value."
    },
    {
      "id": "E04",
      "repository": "Quantum-L9/Cognitive.Engine.Graphs",
      "revision": "0d84ec8531baf604383c5ddc012f40aa84fc4b76",
      "path": "engine/health/api.py",
      "git_blob_sha": "b11f76e18b7930cb5aeb9e9c9c1982b0a8a55812",
      "url": "https://github.com/Quantum-L9/Cognitive.Engine.Graphs/blob/0d84ec8531baf604383c5ddc012f40aa84fc4b76/engine/health/api.py",
      "class_": "CODE_READ",
      "observed": "handle_health_assess automatically triggers Gate dispatch on enrich_now recommendation when allowed and flag on; handle_health_batch_assess only calculates estimates, reports dispatched=0, and scans caller-supplied list."
    },
    {
      "id": "E05",
      "repository": "Quantum-L9/Cognitive.Engine.Graphs",
      "revision": "0d84ec8531baf604383c5ddc012f40aa84fc4b76",
      "path": "engine/handlers.py",
      "git_blob_sha": "9d05bc24b13bf2ffa22955d20e6714c02acda8d4",
      "url": "https://github.com/Quantum-L9/Cognitive.Engine.Graphs/blob/0d84ec8531baf604383c5ddc012f40aa84fc4b76/engine/handlers.py",
      "class_": "CODE_READ",
      "observed": "health-assess is canonical three-subaction handler; emit_inference_feedback exists only as admin subaction, not accessible via health-assess route. Domain id can be caller-provided in admin payload; verify tenant binding."
    },
    {
      "id": "E06",
      "repository": "Quantum-L9/Cognitive.Engine.Graphs",
      "revision": "0d84ec8531baf604383c5ddc012f40aa84fc4b76",
      "path": "engine/spec.yaml",
      "git_blob_sha": "b1aeedd9c67917d3c4e6cc8dfad4d6013bd985c6",
      "url": "https://github.com/Quantum-L9/Cognitive.Engine.Graphs/blob/0d84ec8531baf604383c5ddc012f40aa84fc4b76/engine/spec.yaml",
      "class_": "CODE_READ",
      "observed": "CEG advertises health-assess along with match/sync/outcomes/resolve. It does not advertise admin or enrich."
    },
    {
      "id": "E07",
      "repository": "Quantum-L9/Cognitive.Engine.Graphs",
      "revision": "0d84ec8531baf604383c5ddc012f40aa84fc4b76",
