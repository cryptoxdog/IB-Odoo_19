      "class_": "CODE_READ",
      "observed": "Guard pins health-assess advertised, no admin/enrich via Gate and SDK-only peer egress. Existing static Gate registry proof is in Gate repo."
    },
    {
      "id": "E10",
      "repository": "Quantum-L9/Cognitive.Engine.Graphs",
