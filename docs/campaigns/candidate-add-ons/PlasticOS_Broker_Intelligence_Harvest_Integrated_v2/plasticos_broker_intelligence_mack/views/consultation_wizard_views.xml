<odoo>
  <record id="view_mack_broker_wizard" model="ir.ui.view">
    <field name="name">plasticos.broker.consultation.wizard.form</field>
    <field name="model">plasticos.broker.consultation.wizard</field>
    <field name="arch" type="xml"><form string="Mack: Broker Advice">
      <group><field name="source_model" readonly="1"/><field name="source_id" readonly="1"/>
        <field name="question"/><field name="source_message_id"/>
        <field name="consultation_id" readonly="1"/><field name="response" readonly="1" widget="text"/></group>
      <footer><button name="action_consult" type="object" string="Consult Mack" class="btn-primary"/>
        <button string="Close" special="cancel"/></footer>
    </form></field>
  </record>
</odoo>
