<odoo>
  <record id="view_broker_consultation_list" model="ir.ui.view">
    <field name="name">plasticos.broker.consultation.list</field>
    <field name="model">plasticos.broker.consultation</field>
    <field name="arch" type="xml"><list string="Mack Consultation Receipts" create="0" edit="0" delete="0">
      <field name="create_date"/><field name="source_model"/><field name="source_id"/>
      <field name="source_revision"/><field name="actor_id"/><field name="company_id"/>
    </list></field>
  </record>
  <record id="view_broker_consultation_form" model="ir.ui.view">
    <field name="name">plasticos.broker.consultation.form</field>
    <field name="model">plasticos.broker.consultation</field>
    <field name="arch" type="xml"><form string="Mack Consultation Evidence" create="0" edit="0" delete="0"><sheet>
      <group><field name="source_model"/><field name="source_id"/><field name="source_revision"/>
        <field name="source_message_id"/><field name="question"/><field name="response_snapshot"/>
        <field name="request_key"/><field name="actor_id"/><field name="company_id"/></group>
    </sheet></form></field>
  </record>
  <record id="action_broker_consultations" model="ir.actions.act_window">
    <field name="name">My Mack Consultations</field>
    <field name="res_model">plasticos.broker.consultation</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_broker_consultations" parent="plasticos_broker_intelligence.menu_broker_root"
            name="My Mack Advice" action="action_broker_consultations" sequence="30"/>
</odoo>
