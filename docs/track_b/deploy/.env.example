# Box: EIE-CEG-GATE  — copy to .env and fill. NEVER commit the real .env.
# Secrets (SEAM_HMAC_SECRET, GATE_ADMIN_TOKEN, LLM keys) resolve from Infisical
# (l9-aws-secrets) at provision time; datastore passwords are generated on-box.

# Public hostname Caddy serves (Cloudflare A record -> box IP)
GATE_HOST=gate.quantumaipartners.com

# Shared HMAC secret — signs/verifies every Gate<->CEG<->EIE<->Odoo packet.
# key ids: gate-v1, graph-engine-v1, enrichment-engine-v1, odoo-v1
SEAM_HMAC_SECRET=

# Gate admin token — CEG/EIE use it to self-register at boot
GATE_ADMIN_TOKEN=

# Datastore passwords (generate on-box, e.g. openssl rand -hex 24)
NEO4J_PASSWORD=
POSTGRES_PASSWORD=

# CEG API key + EIE API key hash
CEG_API_KEY=
EIE_API_KEY_HASH=

# EIE enrichment LLM providers (from Infisical)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
