<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_partner_hierarchy" model="ir.ui.view">
        <field name="name">res.partner.screen.hierarchy</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <hierarchy child_field="child_ids" draggable="0">
                <field name="name"/>
                <field name="function"/>
                <templates>
                    <t t-name="hierarchy-box">
                        <div class="o_hierarchy_node_header d-flex justify-content-center align-items-center">
                            <field name="name"/>
                        </div>
                        <div class="o_hierarchy_node_body">
                            <field name="function"/>
                        </div>
                    </t>
                </templates>
            </hierarchy>
        </field>
    </record>

    <record id="contacts.action_contacts" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form,activity,map,hierarchy</field>
    </record>

    <record id="action_contacts_view_hierarchy" model="ir.actions.act_window.view">
        <field name="sequence" eval="11"/>
        <field name="view_mode">hierarchy</field>
        <field name="view_id" ref="view_res_partner_hierarchy"/>
        <field name="act_window_id" ref="contacts.action_contacts"/>
    </record>

</odoo>
