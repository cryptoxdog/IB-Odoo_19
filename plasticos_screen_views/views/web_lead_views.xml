<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_web_lead_calendar" model="ir.ui.view">
        <field name="name">plasticos.web.lead.screen.calendar</field>
        <field name="model">plasticos.web.lead</field>
        <field name="arch" type="xml">
            <calendar string="Web Leads" date_start="submitted_at" mode="month">
                <field name="company_name"/>
                <field name="decision"/>
            </calendar>
        </field>
    </record>

    <record id="view_web_lead_pivot" model="ir.ui.view">
        <field name="name">plasticos.web.lead.screen.pivot</field>
        <field name="model">plasticos.web.lead</field>
        <field name="arch" type="xml">
            <pivot string="Web Leads">
                <field name="decision" type="row"/>
                <field name="state" type="row"/>
                <field name="lead_source_id" type="col"/>
                <field name="estimated_lbs_per_load" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_web_lead_graph" model="ir.ui.view">
        <field name="name">plasticos.web.lead.screen.graph</field>
        <field name="model">plasticos.web.lead</field>
        <field name="arch" type="xml">
            <graph string="Web Leads" type="bar">
                <field name="decision"/>
                <field name="state"/>
                <field name="lead_source_id"/>
                <field name="estimated_lbs_per_load" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="plasticos_web_leads.action_web_lead" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form,calendar,pivot,graph,map,activity</field>
        <field name="mobile_view_mode">list</field>
    </record>

    <record id="action_web_lead_view_calendar" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="view_web_lead_calendar"/>
        <field name="act_window_id" ref="plasticos_web_leads.action_web_lead"/>
    </record>

    <record id="action_web_lead_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="11"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_web_lead_pivot"/>
        <field name="act_window_id" ref="plasticos_web_leads.action_web_lead"/>
    </record>

    <record id="action_web_lead_view_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="12"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_web_lead_graph"/>
        <field name="act_window_id" ref="plasticos_web_leads.action_web_lead"/>
    </record>

</odoo>
