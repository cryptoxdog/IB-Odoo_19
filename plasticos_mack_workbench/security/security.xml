<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_mack_workbench" model="ir.module.category">
            <field name="name">Mack Workbench</field>
            <field name="sequence">220</field>
        </record>

        <record id="privilege_mack_workbench" model="res.groups.privilege">
            <field name="name">Mack Workbench</field>
            <field name="category_id" ref="module_category_mack_workbench"/>
        </record>

        <record id="group_mack_workbench_operator" model="res.groups">
            <field name="name">Mack Workbench Operator</field>
            <field name="privilege_id" ref="privilege_mack_workbench"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">May record and read governed Mack chat intent and internal review receipts.</field>
        </record>

        <record id="group_mack_workbench_manager" model="res.groups">
            <field name="name">Mack Workbench Manager</field>
            <field name="privilege_id" ref="privilege_mack_workbench"/>
            <field name="implied_ids" eval="[(4, ref('plasticos_mack_workbench.group_mack_workbench_operator'))]"/>
            <field name="comment">May read governed Mack review audit records across authorized companies.</field>
        </record>
    </data>
</odoo>
