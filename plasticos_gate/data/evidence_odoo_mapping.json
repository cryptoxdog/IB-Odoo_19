{
  "contract_version": "1.0.0-draft",
  "domain": "plasticos",
  "owner": "eie",
  "description": "Consumer copy of EIE FeatureEvidence→Odoo mapping (TASK-053). Honor merge-not-overwrite and review mode; proposal_only only.",
  "policy": {
    "merge_strategy": "merge_not_overwrite",
    "review_mode": "always",
    "default_write_mode": "proposal_only",
    "human_review_precedence": true
  },
  "projections": [
    {
      "feature_id": "facility.capacity.available_lbs_month",
      "odoo_model": "res.partner",
      "odoo_field": "x_available_lbs_month",
      "unit": "lb/month",
      "write_mode": "proposal_only",
      "value_kinds": ["number"]
    },
    {
      "feature_id": "material.contamination_pct",
      "odoo_model": "res.partner",
      "odoo_field": "x_contamination_pct",
      "unit": "percent",
      "write_mode": "proposal_only",
      "value_kinds": ["number"]
    },
    {
      "feature_id": "facility.food_grade_certified",
      "odoo_model": "res.partner",
      "odoo_field": "x_food_grade_certified",
      "unit": null,
      "write_mode": "proposal_only",
      "value_kinds": ["boolean"]
    },
    {
      "feature_id": "material.polymer_type",
      "odoo_model": "res.partner",
      "odoo_field": "x_polymer_type",
      "unit": null,
      "write_mode": "proposal_only",
      "value_kinds": ["string"]
    },
    {
      "feature_id": "material.mfi",
      "odoo_model": "res.partner",
      "odoo_field": "x_melt_flow_index",
      "unit": "g/10min",
      "write_mode": "proposal_only",
      "value_kinds": ["number"]
    }
  ],
  "rules": [
    "never treat stale FeatureEvidence as current without explicit policy",
    "inferred evidence must carry rule_or_model_version before proposal",
    "late EIE evidence cannot overwrite newer or human-approved Odoo state",
    "projection does not authorize direct Odoo mutation from EIE",
    "auto-apply / approved_write modes are forbidden in this contract version"
  ]
}
