<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Odoo 19 stores a folder as documents.document with type "folder".
             Parent is folder_id, another documents.document. -->

        <record id="folder_plasticos_root" model="documents.document">
            <field name="type">folder</field>
            <field name="access_internal">edit</field>
            <field name="name">Plasticos</field>
            <field name="sequence">10</field>
        </record>

        <record id="folder_plasticos_inbox" model="documents.document">
            <field name="type">folder</field>
            <field name="access_internal">edit</field>
            <field name="name">Inbox</field>
            <field name="folder_id" ref="folder_plasticos_root"/>
            <field name="sequence">1</field>
        </record>

        <record id="folder_plasticos_bols" model="documents.document">
            <field name="type">folder</field>
            <field name="access_internal">edit</field>
            <field name="name">Bills of Lading</field>
            <field name="folder_id" ref="folder_plasticos_root"/>
            <field name="sequence">2</field>
        </record>

        <record id="folder_plasticos_vendor_bills" model="documents.document">
            <field name="type">folder</field>
            <field name="access_internal">edit</field>
            <field name="name">Vendor Bills</field>
            <field name="folder_id" ref="folder_plasticos_root"/>
            <field name="sequence">3</field>
        </record>

        <record id="folder_plasticos_scale_tickets" model="documents.document">
            <field name="type">folder</field>
            <field name="access_internal">edit</field>
            <field name="name">Scale Tickets</field>
            <field name="folder_id" ref="folder_plasticos_root"/>
            <field name="sequence">4</field>
        </record>

        <record id="folder_plasticos_loading_pics" model="documents.document">
            <field name="type">folder</field>
            <field name="access_internal">edit</field>
            <field name="name">Loading Pics</field>
            <field name="folder_id" ref="folder_plasticos_root"/>
            <field name="sequence">5</field>
        </record>

        <record id="folder_plasticos_customer_orders" model="documents.document">
            <field name="type">folder</field>
            <field name="access_internal">edit</field>
            <field name="name">Customer Orders</field>
            <field name="folder_id" ref="folder_plasticos_root"/>
            <field name="sequence">6</field>
        </record>

        <record id="folder_plasticos_compliance" model="documents.document">
            <field name="type">folder</field>
            <field name="access_internal">edit</field>
            <field name="name">Compliance</field>
            <field name="folder_id" ref="folder_plasticos_root"/>
            <field name="sequence">7</field>
        </record>

    </data>
</odoo>
