<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The total printed on the vendor's document. Digitization records it;
         an Operations Manager corrects it. The posting guard compares it with
         the lines and tax of a digitized or emailed vendor bill. -->
    <record id="view_move_form_plasticos_document_total" model="ir.ui.view">
        <field name="name">account.move.form.plasticos.document.total</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="plasticos_document_total"
                       invisible="move_type not in ('in_invoice', 'in_refund')"
                       readonly="state != 'draft'"
                       groups="plasticos_security_base.group_operations_manager,base.group_system"/>
            </xpath>
        </field>
    </record>

</odoo>
