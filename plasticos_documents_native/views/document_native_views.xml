<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Odoo 19 Documents has no document form. This primary form
         holds the plastics fields. Rename and upload keep their own
         form_view_ref, and the Documents action stays kanban/list.
         ============================================================ -->

    <record id="view_document_form_plasticos" model="ir.ui.view">
        <field name="name">documents.document.form.plasticos</field>
        <field name="model">documents.document</field>
        <field name="priority">64</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_associate_from_form" type="object" string="Associate"
                            groups="plasticos_documents.group_documents_user"/>
                    <button name="action_verify" type="object" string="Verify"
                            invisible="verified"
                            groups="plasticos_documents.group_documents_user"/>
                    <button name="action_override" type="object" string="Override"
                            invisible="override"
                            groups="plasticos_documents.group_documents_manager"/>
                </header>
                <sheet>
                <div class="alert alert-warning" role="alert" invisible="not verification_review_required">
                    Historical native verification disagrees with the business record and stays in review.
                </div>
                <div class="alert alert-info" role="alert" invisible="not transaction_id and not load_id">
                    Transaction, load, and contact are navigation only. Associate accepts an exact record.
                </div>
                <group string="Exact Association">
                    <group>
                        <field name="association_subject_model"/>
                        <field name="association_subject_id"/>
                        <field name="association_source_reference"/>
                        <field name="association_covered_quantity"/>
                    </group>
                </group>
                <group string="Plasticos Classification">
                    <group>
                        <field name="doc_type"/>
                        <field name="polymer_id"/>
                    </group>
                    <group>
                        <field name="transaction_id"/>
                        <field name="load_id"/>
                        <field name="intake_id"/>
                    </group>
                </group>
                <group string="Verification">
                    <group>
                        <field name="verified" readonly="1"/>
                        <field name="verified_by" readonly="1"
                               invisible="not verified"/>
                        <field name="verified_at" readonly="1"
                               invisible="not verified"/>
                        <field name="verification_review_required" readonly="1"/>
                    </group>
                    <group>
                        <field name="override_reason_draft" invisible="override"/>
                        <field name="override" readonly="1"/>
                        <field name="override_reason" readonly="1"
                               invisible="not override"/>
                    </group>
                </group>
                <group string="Legacy Sync" invisible="not plasticos_doc_id">
                    <field name="plasticos_doc_id" readonly="1"/>
                </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
         Extend the native documents.document list/kanban with
         key plastics columns.
         ============================================================ -->

    <record id="view_document_list_plasticos" model="ir.ui.view">
        <field name="name">documents.document.list.plasticos</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.documents_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="doc_type" optional="show"/>
                <field name="polymer_id" optional="show"/>
                <field name="transaction_id" optional="hide"/>
                <field name="verified" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         Search filter extensions: filter by doc type, polymer,
         verified status.
         ============================================================ -->

    <record id="view_document_search_plasticos" model="ir.ui.view">
        <field name="name">documents.document.search.plasticos</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.document_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//searchpanel" position="before">
                <separator/>
                <filter name="filter_bol"
                        string="BOLs"
                        domain="[('doc_type', '=', 'bol')]"/>
                <filter name="filter_invoice"
                        string="Invoices"
                        domain="[('doc_type', '=', 'invoice')]"/>
                <filter name="filter_scale_ticket"
                        string="Scale Tickets"
                        domain="[('doc_type', '=', 'scale_ticket')]"/>
                <filter name="filter_contract"
                        string="Contracts"
                        domain="[('doc_type', '=', 'contract')]"/>
                <separator/>
                <filter name="filter_verified"
                        string="Verified"
                        domain="[('verified', '=', True)]"/>
                <filter name="filter_unverified"
                        string="Not Verified"
                        domain="[('verified', '=', False)]"/>
            </xpath>
            <xpath expr="//search/group" position="inside">
                <filter name="group_doc_type"
                        string="Document Type"
                        context="{'group_by': 'doc_type'}"/>
                <filter name="group_polymer"
                        string="Polymer"
                        context="{'group_by': 'polymer_id'}"/>
                <filter name="group_transaction"
                        string="Transaction"
                        context="{'group_by': 'transaction_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
