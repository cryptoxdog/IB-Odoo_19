<?xml version='1.0' encoding='utf-8'?>
<odoo noupdate="1">
    <!--
    Nightly Graph Sync Cron
    Full topology sync: taxonomy nodes, facility/material edges,
    SOLD_TO transaction edges, EXCLUDED_FROM lifecycle edges.
    Runs at 02:00 daily to minimize contention with business hours.
    -->
    <record id="ir_cron_nightly_graph_sync" model="ir.cron">
        <field name="name">PlasticOS: Nightly Neo4j Graph Topology Sync</field>
        <field name="model_id" ref="model_plasticos_graph_sync_log" />
        <field name="state">code</field>
        <field name="code">env['plasticos.graph.service']._cron_nightly_graph_sync()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=2, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')" />
        <field name="active">True</field>
        <field name="user_id" ref="plasticos_base.user_system_cron" />
    </record>
</odoo>
