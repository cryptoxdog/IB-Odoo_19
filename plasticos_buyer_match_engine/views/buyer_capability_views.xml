<odoo>

    <!-- ═══ List View ═══ -->
    <record id="view_buyer_capability_tree" model="ir.ui.view">
        <field name="name">plasticos.buyer.capability.tree</field>
        <field name="model">plasticos.buyer.capability</field>
        <field name="arch" type="xml">
            <list>
                <field name="facility_id"/>
                <field name="source_type_id"/>
                <field name="polymer_id"/>
                <field name="form_id"/>
                <field name="process_type" optional="show"/>
                <field name="max_contamination_pct" optional="show"/>
                <field name="max_moisture_pct" optional="show"/>
                <field name="radius_miles" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ═══ Form View ═══ -->
    <record id="view_buyer_capability_form" model="ir.ui.view">
        <field name="name">plasticos.buyer.capability.form</field>
        <field name="model">plasticos.buyer.capability</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="facility_id" placeholder="Select Buyer Facility..."/></h1>
                    </div>

                    <group>
                        <group string="Material Identity">
                            <field name="source_type_id"/>
                            <field name="polymer_id"/>
                            <field name="form_id"/>
                            <field name="process_type"/>
                        </group>
                        <group string="Quality Gates">
                            <field name="max_contamination_pct"/>
                            <field name="max_moisture_pct"/>
                        </group>
                    </group>

                    <group>
                        <group string="Commercial Gates">
                            <field name="min_volume_lbs"/>
                            <field name="max_volume_lbs"/>
                        </group>
                        <group string="Compliance Gates">
                            <field name="requires_food_grade"/>
                            <field name="requires_medical_grade"/>
                        </group>
                    </group>

                    <group>
                        <group string="Geo Gate">
                            <field name="radius_miles"/>
                        </group>
                        <group string="Status">
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══ Search View ═══ -->
    <record id="view_buyer_capability_search" model="ir.ui.view">
        <field name="name">plasticos.buyer.capability.search</field>
        <field name="model">plasticos.buyer.capability</field>
        <field name="arch" type="xml">
            <search>
                <field name="facility_id"/>
                <field name="polymer_id"/>
                <field name="form_id"/>
                <field name="source_type_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="inactive" string="Archived" domain="[('active','=',False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_polymer" string="Polymer" context="{'group_by': 'polymer_id'}"/>
                    <filter name="group_form" string="Form" context="{'group_by': 'form_id'}"/>
                    <filter name="group_facility" string="Facility" context="{'group_by': 'facility_id'}"/>
                    <filter name="group_source" string="Source Type" context="{'group_by': 'source_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══ Action ═══ -->
    <record id="action_buyer_capability" model="ir.actions.act_window">
        <field name="name">Buyer Capabilities</field>
        <field name="res_model">plasticos.buyer.capability</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_buyer_capability_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define buyer capability lanes
            </p>
            <p>
                Each lane specifies what material a buyer facility can accept:
                polymer, form, source type, quality limits, volume range, and max distance.
            </p>
        </field>
    </record>

    <!-- ═══ Menu ═══ -->
    <menuitem
        id="menu_buyer_capability"
        name="Buyer Capabilities"
        action="action_buyer_capability"
        parent="plasticos_matching.menu_matching_root"
        sequence="20"/>

</odoo>
