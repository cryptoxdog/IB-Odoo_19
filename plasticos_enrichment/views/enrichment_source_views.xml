<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_enrichment_source_tree" model="ir.ui.view">
        <field name="name">plasticos.enrichment.source.tree</field>
        <field name="model">plasticos.enrichment.source</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="partner_id"/>
                <field name="url" widget="url"/>
                <field name="source_type"/>
                <field name="crawl_status" widget="badge"
                       decoration-success="crawl_status == 'success'"
                       decoration-danger="crawl_status == 'failed'"/>
                <field name="last_crawled_at"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_enrichment_source" model="ir.actions.act_window">
        <field name="name">Enrichment Sources</field>
        <field name="res_model">plasticos.enrichment.source</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_enrichment_sources"
              name="Sources"
              parent="menu_enrichment_root"
              action="action_enrichment_source"
              sequence="20"/>
</odoo>
