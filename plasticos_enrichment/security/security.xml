<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!-- Odoo 19: res.groups uses privilege_id, not category_id -->
    <record id="module_category_enrichment" model="ir.module.category">
        <field name="name">Enrichment</field>
        <field name="sequence">55</field>
    </record>

    <record id="privilege_enrichment" model="res.groups.privilege">
        <field name="name">Enrichment</field>
        <field name="category_id" ref="module_category_enrichment"/>
    </record>

    <record id="group_enrichment_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_enrichment"/>
    </record>

    <record id="group_enrichment_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_enrichment"/>
        <field name="implied_ids" eval="[(4, ref('group_enrichment_user'))]"/>
    </record>
</odoo>
