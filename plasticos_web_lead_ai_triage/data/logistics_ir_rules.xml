<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Security Group: Logistics Team                     -->
    <!-- Members of this group can only see partners that   -->
    <!-- have at least one confirmed purchase order.        -->
    <!-- This prevents logistics from seeing raw web leads. -->
    <!-- ═══════════════════════════════════════════════════ -->
    <record id="group_logistics_team" model="res.groups">
      <field name="name">Logistics Team</field>
      <field name="comment">
        Members see only suppliers with confirmed purchase orders.
        Raw web leads and unqualified contacts are hidden.
      </field>
      <field name="category_id" ref="base.module_category_operations"/>
    </record>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ir.rule: Logistics can only see partners with      -->
    <!-- confirmed POs (purchase.order in state 'purchase') -->
    <!-- ═══════════════════════════════════════════════════ -->
    <record id="rule_logistics_partner_confirmed_po" model="ir.rule">
      <field name="name">Logistics: only partners with confirmed POs</field>
      <field name="model_id" ref="base.model_res_partner"/>
      <field name="domain_force">[
        '|',
        ('is_company', '=', False),
        ('purchase_order_count', '>', 0)
      ]</field>
      <field name="groups" eval="[(4, ref('group_logistics_team'))]"/>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ir.rule: Logistics cannot see web leads at all     -->
    <!-- ═══════════════════════════════════════════════════ -->
    <record id="rule_logistics_no_web_leads" model="ir.rule">
      <field name="name">Logistics: no access to web leads</field>
      <field name="model_id" ref="plasticos_web_leads.model_plasticos_web_lead"/>
      <field name="domain_force">[(0, '=', 1)]</field>
      <field name="groups" eval="[(4, ref('group_logistics_team'))]"/>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="True"/>
    </record>
  </data>
</odoo>
