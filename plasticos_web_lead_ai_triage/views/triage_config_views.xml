<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- ═══════════════════════════════════════════════════════ -->
  <!-- Triage Configuration Form                              -->
  <!-- ═══════════════════════════════════════════════════════ -->
  <record id="view_triage_config_form" model="ir.ui.view">
    <field name="name">plasticos.triage.config.form</field>
    <field name="model">plasticos.triage.config</field>
    <field name="arch" type="xml">
      <form string="AI Triage Configuration">
        <sheet>
          <group string="OpenAI Credentials">
            <field name="openai_api_key" password="True"/>
            <field name="openai_model"/>
            <field name="openai_vision_model"/>
          </group>
          <group string="Classification Thresholds">
            <field name="hot_min_lbs"/>
            <field name="cold_max_lbs"/>
          </group>
          <group string="Automation">
            <field name="auto_create_partner"/>
            <field name="auto_create_intake"/>
            <field name="ai_enabled"/>
            <field name="vision_enabled"/>
          </group>
          <group string="Reject Lists">
            <field name="reject_materials" widget="text"/>
            <field name="reject_sources" widget="text"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action to open the singleton config -->
  <record id="action_triage_config" model="ir.actions.act_window">
    <field name="name">Triage Configuration</field>
    <field name="res_model">plasticos.triage.config</field>
    <field name="view_mode">form</field>
    <field name="target">inline</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>

  <!-- Menu item under Settings -->
  <menuitem
    id="menu_triage_config"
    name="AI Triage Config"
    parent="base.menu_administration"
    action="action_triage_config"
    sequence="90"
  />
</odoo>
