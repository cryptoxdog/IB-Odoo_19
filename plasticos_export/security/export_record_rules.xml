<?xml version="1.0" encoding="utf-8"?>
<!--
    Company isolation for every Export record (RP-07-E048, BRS-EXP-14-R012).
    Global rules: they apply to every read, write, create and unlink path and to
    every report and list row. A user sees only bookings, revisions, slots and
    cargo links of the companies currently allowed to them.
-->
<odoo>
    <record id="rule_export_booking_company" model="ir.rule">
        <field name="name">Export booking: allowed companies</field>
        <field name="model_id" ref="plasticos_export.model_plasticos_export_booking"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_export_revision_company" model="ir.rule">
        <field name="name">Export booking revision: allowed companies</field>
        <field name="model_id" ref="plasticos_export.model_plasticos_export_booking_revision"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_export_slot_company" model="ir.rule">
        <field name="name">Export booking slot: allowed companies</field>
        <field name="model_id" ref="plasticos_export.model_plasticos_export_booking_slot"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_export_cargo_link_company" model="ir.rule">
        <field name="name">Export cargo link: allowed companies</field>
        <field name="model_id" ref="plasticos_export.model_plasticos_export_booking_cargo_link"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!--
        Party isolation for cargo links (PR #479 review, BRS-EXP-14-R012). A cargo
        link names supplier POs, loads and planned quantities. A Sales Rep reads only
        links on sale orders they own; Logistics and Operations Managers read every
        link of their companies. Group rules are OR'ed per user, so a user in both
        roles keeps the operations view; the company rule above still applies to all.
    -->
    <record id="rule_export_cargo_link_operations" model="ir.rule">
        <field name="name">Export cargo link: operations roles see their companies' links</field>
        <field name="model_id" ref="plasticos_export.model_plasticos_export_booking_cargo_link"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('plasticos_security_base.group_logistics')), (4, ref('plasticos_security_base.group_operations_manager'))]"/>
    </record>
    <record id="rule_export_cargo_link_sales_own" model="ir.rule">
        <field name="name">Export cargo link: sales reps see links on their own sale orders</field>
        <field name="model_id" ref="plasticos_export.model_plasticos_export_booking_cargo_link"/>
        <field name="domain_force">[('sale_order_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('plasticos_security_base.group_sales_rep'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
