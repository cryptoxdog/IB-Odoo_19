<?xml version="1.0" encoding="utf-8"?>
<!--
    Read-only shipment attribution (RP-07-E051). BRS-EXP-07-R008, BRS-EXP-13-R005.
    One row per bound container slot. The physical container, its seal, actual
    equipment and its feeder sources belong to Logistics (J1/J2); this view only
    navigates there and writes no physical state.
-->
<odoo>
    <record id="view_export_shipment_list" model="ir.ui.view">
        <field name="name">plasticos.export.booking.slot.shipment.list</field>
        <field name="model">plasticos.export.booking.slot</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="booking_id"/>
                <field name="slot_key"/>
                <field name="equipment_class" string="Booked Equipment"/>
                <field name="journey_equipment_class"/>
                <field name="iso_number"/>
                <field name="seal_number"/>
                <field name="journey_id" groups="plasticos_security_base.group_logistics,plasticos_security_base.group_operations_manager,base.group_system"/>
                <field name="supplier_count"/>
                <field name="allocation_state" widget="badge"/>
                <button name="action_open_journey" type="object" string="Container" icon="fa-truck" title="Open the Logistics container journey" groups="plasticos_security_base.group_logistics,plasticos_security_base.group_operations_manager,base.group_system"/>
            </list>
        </field>
    </record>

    <record id="action_export_shipments" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">plasticos.export.booking.slot</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('journey_binding_state', '=', 'active')]</field>
        <field name="view_id" ref="view_export_shipment_list"/>
        <field name="search_view_id" ref="view_export_slot_search"/>
    </record>
</odoo>
