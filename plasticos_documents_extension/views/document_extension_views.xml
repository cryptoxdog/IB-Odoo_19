<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit the plasticos.document form to add extension fields -->
    <record id="view_document_form_extension" model="ir.ui.view">
        <field name="name">plasticos.document.form.extension</field>
        <field name="model">plasticos.document</field>
        <field name="inherit_id" ref="plasticos_documents.view_document_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Extended Tracking" name="extended_tracking">
                    <group>
                        <field name="x_doc_category"/>
                        <field name="x_transaction_id"/>
                        <field name="x_expiry_date"/>
                        <field name="x_is_expired" readonly="1"/>
                    </group>
                    <group>
                        <field name="x_version" readonly="1"/>
                        <field name="x_is_current" readonly="1"/>
                        <field name="x_superseded_by" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
