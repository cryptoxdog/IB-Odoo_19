<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit the plasticos.transaction form to add missing doc status -->
    <record id="view_transaction_form_docs" model="ir.ui.view">
        <field name="name">plasticos.transaction.form.docs</field>
        <field name="model">plasticos.transaction</field>
        <field name="inherit_id" ref="plasticos_transaction.view_transaction_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Document Compliance" name="document_compliance">
                    <group>
                        <field name="x_missing_doc_status" readonly="1"/>
                        <field name="x_doc_reminder_count" readonly="1"/>
                        <field name="x_last_doc_reminder_date" readonly="1"/>
                    </group>
                    <group>
                        <field name="x_missing_supplier_docs" readonly="1"/>
                        <field name="x_missing_carrier_docs" readonly="1"/>
                        <field name="x_missing_buyer_docs" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
