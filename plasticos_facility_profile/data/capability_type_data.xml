    <field name="sequence">50</field>
    <field name="details_definition" eval="[
      {'name': 'method', 'string': 'Method', 'type': 'selection', 'selection': [['magnet', 'Magnet'], ['eddy_current', 'Eddy current'], ['both', 'Both']]},
    ]"/>
  </record>

  <record id="capability_type_drying" model="plasticos.capability.type">
    <field name="name">Drying</field>
    <field name="code">drying</field>
    <field name="sequence">60</field>
    <field name="details_definition" eval="[]"/>
