<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <!-- ADR-134 section 3. Property names are lowercase letters, digits and underscores.
       A width-by-length opening is two float properties. Yes/no details are booleans. -->

  <record id="capability_type_shredding" model="plasticos.capability.type">
    <field name="name">Shredding</field>
    <field name="code">shredding</field>
    <field name="sequence">10</field>
    <field name="details_definition" eval="[
      {'name': 'shafts', 'string': 'Shafts', 'type': 'selection', 'selection': [['single', 'Single'], ['dual', 'Dual'], ['quad', 'Quad']]},
      {'name': 'hp', 'string': 'HP', 'type': 'integer'},
      {'name': 'feed_opening_w_in', 'string': 'Feed opening width (in)', 'type': 'float'},
      {'name': 'feed_opening_l_in', 'string': 'Feed opening length (in)', 'type': 'float'},
      {'name': 'screen', 'string': 'Screen', 'type': 'boolean'},
      {'name': 'screen_size_in', 'string': 'Screen size (in)', 'type': 'float'},
    ]"/>
  </record>

  <record id="capability_type_grinding" model="plasticos.capability.type">
    <field name="name">Grinding</field>
    <field name="code">grinding</field>
    <field name="sequence">20</field>
    <field name="details_definition" eval="[
      {'name': 'hp', 'string': 'HP', 'type': 'integer'},
      {'name': 'throat_opening_w_in', 'string': 'Throat opening width (in)', 'type': 'float'},
      {'name': 'throat_opening_l_in', 'string': 'Throat opening length (in)', 'type': 'float'},
      {'name': 'screen_size_in', 'string': 'Screen size (in)', 'type': 'float'},
    ]"/>
  </record>

  <record id="capability_type_sink_float" model="plasticos.capability.type">
    <field name="name">Sink-Float</field>
    <field name="code">sink_float</field>
    <field name="sequence">30</field>
    <field name="details_definition" eval="[
      {'name': 'separates', 'string': 'Separates', 'type': 'selection', 'selection': [['polyolefins_from_heavier', 'Polyolefins from heavier plastics'], ['metal', 'Metal'], ['both', 'Both']]},
    ]"/>
  </record>

  <record id="capability_type_washing" model="plasticos.capability.type">
    <field name="name">Washing</field>
    <field name="code">washing</field>
    <field name="sequence">40</field>
    <field name="details_definition" eval="[
      {'name': 'water', 'string': 'Water', 'type': 'selection', 'selection': [['hot', 'Hot'], ['cold', 'Cold']]},
      {'name': 'friction_washer', 'string': 'Friction washer', 'type': 'boolean'},
      {'name': 'dryer', 'string': 'Dryer', 'type': 'boolean'},
    ]"/>
  </record>

