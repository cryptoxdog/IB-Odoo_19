<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         PARTNER FORM UX — Schema v5.0.0
         Adds: entity health banners, stat button, facility tab gate,
               Personal Intel tab.
         Inherits: plasticos_facility_profile.view_partner_form_profile_tab
         ═══════════════════════════════════════════════════════════════ -->

    <record id="partner_form_plasticos_ux" model="ir.ui.view">
        <field name="name">res.partner.form.plasticos.ux</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="plasticos_facility_profile.view_partner_form_profile_tab"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">

            <!-- ── Entity Health Banners ─────────────────────────────────── -->
            <xpath expr="//div[@name='button_box']" position="before">
                <div class="alert alert-danger border-danger border-3 d-flex align-items-center"
                     role="alert"
                     invisible="entity_status != 'blocked'">
                    <i class="fa fa-ban fa-lg me-2" title="Blocked"/>
                    <strong class="fs-5">⛔ BLOCKED</strong>
                    <span class="ms-2">— This entity is suspended from all PlasticOS transactions.</span>
                </div>
                <div class="alert alert-warning d-flex align-items-center"
                     role="alert"
                     invisible="entity_status != 'inactive'">
                    <i class="fa fa-pause-circle fa-lg me-2" title="Inactive"/>
                    <strong>INACTIVE</strong>
                    <span class="ms-2">— Operations paused. No new intakes or loads will be routed here.</span>
                </div>
            </xpath>

            <!-- ── Stat Button ───────────────────────────────────────────── -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_facility_profiles"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-industry"
                        invisible="facility_profile_count == 0">
                    <field name="facility_profile_count"
                           string="Capabilities"
                           widget="statinfo"/>
                </button>
            </xpath>

            <!-- ── Personal Intel — inline field for person contacts ──────── -->
            <xpath expr="//div[hasclass('o_address_format')]" position="after">
                <field name="personal_intel"
                       string="Personal Intel"
                       widget="html"
                       placeholder="Personality, comms style, rapport hooks, motivators..."
                       invisible="company_type != 'person'"
                       help="Internal broker notes: personality, communication style, rapport hooks, family context, hobbies, motivators. Never shared externally."/>
            </xpath>

            <!-- ── Tax ID is unused on the company-itself card ─────────── -->
            <xpath expr="//field[@name='vat']" position="attributes">
                <attribute name="invisible">company_type == 'company'</attribute>
            </xpath>

            <!-- ── Invoicing and Sales &amp; Purchase — companies only ─────── -->
            <xpath expr="//page[@name='accounting']" position="attributes">
                <attribute name="invisible">company_type == 'person'</attribute>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="attributes">
                <attribute name="invisible">company_type == 'person'</attribute>
            </xpath>

            <xpath expr="//field[@name='contact_header_name']" position="after">
                <field name="first_name" invisible="company_type != 'person'" readonly="1"/>
                <field name="last_name" invisible="company_type != 'person'" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='address_type_meaning']/parent::div" position="after">
                <field name="company_role_tag_ids"
                       widget="many2many_tags"
                       options="{'color_field': 'color'}"
                       invisible="company_type == 'person'"/>
            </xpath>

        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════════════════
         PARTNER LIST VIEW — company_role + entity_status columns
         ═══════════════════════════════════════════════════════════════ -->
    <record id="partner_list_plasticos_ux" model="ir.ui.view">
        <field name="name">res.partner.list.plasticos.ux</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='category_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//list/field[@name='complete_name']" position="after">
                <field name="first_name" optional="show"/>
                <field name="last_name" optional="show"/>
            </xpath>
            <xpath expr="//list/field[@name='country_id']" position="before">
                <field name="company_role_tag_ids"
                       widget="many2many_tags"
                       options="{'color_field': 'color'}"
                       optional="show"/>
                <field name="company_role"
                       widget="badge"
                       decoration-success="company_role == 'buyer'"
                       decoration-info="company_role == 'supplier'"
                       decoration-warning="company_role == 'prospect'"
                       optional="hide"/>
                <field name="entity_status"
                       widget="badge"
                       decoration-danger="entity_status == 'blocked'"
                       decoration-warning="entity_status == 'inactive'"
                       decoration-success="entity_status == 'active'"
                       optional="show"/>
            </xpath>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════════════════
         PARTNER SEARCH VIEW — role + status quick filters
         ═══════════════════════════════════════════════════════════════ -->
    <record id="partner_search_plasticos_ux" model="ir.ui.view">
        <field name="name">res.partner.search.plasticos.ux</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='supplier']" position="after">
                <filter string="Buyers" name="role_buyer"
                        domain="[('customer_rank', '&gt;', 0)]"/>
                <filter string="Suppliers" name="role_supplier"
                        domain="[('supplier_rank', '&gt;', 0)]"/>
                <filter string="Buyer &amp; Supplier" name="role_buyer_supplier"
                        domain="[('customer_rank', '&gt;', 0), ('supplier_rank', '&gt;', 0)]"/>
                <filter string="Has Company Type" name="has_company_type"
                        domain="[('category_id.parent_id.name', '=', 'Company Type')]"/>
                <filter string="Has Status" name="has_status"
                        domain="[('category_id.parent_id.name', '=', 'Status')]"/>
                <filter string="Prospects" name="role_prospect"
                        domain="[('company_role', '=', 'prospect')]"/>
                <filter string="Blocked" name="status_blocked"
                        domain="[('entity_status', '=', 'blocked')]"/>
                <separator/>
                <filter string="Companies" name="contact_type_company"
                        domain="[('company_type', '=', 'company')]"/>
                <filter string="People" name="contact_type_person"
                        domain="[('company_type', '=', 'person')]"/>
                <filter string="Sites" name="contact_type_site"
                        domain="[('company_type', '=', 'site')]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         MATERIAL PROFILE SECTION — companies AND sites (ADR-131)
         A site is either a company parented under a company or a native
         delivery/invoice address; both carry material profiles.
         ═══════════════════════════════════════════════════════════════ -->
    <record id="partner_form_material_profile_sites" model="ir.ui.view">
        <field name="name">res.partner.form.material.profiles.sites</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="plasticos_material_profile.view_partner_form_material_tab"/>
        <field name="arch" type="xml">
            <xpath expr="//separator[@name='material_profile_separator']" position="attributes">
                <attribute name="invisible">company_type == 'person'</attribute>
            </xpath>
            <xpath expr="//div[@role='status'][contains(@invisible, 'material_profile_count')]" position="attributes">
                <attribute name="invisible">company_type == 'person' or material_profile_count &gt; 0</attribute>
            </xpath>
            <xpath expr="//field[@name='material_profile_ids']" position="attributes">
                <attribute name="invisible">company_type == 'person'</attribute>
            </xpath>
        </field>
    </record>

</odoo>
