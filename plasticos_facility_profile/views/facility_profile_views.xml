<odoo>

  <!-- ═══════════════════════════════════════════════════════════════════
       LIST VIEW
       ═══════════════════════════════════════════════════════════════════ -->

  <record id="view_facility_profile_list" model="ir.ui.view">
    <field name="name">plasticos.facility.profile.list</field>
    <field name="model">plasticos.facility.profile</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="process_type"/>
        <field name="feedstock_type"/>
        <field name="capacity_lbs_month" sum="Total Capacity"/>
        <field name="has_horizontal_baler"/>
        <field name="has_wash_line"/>
        <field name="handles_bales"/>
      </list>
    </field>
  </record>

  <!-- ═══════════════════════════════════════════════════════════════════
       FORM VIEW (Standalone - single source of truth)
       ═══════════════════════════════════════════════════════════════════ -->

  <record id="view_facility_profile_form" model="ir.ui.view">
    <field name="name">plasticos.facility.profile.form</field>
    <field name="model">plasticos.facility.profile</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <notebook name="facility_profile_pages">
            <!-- ── Capability Tab ──────────────────────── -->
            <page string="Capability">
              <group>
                <group string="Processing">
                  <field name="process_type"/>
                  <field name="feedstock_type"/>
                  <field name="form_preference_id"/>
                  <field name="application_class"/>
                </group>
                <group string="Capacity">
                  <field name="capacity_lbs_month"/>
                  <field name="avg_truckload_lbs"/>
                </group>
              </group>
              <group string="Accepted Polymers">
                <field name="accepted_polymer_ids" widget="many2many_tags"/>
              </group>
            </page>

            <!-- ── Tolerances Tab ──────────────────────── -->
            <page string="Tolerances">
              <group>
                <group string="Density (g/cm³)">
                  <field name="density_min"/>
                  <field name="density_max"/>
                </group>
                <group string="Melt Flow Index (g/10min)">
                  <field name="melt_index_min"/>
                  <field name="melt_index_max"/>
                </group>
              </group>
              <group>
                <group string="Contamination &amp; Moisture">
                  <field name="contamination_tolerance_pct"/>
                  <field name="moisture_tolerance_pct"/>
                </group>
                <group string="PCR Content (%)">
                  <field name="pcr_pct_min"/>
                  <field name="pcr_pct_max"/>
                </group>
              </group>
            </page>

            <!-- ── Equipment Tab ───────────────────────── -->
            <page string="Equipment">
              <group>
                <group string="Equipment">
                  <field name="has_horizontal_baler"/>
                  <field name="has_downstroke_baler"/>
                  <field name="has_shredder"/>
                  <field name="has_granulator"/>
                  <field name="has_wash_line"/>
                  <field name="has_extruder"/>
                  <field name="has_sorting_line"/>
                </group>
                <group string="Material Handling">
                  <field name="handles_bales"/>
                  <field name="handles_regrind"/>
                  <field name="handles_pellet"/>
                  <field name="handles_flake"/>
                  <field name="handles_rollstock"/>
                </group>
              </group>
            </page>

            <!-- ── Quality &amp; Certification Tab ─────── -->
            <page string="Quality &amp; Certification">
              <group>
                <group string="Quality Processing">
                  <field name="can_remove_metal"/>
                  <field name="can_reduce_moisture"/>
                  <field name="can_filter_fr"/>
                  <field name="can_screen_fines"/>
                </group>
                <group string="Certifications">
                  <field name="iso_certified"/>
                  <field name="food_grade_certified"/>
                  <field name="medical_grade_capable"/>
                </group>
              </group>
              <group>
                <group string="Material Acceptance">
                  <field name="accepts_filled_materials"/>
                </group>
              </group>
            </page>

            <!-- ── Operational Tab ─────────────────────── -->
            <page string="Operational">
              <group>
                <group string="Lot Size">
                  <field name="min_lot_size_lbs"/>
                  <field name="max_lot_size_lbs"/>
                </group>
                <group string="Deal Preference">
                  <field name="accepts_spot"/>
                  <field name="prefers_contract"/>
                </group>
              </group>
              <group string="Notes">
                <field name="application_notes"/>
                <field name="freeform_notes"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ═══════════════════════════════════════════════════════════════════
       PARTNER FORM EXTENSION (Facility Capabilities Tab)
       Uses view reference to avoid duplication
       ═══════════════════════════════════════════════════════════════════ -->

  <record id="view_partner_form_profile_tab" model="ir.ui.view">
    <field name="name">res.partner.form.capability.tab</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">

      <xpath expr="//div[hasclass('flex-column')]/h1" position="after">
        <field name="contact_header_name" nolabel="1" readonly="1" invisible="company_type == 'person' or not contact_header_name"/>
      </xpath>

      <xpath expr="//div[hasclass('flex-column')]/field[@name='company_type']" position="after">
        <div class="d-flex align-items-baseline gap-2">
          <span class="o_form_label">Address Type</span>
          <field name="type" nolabel="1" readonly="1" invisible="address_type_meaning"/>
          <field name="address_type_meaning" nolabel="1" readonly="1" invisible="not address_type_meaning"/>
        </div>
      </xpath>

      <xpath expr="//div[hasclass('flex-column')]//field[@name='email']/parent::div" position="attributes">
        <attribute name="invisible">company_type == 'site'</attribute>
      </xpath>
      <xpath expr="//div[hasclass('flex-column')]//field[@name='email']/parent::div" position="after">
        <div class="d-flex align-items-baseline w-md-50" invisible="company_type != 'site'">
          <i class="fa fa-fw me-1 fa-envelope text-primary" title="Email"/>
          <field name="linked_person_email" class="w-100" widget="email" readonly="1"/>
        </div>
      </xpath>

      <xpath expr="//div[hasclass('flex-column')]//field[@name='phone']/parent::div" position="after">
        <div class="d-flex align-items-baseline w-md-50" invisible="company_type == 'site'">
          <i class="fa fa-fw me-1 fa-mobile text-primary" title="Mobile"/>
          <field name="mobile" class="w-100" widget="phone" placeholder="Mobile"/>
        </div>
        <div class="d-flex align-items-baseline w-md-50" invisible="company_type != 'site'">
          <i class="fa fa-fw me-1 fa-mobile text-primary" title="Mobile"/>
          <field name="linked_person_mobile" class="w-100" widget="phone" readonly="1"/>
        </div>
        <field name="phone_line_ids" invisible="1"/>
      </xpath>

      <xpath expr="//notebook[page[@name='internal_notes']]" position="before">
        <separator string="Facility Profile" invisible="not is_facility"/>
        <field name="partner_type_id" options="{'no_create': True}" invisible="not is_facility"/>
        <field name="facility_profile_ids" nolabel="1" invisible="not is_facility"
               context="{'default_partner_id': id, 'form_view_ref': 'plasticos_facility_profile.view_facility_profile_form'}">
          <!-- Same row behaviour as the Material Profile lines: the built-in open
               button saves the row, then opens the full profile form. The class
               reuses that list's external-link icon styling (material_profile_lines.css). -->
          <list editable="bottom" open_form_view="1" delete="0" class="o_material_profile_lines">
            <field name="process_type"/>
            <field name="feedstock_type"/>
            <field name="capacity_lbs_month" sum="Total Capacity"/>
            <field name="has_horizontal_baler"/>
            <field name="has_wash_line"/>
            <field name="handles_bales"/>
            <button name="action_remove_profile" type="object" icon="fa-trash"
                    title="Remove facility profile"
                    confirm="Remove this facility profile? A profile whose partner has an open sale order cannot be removed."
                    class="btn-link text-danger p-0"/>
          </list>
        </field>
        <separator string="Locations" invisible="company_type != 'company'"/>
        <field name="location_child_ids" nolabel="1" invisible="company_type != 'company'">
          <list>
            <field name="name"/>
            <field name="type" string="Address Type"/>
            <field name="street"/>
            <field name="city"/>
            <field name="state_id"/>
            <field name="zip"/>
            <field name="country_id"/>
            <field name="phone"/>
            <field name="linked_person_email" string="Email"/>
            <field name="user_id" string="Salesperson" widget="many2one_avatar_user"/>
            <button name="action_remove_location" type="object" icon="fa-trash"
                    title="Remove location"
                    confirm="Remove this location? A location that is still in use is archived and kept."
                    class="btn-link text-danger p-0"/>
          </list>
        </field>
        <separator string="Sites" invisible="company_type != 'person'"/>
        <field name="location_partner_ids" nolabel="1" invisible="company_type != 'person'">
          <list>
            <field name="name"/>
            <field name="street"/>
            <field name="city"/>
            <field name="state_id"/>
            <field name="zip"/>
            <field name="phone"/>
          </list>
        </field>
        <separator string="People" invisible="company_type != 'site'"/>
        <field name="site_person_ids" nolabel="1" invisible="company_type != 'site'">
          <list>
            <field name="name"/>
            <field name="function"/>
            <field name="phone"/>
          </list>
        </field>
      </xpath>

      <!-- Under the address block so the label is a normal form row, not inside the tax-id cell. -->
      <xpath expr="//div[hasclass('o_address_format')]" position="after">
        <field name="default_delivery_term" string="Dock Rule" invisible="company_type == 'person'"/>
      </xpath>

      <!-- The base Tags row stays for locations. The company card gets its own, under Lead Source. -->
      <xpath expr="//field[@name='category_id']" position="attributes">
        <attribute name="invisible">company_type == 'company'</attribute>
      </xpath>
      <xpath expr="//field[@name='category_id']" position="after">
        <field name="lead_source_id" widget="badge" invisible="company_type != 'site'"/>
        <field name="user_id" string="Salesperson" widget="many2one_avatar_user" readonly="parent_id" invisible="company_type != 'site'"/>
        <field name="property_supplier_payment_term_id" string="Payment Terms" invisible="company_type != 'site' or not supplier_rank"/>
      </xpath>
      <xpath expr="//field[@name='vat']" position="before">
        <field name="lead_source_id" widget="badge" invisible="company_type != 'company'"/>
        <field name="category_id" widget="many2many_tags" options="{'color_field': 'color'}" placeholder="e.g. &quot;B2B&quot;, &quot;VIP&quot;, &quot;Consulting&quot;, ..." invisible="company_type != 'company'"/>
        <field name="user_id" string="Salesperson" widget="many2one_avatar_user" readonly="parent_id" invisible="company_type != 'company'"/>
      </xpath>

    </field>
  </record>

</odoo>
