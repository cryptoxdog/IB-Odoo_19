<odoo>

  <!-- ═══════════════════════════════════════════════════════════════════
       LIST VIEW
       ═══════════════════════════════════════════════════════════════════ -->

  <record id="view_facility_profile_list" model="ir.ui.view">
    <field name="name">plasticos.facility.profile.list</field>
    <field name="model">plasticos.facility.profile</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="max_monthly_throughput_lbs" sum="Total Throughput"/>
        <field name="process_type"/>
        <field name="feedstock_type"/>
        <field name="capacity_lbs_month" sum="Total Capacity"/>
        <field name="has_horizontal_baler"/>
        <field name="has_wash_line"/>
        <field name="handles_bales"/>
      </list>
    </field>
  </record>

  <!-- ═══════════════════════════════════════════════════════════════════
       FORM VIEW (Standalone - single source of truth)
       ═══════════════════════════════════════════════════════════════════ -->

  <record id="view_facility_profile_form" model="ir.ui.view">
    <field name="name">plasticos.facility.profile.form</field>
    <field name="model">plasticos.facility.profile</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <notebook>
            <!-- ── Capability Tab ──────────────────────── -->
            <page string="Capability">
              <group>
                <group string="Processing">
                  <field name="process_type"/>
                  <field name="feedstock_type"/>
                  <field name="form_preference_id"/>
                  <field name="application_class"/>
                </group>
                <group string="Capacity">
                  <field name="max_monthly_throughput_lbs"/>
                  <field name="capacity_lbs_month"/>
                  <field name="avg_truckload_lbs"/>
                </group>
              </group>
              <group string="Accepted Polymers">
                <field name="accepted_polymer_ids" widget="many2many_tags"/>
              </group>
            </page>

            <!-- ── Tolerances Tab ──────────────────────── -->
            <page string="Tolerances">
              <group>
                <group string="Density (g/cm³)">
                  <field name="density_min"/>
                  <field name="density_max"/>
                </group>
                <group string="Melt Flow Index (g/10min)">
                  <field name="melt_index_min"/>
                  <field name="melt_index_max"/>
                </group>
              </group>
              <group>
                <group string="Contamination &amp; Moisture">
                  <field name="contamination_tolerance_pct"/>
                  <field name="moisture_tolerance_pct"/>
                </group>
                <group string="PCR Content (%)">
                  <field name="pcr_pct_min"/>
                  <field name="pcr_pct_max"/>
                </group>
              </group>
            </page>

            <!-- ── Equipment Tab ───────────────────────── -->
            <page string="Equipment">
              <group string="Equipment Types">
                <field name="equipment_type_ids" widget="many2many_tags"/>
              </group>
              <group>
                <group string="Equipment (computed)">
                  <field name="has_horizontal_baler" readonly="1"/>
                  <field name="has_downstroke_baler" readonly="1"/>
                  <field name="has_shredder" readonly="1"/>
                  <field name="has_granulator" readonly="1"/>
                  <field name="has_wash_line" readonly="1"/>
                  <field name="has_extruder" readonly="1"/>
                  <field name="has_sorting_line" readonly="1"/>
                </group>
                <group string="Material Handling">
                  <field name="handles_bales"/>
                  <field name="handles_regrind"/>
                  <field name="handles_pellet"/>
                  <field name="handles_flake"/>
                  <field name="handles_rollstock"/>
                </group>
              </group>
            </page>

            <!-- ── Quality &amp; Certification Tab ─────── -->
            <page string="Quality &amp; Certification">
              <group>
                <group string="Quality Processing">
                  <field name="can_remove_metal"/>
                  <field name="can_reduce_moisture"/>
                  <field name="can_filter_fr"/>
                  <field name="can_screen_fines"/>
                </group>
                <group string="Certifications">
                  <field name="iso_certified"/>
                  <field name="food_grade_certified"/>
                  <field name="medical_grade_capable"/>
                </group>
              </group>
              <group>
                <group string="Material Acceptance">
                  <field name="accepts_filled_materials"/>
                </group>
              </group>
            </page>

            <!-- ── Operational Tab ─────────────────────── -->
            <page string="Operational">
              <group>
                <group string="Lot Size">
                  <field name="min_lot_size_lbs"/>
                  <field name="max_lot_size_lbs"/>
                </group>
                <group string="Deal Preference">
                  <field name="accepts_spot"/>
                  <field name="prefers_contract"/>
                </group>
              </group>
              <group string="Notes">
                <field name="application_notes"/>
                <field name="freeform_notes"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ═══════════════════════════════════════════════════════════════════
       PARTNER FORM EXTENSION (Facility Capabilities Tab)
       Uses view reference to avoid duplication
       ═══════════════════════════════════════════════════════════════════ -->

  <record id="view_partner_form_profile_tab" model="ir.ui.view">
    <field name="name">res.partner.form.capability.tab</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">

      <!-- Add lead_source_id to partner form (visible for companies) -->
      <xpath expr="//field[@name='category_id']" position="after">
        <field name="lead_source_id" invisible="not is_company"/>
      </xpath>

      <xpath expr="//sheet/notebook" position="inside">

        <page string="Facility Capabilities" name="facility_capabilities"
              invisible="not parent_id">

          <group>
            <field name="partner_type_id" options="{'no_create': True}"/>
          </group>

          <field name="facility_profile_ids"
                 context="{'form_view_ref': 'plasticos_facility_profile.view_facility_profile_form'}">
            <list editable="bottom">
              <field name="max_monthly_throughput_lbs" sum="Total Throughput"/>
              <field name="process_type"/>
              <field name="feedstock_type"/>
              <field name="capacity_lbs_month" sum="Total Capacity"/>
              <field name="has_horizontal_baler"/>
              <field name="has_wash_line"/>
              <field name="handles_bales"/>
            </list>
          </field>

        </page>

      </xpath>

    </field>
  </record>

</odoo>
