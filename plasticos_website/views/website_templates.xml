<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Replace default footer with Scrap Management branding -->
    <template id="footer_default"
              inherit_id="website.footer_default"
              name="Scrap Management Footer">
        <xpath expr="//div[hasclass('o_footer_default')]" position="replace">
            <div class="o_footer_default" id="footer">
                <div class="container py-4">
                    <div class="row">

                        <!-- Column 1: Company -->
                        <div class="col-lg-4 mb-3">
                            <h5>Scrap Management Inc</h5>
                            <p class="mb-1">10612-D Providence Rd #750</p>
                            <p class="mb-0">Charlotte, NC 28277</p>
                        </div>

                        <!-- Column 2: Contact -->
                        <div class="col-lg-4 mb-3">
                            <h5>Contact Us</h5>
                            <p class="mb-1">
                                <i class="fa fa-phone me-2" title="Phone"/>
                                <a href="tel:+17046985186">+1 704-698-5186</a>
                            </p>
                            <p class="mb-1">
                                <i class="fa fa-envelope me-2" title="Email"/>
                                <a href="mailto:info@scrapmanagement.com">info@scrapmanagement.com</a>
                            </p>
                            <p class="mb-0">
                                <i class="fa fa-globe me-2" title="Website"/>
                                <a href="https://scrapmanagement.com" target="_blank">scrapmanagement.com</a>
                            </p>
                        </div>

                        <!-- Column 3: Social -->
                        <div class="col-lg-4 mb-3">
                            <h5>Connect with Us</h5>
                            <div class="d-flex gap-3 fs-4">
                                <a t-att-href="website.social_facebook" t-if="website.social_facebook"
                                   target="_blank" aria-label="Facebook">
                                    <i class="fa fa-facebook" title="Facebook"/>
                                </a>
                                <a t-att-href="website.social_twitter" t-if="website.social_twitter"
                                   target="_blank" aria-label="X / Twitter">
                                    <i class="fa fa-twitter" title="Twitter"/>
                                </a>
                                <a t-att-href="website.social_linkedin" t-if="website.social_linkedin"
                                   target="_blank" aria-label="LinkedIn">
                                    <i class="fa fa-linkedin" title="LinkedIn"/>
                                </a>
                                <a t-att-href="website.social_instagram" t-if="website.social_instagram"
                                   target="_blank" aria-label="Instagram">
                                    <i class="fa fa-instagram" title="Instagram"/>
                                </a>
                            </div>
                        </div>

                    </div>

                    <hr class="mt-2 mb-2"/>
                    <div class="text-center small text-muted">
                        © <t t-out="datetime.date.today().year"/> Scrap Management Inc — All rights reserved
                    </div>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
