<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════ -->
    <!-- Config Form View                                     -->
    <!-- ════════════════════════════════════════════════════ -->

    <record id="view_web_lead_config_form" model="ir.ui.view">
        <field name="name">plasticos.web.lead.config.form</field>
        <field name="model">plasticos.web.lead.config</field>
        <field name="arch" type="xml">
            <form string="Web Lead Configuration">
                <sheet>
                    <group string="Endpoint Settings">
                        <group>
                            <field name="is_active"/>
                            <field name="auto_create_partner"/>
                            <field name="auto_create_intake"/>
                        </group>
                        <group>
                            <field name="default_source_type"/>
                        </group>
                    </group>
                    <group string="API Authentication">
                        <group>
                            <field name="api_key" password="True"/>
                            <button name="action_generate_api_key"
                                    string="Generate New API Key"
                                    type="object"
                                    class="btn-warning"
                                    confirm="This will invalidate the current key. External integrations will need the new key. Continue?"/>
                        </group>
                    </group>
                    <group string="OpenAI Credentials (AI Triage)">
                        <group>
                            <field name="openai_api_key" password="True"/>
                            <field name="openai_model"/>
                            <field name="openai_vision_model"/>
                        </group>
                        <group>
                            <field name="ai_enabled"/>
                            <field name="vision_enabled"/>
                        </group>
                    </group>
                    <group string="Classification Thresholds">
                        <group>
                            <field name="hot_min_lbs"/>
                            <field name="cold_max_lbs"/>
                        </group>
                    </group>
                    <group string="Reject Lists">
                        <field name="reject_materials" widget="text"
                               placeholder="vinyl siding|appliances|conduit|pvc pipe"/>
                        <field name="reject_sources" widget="text"
                               placeholder="residential|individual|homeowner|drop-off"/>
                    </group>
                    <separator string="Integration Guide"/>
                    <div class="alert alert-info" role="alert">
                        <p><strong>Endpoints:</strong></p>
                        <ul>
                            <li><code>POST /api/v1/web-lead</code> — Pre-processed agent payload (legacy)</li>
                            <li><code>POST /api/v1/cognito-webhook</code> — Raw Cognito form (AI triage)</li>
                            <li><code>GET /api/v1/web-lead/health</code> — Health check (no auth)</li>
                        </ul>
                        <p><strong>Auth:</strong> <code>Authorization: Bearer &lt;api_key&gt;</code></p>
                        <p>HOT leads automatically create a partner and intake record.</p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════ -->
    <!-- Action (singleton redirect)                          -->
    <!-- ════════════════════════════════════════════════════ -->

    <record id="action_web_lead_config" model="ir.actions.act_window">
        <field name="name">Web Lead Settings</field>
        <field name="res_model">plasticos.web.lead.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="res_id" ref="web_lead_config_default"/>
    </record>

    <!-- Menu item under Settings -->
    <menuitem
        id="menu_web_lead_config"
        name="Web Lead Config"
        parent="base.menu_administration"
        action="action_web_lead_config"
        sequence="91"
    />

</odoo>
