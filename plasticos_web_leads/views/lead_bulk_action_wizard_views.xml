<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Web Lead Bulk Action Wizard Form -->
    <record id="view_lead_bulk_action_wizard_form" model="ir.ui.view">
        <field name="name">plasticos.web.lead.bulk.action.wizard.form</field>
        <field name="model">plasticos.web.lead.bulk.action.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Web Lead Actions">
                <group>
                    <group>
                        <field name="lead_count" readonly="1"/>
                        <field name="hot_count" readonly="1"/>
                        <field name="cold_count" readonly="1"/>
                        <field name="error_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="action_type" widget="radio"/>
                    </group>
                </group>
                <group>
                    <field name="notes"/>
                </group>
                <field name="lead_ids" invisible="1"/>
                <footer>
                    <button name="action_execute" string="Execute" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard from list view -->
    <record id="action_lead_bulk_action_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Lead Actions</field>
        <field name="res_model">plasticos.web.lead.bulk.action.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="plasticos_web_leads.model_plasticos_web_lead"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
