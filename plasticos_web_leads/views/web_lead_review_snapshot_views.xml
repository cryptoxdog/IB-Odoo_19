<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_web_lead_review_snapshot_list" model="ir.ui.view">
        <field name="name">plasticos.web.lead.review.snapshot.list</field>
        <field name="model">plasticos.web.lead.review.snapshot</field>
        <field name="arch" type="xml">
            <list string="Broker-Approved Web-Lead Snapshots" create="0" delete="0">
                <field name="name"/>
                <field name="web_lead_id"/>
                <field name="intake_id"/>
                <field name="revision"/>
                <field name="approved_by_id"/>
                <field name="approved_at"/>
                <field name="content_hash"/>
            </list>
        </field>
    </record>

    <record id="view_web_lead_review_snapshot_form" model="ir.ui.view">
        <field name="name">plasticos.web.lead.review.snapshot.form</field>
        <field name="model">plasticos.web.lead.review.snapshot</field>
        <field name="arch" type="xml">
            <form string="Broker-Approved Web-Lead Snapshot" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="web_lead_id" readonly="1"/>
                            <field name="intake_id" readonly="1"/>
                            <field name="revision" readonly="1"/>
                        </group>
                        <group>
                            <field name="approved_by_id" readonly="1"/>
                            <field name="approved_at" readonly="1"/>
                            <field name="content_hash" readonly="1"/>
                        </group>
                    </group>
                    <group string="Approved Factual Snapshot">
                        <field name="snapshot_payload" widget="json" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
