<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════ -->
    <!-- List View                                            -->
    <!-- ════════════════════════════════════════════════════ -->

    <record id="view_web_lead_list" model="ir.ui.view">
        <field name="name">plasticos.web.lead.list</field>
        <field name="model">plasticos.web.lead</field>
        <field name="arch" type="xml">
            <list string="Web Leads" decoration-success="decision=='hot'" decoration-warning="state=='review_pending'" decoration-muted="state=='skipped'">
                <field name="submitted_at"/>
                <field name="lead_id"/>
                <field name="assigned_user_id" optional="show" widget="many2one_avatar_user"/>
                <field name="company_name"/>
                <field name="contact_name" string="Name"/>
                <field name="contact_phone" string="Phone" widget="phone"/>
                <field name="contact_email" string="Email" widget="email"/>
                <field name="pickup_place" string="Location"/>
                <field name="estimated_lbs_per_load"/>
                <field name="estimated_loads_per_month"/>
                <field name="decision" widget="badge"
                       decoration-success="decision == 'hot'"
                       decoration-warning="decision == 'review'"
                       decoration-muted="decision == 'cold'"/>
                <field name="review_status" widget="badge"
                       decoration-success="review_status == 'approved'"
                       decoration-warning="review_status == 'clarification_required'"
                       decoration-muted="review_status == 'rejected'"/>
                <field name="lead_source_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'received'"
                       decoration-warning="state == 'review_pending'"
                       decoration-success="state == 'intake_created'"
                       decoration-muted="state == 'skipped'"
                       decoration-danger="state == 'error'"/>
                <field name="frequency"/>
                <field name="partner_id"/>
                <field name="intake_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════ -->
    <!-- Form View                                            -->
    <!-- ════════════════════════════════════════════════════ -->

    <record id="view_web_lead_form" model="ir.ui.view">
        <field name="name">plasticos.web.lead.form</field>
        <field name="model">plasticos.web.lead</field>
        <field name="arch" type="xml">
            <form string="Web Lead">
                <header>
                    <button name="action_retry_processing"
                            string="Retry Processing"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'error'"/>
                    <button name="action_promote_to_hot"
                            string="Promote to HOT"
                            type="object"
                            class="btn-primary"
                            invisible="intake_id or state not in ('review_pending', 'skipped', 'received')"
                            confirm="Promote to HOT and create the intake? Broker Review Notes and a verified Lbs/Load are required."/>
                    <button name="action_retry_triage"
                            string="Re-Run Triage"
                            type="object"
                            class="btn-warning"
                            invisible="state not in ('error', 'skipped', 'received', 'review_pending')"/>
                    <button name="action_retry_economic_assessment"
                            string="Retry Assessment"
                            type="object"
                            class="btn-secondary"
                            invisible="not intake_id"/>
                    <button name="action_approve_for_commercial_preparation"
                            string="Approve"
                            type="object"
                            class="btn-primary"
                            invisible="decision != 'hot' or not intake_id or review_status == 'approved'"/>
                    <button name="action_request_clarification"
                            string="Request Clarification"
                            type="object"
                            class="btn-warning"
                            invisible="decision != 'hot' or not intake_id or review_status == 'clarification_required'"/>
                    <button name="action_reject_after_review"
                            string="Reject After Review"
                            type="object"
                            class="btn-secondary"
                            invisible="(decision != 'hot' or not intake_id) and state != 'review_pending' or review_status == 'rejected'"/>
                    <button name="action_route_hot_review"
                            string="Route Review"
                            type="object"
                            class="btn-warning"
                            invisible="mack_review_state != 'blocked'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="received,review_pending,intake_created"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <h1><field name="lead_id" readonly="1"/></h1>
                        <h2><field name="submitted_at" readonly="1"/></h2>
                        <field name="assigned_user_id" widget="many2one_avatar_user" readonly="state == 'intake_created'"/>
                    </div>
                    <!-- Contact -->
                    <group string="Contact">
                        <group>
                            <field name="company_name"/>
                            <field name="contact_name"/>
                            <field name="pickup_place" readonly="1"/>
                        </group>
                        <group>
                            <field name="contact_email" widget="email"/>
                            <field name="contact_phone" widget="phone"/>
                            <field name="pickup_postal_code"/>
                        </group>
                    </group>

                    <!-- Material -->
                    <group string="Material">
                        <field name="material_description" colspan="2"/>
                        <group>
                            <field name="quantity_text" string="Quantity"/>
                            <field name="has_contaminants"/>
                            <field name="contaminant_notes"
                                   invisible="not has_contaminants"/>
                        </group>
                        <group>
                            <field name="estimated_lbs_per_load"/>
                            <field name="estimated_lbs_high" invisible="not estimated_lbs_high"/>
                            <field name="estimated_loads_per_month"/>
                            <field name="frequency"/>
                        </group>
                    </group>

                    <!-- Classification -->
                    <group string="Classification">
                        <group>
                            <field name="lead_image_ids" widget="lead_image_strip" readonly="1"/>
                            <field name="decision"/>
                            <field name="representation_alignment_display" readonly="1"/>
                            <div invisible="representation_alignment_display != '100/100'">
                                <span class="badge bg-success">100/100 representation alignment</span>
                            </div>
                            <field name="review_status" readonly="1"/>
                            <field name="review_required_reason" readonly="1"/>
                        </group>
                        <group>
                            <field name="lead_source_id"/>
                            <field name="mack_review_state"/>
                            <field name="mack_review_reason" invisible="mack_review_state == 'not_queued'"/>
                        </group>
                    </group>

                    <!-- Links -->
                    <group string="Links" name="links">
                        <field name="partner_id"/>
                        <field name="intake_id"/>
                    </group>

                    <!-- Technical tabs (AI, raw data, errors) -->
                    <notebook>
                        <page string="AI Analysis" name="ai_analysis_page">
                            <field name="ai_analysis" widget="lead_evidence" options="{'mode': 'analysis'}" readonly="1"/>
                            <field name="decision_reasons" invisible="1"/>
                        </page>
                        <page string="AI Triage" name="ai_triage_page">
                            <field name="ai_normalized" widget="lead_evidence" options="{'mode': 'triage'}" readonly="1"/>
                            <field name="ai_vision_results" invisible="1"/>
                            <field name="image_urls" invisible="1"/>
                            <group string="Triage Audit Log">
                                <field name="triage_log" widget="text" readonly="1" class="o_lead_triage_log"/>
                            </group>
                        </page>
                        <page string="Raw Payload" name="raw_payload_page">
                            <field name="raw_payload" widget="lead_evidence" options="{'mode': 'payload'}" readonly="1"/>
                        </page>
                        <page string="Provider Audit" name="provider_audit_page">
                            <group string="Provider Identity">
                                <field name="provider_key" readonly="1"/>
                                <field name="provider_external_id" readonly="1"/>
                            </group>
                            <group string="Canonical Packet">
                                <field name="canonical_payload" widget="json" readonly="1"/>
                            </group>
                            <group string="Evidence Bundle">
                                <field name="evidence_bundle" widget="json" readonly="1"/>
                            </group>
                        </page>
                        <page string="Broker Review" name="broker_review_page">
                            <group>
                                <field name="review_status" readonly="1"/>
                                <field name="review_notes" placeholder="Record the broker's decision rationale and required follow-up."/>
                                <field name="review_required_reason" readonly="1"/>
                            </group>
                        </page>
                        <page string="Error" name="error_page" invisible="state != 'error'">
                            <group>
                                <field name="error_message"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════ -->
    <!-- Kanban View                                          -->
    <!-- ════════════════════════════════════════════════════ -->

    <record id="view_web_lead_kanban" model="ir.ui.view">
        <field name="name">plasticos.web.lead.kanban</field>
        <field name="model">plasticos.web.lead</field>
        <field name="arch" type="xml">
            <kanban default_group_by="decision" class="o_kanban_small_column">
                <field name="lead_id"/>
                <field name="company_name"/>
                <field name="contact_name"/>
                <field name="decision"/>
                <field name="state"/>
                <field name="lead_source_id"/>
                <field name="estimated_lbs_per_load"/>
                <field name="representation_alignment_display"/>
                <field name="intake_id"/>
                <progressbar field="state"
                             colors='{"received": "info", "review_pending": "warning", "intake_created": "success", "skipped": "muted", "error": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="#{record.decision.raw_value == 'hot' ? 'border-success border-2' : record.state.raw_value == 'error' ? 'border-danger border-2' : record.state.raw_value == 'review_pending' ? 'border-warning border-2' : ''}">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="company_name"/>
                                    </strong>
                                    <span class="o_kanban_record_subtitle text-muted">
                                        <field name="lead_id"/>
                                    </span>
                                </div>
                                <span t-attf-class="badge #{record.decision.raw_value == 'hot' ? 'bg-success' : record.decision.raw_value == 'review' ? 'bg-warning text-dark' : 'bg-secondary'}">
                                    <field name="decision"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-user" title="Contact"/> <field name="contact_name"/></div>
                                <div t-if="record.estimated_lbs_per_load.raw_value" class="mt-1">
                                    <span class="badge bg-info">
                                        <field name="estimated_lbs_per_load"/> lbs/load
                                    </span>
                                </div>
                                <div t-if="record.representation_alignment_display.raw_value == '100/100'" class="mt-1">
                                    <span class="badge bg-success">100/100 representation alignment</span>
                                </div>
                                <div t-elif="record.representation_alignment_display.raw_value" class="mt-1">
                                    <span class="badge bg-secondary">
                                        <t t-out="record.representation_alignment_display.value"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge bg-secondary">
                                        <field name="lead_source_id"/>
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span t-if="record.intake_id.raw_value" class="badge bg-success">
                                        <i class="fa fa-check" title="Has intake"/> Intake
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════ -->
    <!-- Search View                                          -->
    <!-- ════════════════════════════════════════════════════ -->

    <record id="view_web_lead_search" model="ir.ui.view">
        <field name="name">plasticos.web.lead.search</field>
        <field name="model">plasticos.web.lead</field>
        <field name="arch" type="xml">
            <search>
                <field name="lead_id"/>
                <field name="company_name"/>
                <field name="decision"/>
                <field name="state"/>
                <field name="lead_source_id"/>
                <separator/>
                <filter name="actionable" string="Actionable (HOT, REVIEW, Errors)"
                        domain="['|', '|', ('decision','=','hot'), ('state','=','review_pending'), ('state','=','error')]"/>
                <separator/>
                <filter name="hot" string="HOT Leads"
                        domain="[('decision','=','hot')]"/>
                <filter name="review" string="REVIEW Leads"
                        domain="[('state','=','review_pending')]"/>
                <filter name="cold" string="COLD Leads"
                        domain="[('decision','=','cold')]"/>
                <filter name="errors" string="Errors"
                        domain="[('state','=','error')]"/>
                <separator/>
                <filter name="group_decision" string="Group by Decision"
                        context="{'group_by': 'decision'}"/>
                <filter name="group_state" string="Group by State"
                        context="{'group_by': 'state'}"/>
                <filter name="group_lead_source" string="Group by Lead Source"
                        context="{'group_by': 'lead_source_id'}"/>
                <filter name="group_submitted" string="Submitted"
                        context="{'group_by': 'submitted_at:day'}"/>
            </search>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════ -->
    <!-- Action + Menu                                        -->
    <!-- ════════════════════════════════════════════════════ -->

    <record id="action_web_lead" model="ir.actions.act_window">
        <field name="name">Web Leads</field>
        <field name="res_model">plasticos.web.lead</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_web_lead_search"/>
        <field name="context">{'search_default_actionable': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No web leads yet
            </p>
            <p>
                Web leads are automatically captured from the website form
                and qualified into HOT, REVIEW, or COLD. HOT and REVIEW leads need a broker.
            </p>
        </field>
    </record>

    <!-- Menu under PlasticOS root -->
    <menuitem id="menu_web_lead_root"
              name="Web Leads"
              parent="plasticos_base.plasticos_root_menu"
              sequence="10"/>
    <menuitem id="menu_web_leads_all"
              name="All Web Leads"
              parent="menu_web_lead_root"
              action="action_web_lead"
              sequence="1"/>

</odoo>
