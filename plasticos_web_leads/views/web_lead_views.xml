<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════ -->
    <!-- List View                                            -->
    <!-- ════════════════════════════════════════════════════ -->

    <record id="view_web_lead_list" model="ir.ui.view">
        <field name="name">plasticos.web.lead.list</field>
        <field name="model">plasticos.web.lead</field>
        <field name="arch" type="xml">
            <list string="Web Leads" decoration-success="decision=='hot'" decoration-muted="state=='skipped'">
                <field name="lead_id"/>
                <field name="company_name"/>
                <field name="decision" widget="badge"
                       decoration-success="decision == 'hot'"
                       decoration-muted="decision == 'cold'"/>
                <field name="lead_source_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'received'"
                       decoration-success="state == 'intake_created'"
                       decoration-muted="state == 'skipped'"
                       decoration-danger="state == 'error'"/>
                <field name="estimated_lbs_per_load"/>
                <field name="estimated_loads_per_month"/>
                <field name="frequency"/>
                <field name="partner_id"/>
                <field name="intake_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════ -->
    <!-- Form View                                            -->
    <!-- ════════════════════════════════════════════════════ -->

    <record id="view_web_lead_form" model="ir.ui.view">
        <field name="name">plasticos.web.lead.form</field>
        <field name="model">plasticos.web.lead</field>
        <field name="arch" type="xml">
            <form string="Web Lead">
                <header>
                    <button name="action_retry_processing"
                            string="Retry Processing"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'error'"/>
                    <button name="action_retry_triage"
                            string="Re-Run Triage"
                            type="object"
                            class="btn-warning"
                            invisible="state not in ('error', 'skipped', 'received')"/>
                    <button name="action_force_create_intake"
                            string="Force Create Intake"
                            type="object"
                            class="btn-secondary"
                            invisible="intake_id"/>
                    <button name="action_force_hot"
                            string="Force HOT"
                            type="object"
                            class="btn-danger"
                            invisible="decision != 'cold' or intake_id"
                            confirm="Override COLD classification and create intake?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="received,intake_created"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <h1><field name="lead_id" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="decision"/>
                            <field name="source"/>
                            <field name="lead_source_id"/>
                        </group>
                        <group string="Links" name="links">
                            <field name="partner_id"/>
                            <field name="intake_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contact" name="contact_page">
                            <group>
                                <group>
                                    <field name="company_name"/>
                                    <field name="contact_name"/>
                                </group>
                                <group>
                                    <field name="contact_email"/>
                                    <field name="contact_phone"/>
                                </group>
                            </group>
                        </page>
                        <page string="Material" name="material_page">
                            <group>
                                <group>
                                    <field name="material_description"/>
                                    <field name="quantity_text"/>
                                </group>
                                <group>
                                    <field name="estimated_lbs_per_load"/>
                                    <field name="estimated_loads_per_month"/>
                                    <field name="frequency"/>
                                </group>
                            </group>
                            <group>
                                <field name="has_contaminants"/>
                                <field name="contaminant_notes"
                                       invisible="not has_contaminants"/>
                            </group>
                        </page>
                        <page string="AI Analysis" name="ai_analysis_page">
                            <group>
                                <field name="ai_analysis" widget="json"/>
                                <field name="decision_reasons" widget="json"/>
                            </group>
                        </page>
                        <page string="AI Triage" name="ai_triage_page">
                            <group string="AI Normalization">
                                <field name="ai_normalized" widget="json"/>
                            </group>
                            <group string="Vision Analysis">
                                <field name="ai_vision_results" widget="json"/>
                            </group>
                            <group string="Image URLs">
                                <field name="image_urls" widget="json"/>
                            </group>
                            <group string="Triage Audit Log">
                                <field name="triage_log" widget="text" readonly="1"/>
                            </group>
                        </page>
                        <page string="Raw Payload" name="raw_payload_page">
                            <group>
                                <field name="raw_payload" widget="json"/>
                            </group>
                        </page>
                        <page string="Error" name="error_page" invisible="state != 'error'">
                            <group>
                                <field name="error_message"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════ -->
    <!-- Kanban View                                          -->
    <!-- ════════════════════════════════════════════════════ -->

    <record id="view_web_lead_kanban" model="ir.ui.view">
        <field name="name">plasticos.web.lead.kanban</field>
        <field name="model">plasticos.web.lead</field>
        <field name="arch" type="xml">
            <kanban default_group_by="decision" class="o_kanban_small_column">
                <field name="lead_id"/>
                <field name="company_name"/>
                <field name="contact_name"/>
                <field name="decision"/>
                <field name="state"/>
                <field name="lead_source_id"/>
                <field name="estimated_lbs_per_load"/>
                <field name="intake_id"/>
                <progressbar field="state"
                             colors='{"received": "info", "intake_created": "success", "skipped": "muted", "error": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="#{record.decision.raw_value == 'hot' ? 'border-success border-2' : record.state.raw_value == 'error' ? 'border-danger border-2' : ''}">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="company_name"/>
                                    </strong>
                                    <span class="o_kanban_record_subtitle text-muted">
                                        <field name="lead_id"/>
                                    </span>
                                </div>
                                <span t-attf-class="badge #{record.decision.raw_value == 'hot' ? 'bg-success' : 'bg-secondary'}">
                                    <field name="decision"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-user" title="Contact"/> <field name="contact_name"/></div>
                                <div t-if="record.estimated_lbs_per_load.raw_value" class="mt-1">
                                    <span class="badge bg-info">
                                        <field name="estimated_lbs_per_load"/> lbs/load
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge bg-secondary">
                                        <field name="lead_source_id"/>
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span t-if="record.intake_id.raw_value" class="badge bg-success">
                                        <i class="fa fa-check" title="Has intake"/> Intake
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════ -->
    <!-- Search View                                          -->
    <!-- ════════════════════════════════════════════════════ -->

    <record id="view_web_lead_search" model="ir.ui.view">
        <field name="name">plasticos.web.lead.search</field>
        <field name="model">plasticos.web.lead</field>
        <field name="arch" type="xml">
            <search>
                <field name="lead_id"/>
                <field name="company_name"/>
                <field name="decision"/>
                <field name="state"/>
                <field name="lead_source_id"/>
                <separator/>
                <filter name="hot" string="HOT Leads"
                        domain="[('decision','=','hot')]"/>
                <filter name="cold" string="COLD Leads"
                        domain="[('decision','=','cold')]"/>
                <filter name="errors" string="Errors"
                        domain="[('state','=','error')]"/>
                <separator/>
                <filter name="group_decision" string="Group by Decision"
                        context="{'group_by': 'decision'}"/>
                <filter name="group_state" string="Group by State"
                        context="{'group_by': 'state'}"/>
                <filter name="group_lead_source" string="Group by Lead Source"
                        context="{'group_by': 'lead_source_id'}"/>
            </search>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════ -->
    <!-- Action + Menu                                        -->
    <!-- ════════════════════════════════════════════════════ -->

    <record id="action_web_lead" model="ir.actions.act_window">
        <field name="name">Web Leads</field>
        <field name="res_model">plasticos.web.lead</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_web_lead_search"/>
        <field name="context">{'search_default_hot': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No web leads yet
            </p>
            <p>
                Web leads are automatically captured from the website form
                and triaged by AI into HOT or COLD classifications.
            </p>
        </field>
    </record>

    <!-- Menu under PlasticOS root -->
    <menuitem id="menu_web_lead_root"
              name="Web Leads"
              parent="plasticos_intake.plasticos_root_menu"
              sequence="10"/>
    <menuitem id="menu_web_leads_all"
              name="All Web Leads"
              parent="menu_web_lead_root"
              action="action_web_lead"
              sequence="1"/>

</odoo>
