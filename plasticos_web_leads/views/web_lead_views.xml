<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════ -->
    <!-- List View                                            -->
    <!-- ════════════════════════════════════════════════════ -->

    <record id="view_web_lead_list" model="ir.ui.view">
        <field name="name">plasticos.web.lead.list</field>
        <field name="model">plasticos.web.lead</field>
        <field name="arch" type="xml">
            <list string="Web Leads" decoration-success="decision=='hot'" decoration-muted="state=='skipped'">
                <field name="lead_id"/>
                <field name="company_name"/>
                <field name="decision"/>
                <field name="state"/>
                <field name="estimated_lbs_per_load"/>
                <field name="estimated_loads_per_month"/>
                <field name="frequency"/>
                <field name="partner_id"/>
                <field name="intake_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════ -->
    <!-- Form View                                            -->
    <!-- ════════════════════════════════════════════════════ -->

    <record id="view_web_lead_form" model="ir.ui.view">
        <field name="name">plasticos.web.lead.form</field>
        <field name="model">plasticos.web.lead</field>
        <field name="arch" type="xml">
            <form string="Web Lead">
                <header>
                    <button name="action_retry_processing"
                            string="Retry Processing"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'error'"/>
                    <button name="action_force_create_intake"
                            string="Force Create Intake"
                            type="object"
                            class="btn-secondary"
                            invisible="intake_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="received,intake_created"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="lead_id" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="decision"/>
                            <field name="source"/>
                        </group>
                        <group string="Links">
                            <field name="partner_id"/>
                            <field name="intake_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contact">
                            <group>
                                <group>
                                    <field name="company_name"/>
                                    <field name="contact_name"/>
                                </group>
                                <group>
                                    <field name="contact_email"/>
                                    <field name="contact_phone"/>
                                </group>
                            </group>
                        </page>
                        <page string="Material">
                            <group>
                                <group>
                                    <field name="material_description"/>
                                    <field name="quantity_text"/>
                                </group>
                                <group>
                                    <field name="estimated_lbs_per_load"/>
                                    <field name="estimated_loads_per_month"/>
                                    <field name="frequency"/>
                                </group>
                            </group>
                            <group>
                                <field name="has_contaminants"/>
                                <field name="contaminant_notes"
                                       invisible="not has_contaminants"/>
                            </group>
                        </page>
                        <page string="AI Analysis">
                            <group>
                                <field name="ai_analysis" widget="text"/>
                                <field name="decision_reasons" widget="text"/>
                            </group>
                        </page>
                        <page string="Raw Payload">
                            <group>
                                <field name="raw_payload" widget="text"/>
                            </group>
                        </page>
                        <page string="Error" invisible="state != 'error'">
                            <group>
                                <field name="error_message"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════ -->
    <!-- Action + Menu                                        -->
    <!-- ════════════════════════════════════════════════════ -->

    <record id="action_web_lead" model="ir.actions.act_window">
        <field name="name">Web Leads</field>
        <field name="res_model">plasticos.web.lead</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_hot': 1}</field>
    </record>

    <!-- Search View -->
    <record id="view_web_lead_search" model="ir.ui.view">
        <field name="name">plasticos.web.lead.search</field>
        <field name="model">plasticos.web.lead</field>
        <field name="arch" type="xml">
            <search string="Web Leads">
                <field name="lead_id"/>
                <field name="company_name"/>
                <field name="decision"/>
                <field name="state"/>
                <separator/>
                <filter name="hot" string="HOT Leads"
                        domain="[('decision','=','hot')]"/>
                <filter name="cold" string="COLD Leads"
                        domain="[('decision','=','cold')]"/>
                <filter name="errors" string="Errors"
                        domain="[('state','=','error')]"/>
                <separator/>
                <filter name="group_decision" string="Decision"
                        context="{'group_by': 'decision'}"/>
                <filter name="group_state" string="State"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

</odoo>
