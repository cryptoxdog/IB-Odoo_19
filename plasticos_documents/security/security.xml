<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Odoo 19: Category → Privilege → Group -->
        <record id="module_category_documents" model="ir.module.category">
            <field name="name">Documents</field>
            <field name="sequence">220</field>
        </record>

        <record id="privilege_documents" model="res.groups.privilege">
            <field name="name">Documents</field>
            <field name="category_id" ref="module_category_documents"/>
        </record>

        <record id="group_documents_user" model="res.groups">
            <field name="name">Documents User</field>
            <field name="privilege_id" ref="privilege_documents"/>
        </record>

        <record id="group_documents_manager" model="res.groups">
            <field name="name">Documents Manager</field>
            <field name="privilege_id" ref="privilege_documents"/>
            <field name="implied_ids" eval="[(4, ref('group_documents_user'))]"/>
        </record>

        <record id="group_documents_extension_manager" model="res.groups">
            <field name="name">PlasticOS Documents Extension Manager</field>
            <field name="privilege_id" ref="privilege_documents"/>
            <field name="implied_ids" eval="[(4, ref('group_documents_manager'))]"/>
            <field name="comment">
                Manages document validation matrix and extended document rules.
            </field>
        </record>
    </data>
</odoo>
