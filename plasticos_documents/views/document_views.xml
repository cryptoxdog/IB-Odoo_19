<odoo>
    <record id="view_document_tree" model="ir.ui.view">
        <field name="name">plasticos.document.tree</field>
        <field name="model">plasticos.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="tag_id"/>
                <field name="verified"/>
                <field name="override"/>
            </list>
        </field>
    </record>

    <record id="view_document_form" model="ir.ui.view">
        <field name="name">plasticos.document.form</field>
        <field name="model">plasticos.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_verify" string="Verify" type="object"
                            class="btn-primary" invisible="verified"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tag_id"/>
                            <field name="attachment_id"/>
                        </group>
                        <group>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Verification">
                        <group>
                            <field name="verified"/>
                            <field name="verified_by"/>
                            <field name="verified_at"/>
                        </group>
                        <group>
                            <field name="override"/>
                            <field name="override_reason"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_document_list" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">plasticos.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_documents_root"
              name="Documents"
              web_icon="plasticos_documents,static/description/icon.png"
              sequence="80"/>

    <menuitem id="menu_documents_list"
              name="All Documents"
              parent="menu_documents_root"
              action="action_document_list"
              sequence="10"/>
</odoo>
