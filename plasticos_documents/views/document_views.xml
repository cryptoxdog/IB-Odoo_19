<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         SEARCH VIEW
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_document_search" model="ir.ui.view">
        <field name="name">plasticos.document.search</field>
        <field name="model">plasticos.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tag_id"/>
                <field name="res_model"/>
                <field name="verified_by"/>
                <field name="obligation_kind"/>
                <field name="operation_revision_key"/>
                <filter name="filter_verified" string="Verified"
                        domain="[('verified', '=', True)]"/>
                <filter name="filter_unverified" string="Unverified"
                        domain="[('verified', '=', False)]"/>
                <filter name="filter_override" string="Has Override"
                        domain="[('override', '=', True)]"/>
                <separator/>
                <filter name="filter_active" string="Active"
                        domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_tag" string="Tag"
                        context="{'group_by': 'tag_id'}"/>
                <filter name="group_model" string="Related Model"
                        context="{'group_by': 'res_model'}"/>
                <filter name="group_verified_by" string="Verified By"
                        context="{'group_by': 'verified_by'}"/>
                <filter name="group_obligation" string="Obligation"
                        context="{'group_by': 'obligation_kind'}"/>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         LIST VIEW
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_document_tree" model="ir.ui.view">
        <field name="name">plasticos.document.tree</field>
        <field name="model">plasticos.document</field>
        <field name="arch" type="xml">
            <list decoration-success="verified"
                  decoration-warning="not verified and not override"
                  decoration-muted="not active">
                <field name="name"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="tag_id"/>
                <field name="verified" widget="boolean" readonly="1"/>
                <field name="association_state" optional="show" readonly="1"/>
                <field name="obligation_kind" optional="show" readonly="1"/>
                <field name="operation_revision_key" optional="hide" readonly="1"/>
                <field name="coverage_key" optional="hide" readonly="1"/>
                <field name="verified_by" optional="show" widget="many2one_avatar_user" readonly="1"/>
                <field name="verified_at" optional="hide" readonly="1"/>
                <field name="override" widget="boolean" readonly="1"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_document_form_base" model="ir.ui.view">
        <field name="name">plasticos.document.form.base</field>
        <field name="model">plasticos.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_associate_from_form" string="Associate" type="object"
                            groups="plasticos_documents.group_documents_user"/>
                    <button name="action_verify" string="Verify" type="object"
                            class="btn-primary" invisible="verified"
                            groups="plasticos_documents.group_documents_user"/>
                    <button name="action_override" string="Override" type="object"
                            invisible="override"
                            groups="plasticos_documents.group_documents_manager"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tag_id"/>
                            <field name="attachment_id"/>
                        </group>
                        <group>
                            <field name="res_model" readonly="1"/>
                            <field name="res_id" readonly="1"/>
                            <field name="association_state" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Exact Association" name="association">
                        <group>
                            <field name="association_subject_model"/>
                            <field name="association_subject_id"/>
                            <field name="association_source_reference"/>
                            <field name="association_obligation_kind"
                                   placeholder="legacy"/>
                            <field name="association_operation_revision_key"
                                   invisible="not association_obligation_kind or association_obligation_kind == 'legacy'"/>
                            <field name="association_coverage_key"
                                   invisible="not association_obligation_kind or association_obligation_kind == 'legacy'"/>
                            <field name="association_quantity_known"
                                   invisible="not association_obligation_kind or association_obligation_kind == 'legacy'"/>
                            <field name="association_covered_quantity"/>
                            <field name="association_evidence_uom_id"
                                   invisible="not association_quantity_known"/>
                        </group>
                        <group>
                            <field name="source_reference" readonly="1"/>
                            <field name="source_revision" readonly="1"/>
                            <field name="covered_quantity" readonly="1"/>
                            <field name="associated_by" readonly="1"/>
                            <field name="associated_at" readonly="1"/>
                            <field name="subject_company_id" readonly="1"/>
                            <field name="pending_reason" readonly="1"/>
                        </group>
                    </group>
                    <group string="Operation Scope" name="operation_scope"
                           invisible="obligation_kind == 'legacy'">
                        <group>
                            <field name="obligation_kind" readonly="1"/>
                            <field name="operation_revision_key" readonly="1"/>
                            <field name="coverage_key" readonly="1"/>
                        </group>
                        <group>
                            <field name="quantity_known" readonly="1"/>
                            <field name="evidence_uom_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Verification" name="verification">
                        <group>
                            <field name="verified" readonly="1"/>
                            <field name="verified_by" readonly="1"/>
                            <field name="verified_at" readonly="1"/>
                            <field name="evidence_digest" readonly="1"/>
                        </group>
                        <group>
                            <field name="override" readonly="1"/>
                            <field name="override_reason" readonly="1"/>
                            <field name="override_by" readonly="1"/>
                            <field name="override_at" readonly="1"/>
                            <field name="override_reason_draft" invisible="override"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_document_list" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">plasticos.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_document_search"/>
        <field name="context">{'search_default_filter_unverified': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No documents yet
            </p>
            <p>
                Documents are attached to records for compliance verification.
            </p>
        </field>
    </record>

    <menuitem id="menu_documents_root"
              name="Documents"
              web_icon="plasticos_documents,static/description/icon.png"
              sequence="80"/>

    <menuitem id="menu_documents_list"
              name="All Documents"
              parent="menu_documents_root"
              action="action_document_list"
              sequence="10"/>
</odoo>
