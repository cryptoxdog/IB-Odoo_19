<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Full form view for plasticos.document (includes extension fields) -->
    <record id="view_document_form" model="ir.ui.view">
        <field name="name">plasticos.document.form</field>
        <field name="model">plasticos.document</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="tag_id"/>
                            <field name="attachment_id"/>
                        </group>
                        <group>
                            <field name="verified"/>
                            <field name="verified_by" readonly="1"/>
                            <field name="verified_at" readonly="1"/>
                            <field name="override"/>
                            <field name="override_reason"/>
                        </group>
                    </group>
                    <group string="Extended Tracking" name="extended_tracking">
                        <group>
                            <field name="doc_category"/>
                            <field name="transaction_id"/>
                            <field name="expiry_date"/>
                            <field name="is_expired" readonly="1"/>
                        </group>
                        <group>
                            <field name="version" readonly="1"/>
                            <field name="is_current" readonly="1"/>
                            <field name="superseded_by" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">plasticos.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Root menu -->
    <menuitem id="menu_documents_root"
              name="Documents"
              sequence="50"/>
    <menuitem id="menu_documents_list"
              name="All Documents"
              parent="menu_documents_root"
              action="action_document"
              sequence="10"/>
</odoo>
