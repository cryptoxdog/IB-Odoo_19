<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Extended Tracking fields added to base document form -->
    <record id="view_document_form_extended" model="ir.ui.view">
        <field name="name">plasticos.document.form.extended</field>
        <field name="model">plasticos.document</field>
        <field name="inherit_id" ref="view_document_form_base"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@string='Verification']" position="before">
                <group string="Extended Tracking" name="extended_tracking">
                    <group>
                        <field name="doc_category"/>
                        <field name="transaction_id"/>
                        <field name="expiry_date"/>
                        <field name="is_expired" readonly="1"/>
                    </group>
                    <group>
                        <field name="version" readonly="1"/>
                        <field name="is_current" readonly="1"/>
                        <field name="superseded_by" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
