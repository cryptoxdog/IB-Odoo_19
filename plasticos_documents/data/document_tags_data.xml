<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- ══════════════════════════════════════════════════════════
             Document Tags — Aligned with plasticos_documents_native
             
             Codes match DOC_TYPE_TAG_MAP in document_sync.py for
             seamless sync between native Enterprise docs and legacy.
             ══════════════════════════════════════════════════════════ -->

        <!-- ── Core Document Types ───────────────────────────────── -->
        <record id="tag_bol" model="plasticos.document.tag">
            <field name="name">Bill of Lading</field>
            <field name="code">BOL</field>
        </record>

        <record id="tag_invoice" model="plasticos.document.tag">
            <field name="name">Invoice / Vendor Bill</field>
            <field name="code">INV</field>
        </record>

        <record id="tag_scale_ticket" model="plasticos.document.tag">
            <field name="name">Scale Ticket</field>
            <field name="code">SCALE</field>
        </record>

        <record id="tag_loading_pic" model="plasticos.document.tag">
            <field name="name">Loading Pic</field>
            <field name="code">PHOTO</field>
        </record>

        <record id="tag_packing_list" model="plasticos.document.tag">
            <field name="name">Packing List</field>
            <field name="code">PACKING</field>
        </record>

        <record id="tag_customer_order" model="plasticos.document.tag">
            <field name="name">Customer Order</field>
            <field name="code">CO</field>
        </record>

        <record id="tag_receiving_report" model="plasticos.document.tag">
            <field name="name">Receiving Report</field>
            <field name="code">RECEIVING</field>
        </record>

        <!-- ── Carrier-Specific ──────────────────────────────────── -->
        <record id="tag_cst" model="plasticos.document.tag">
            <field name="name">Carrier Scale Ticket (CST)</field>
            <field name="code">CST</field>
        </record>

        <record id="tag_delivery_order" model="plasticos.document.tag">
            <field name="name">Delivery Order Confirmation</field>
            <field name="code">DO</field>
        </record>

        <!-- ── Compliance / Legal ────────────────────────────────── -->
        <record id="tag_contract" model="plasticos.document.tag">
            <field name="name">Contract</field>
            <field name="code">CONTRACT</field>
        </record>

        <record id="tag_certification" model="plasticos.document.tag">
            <field name="name">Certification</field>
            <field name="code">CERT</field>
        </record>

        <record id="tag_permit" model="plasticos.document.tag">
            <field name="name">Permit</field>
            <field name="code">PERMIT</field>
        </record>

        <record id="tag_lab_report" model="plasticos.document.tag">
            <field name="name">Lab / Test Report</field>
            <field name="code">LAB</field>
        </record>

        <!-- ── Other ─────────────────────────────────────────────── -->
        <record id="tag_correspondence" model="plasticos.document.tag">
            <field name="name">Correspondence</field>
            <field name="code">CORR</field>
        </record>

        <record id="tag_claim_photo" model="plasticos.document.tag">
            <field name="name">Claim Photo</field>
            <field name="code">CLAIM_PHOTO</field>
        </record>

        <record id="tag_other" model="plasticos.document.tag">
            <field name="name">Other</field>
            <field name="code">OTHER</field>
        </record>

    </data>
</odoo>
