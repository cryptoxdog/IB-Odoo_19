# Odoo / PostgreSQL configuration for scripts and Docker.
# Copy to .env and set values. Scripts source .env when present; defaults below are used if unset.
#
# Database (align with docker-compose db service)
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
POSTGRES_DB=odoo
#
# Odoo connection (for scripts that run Odoo in Docker)
ODOO_DB_HOST=db
ODOO_DB_PORT=5432
ODOO_COMPOSE_PROJECT=odoo19
#
# Rebuild script: default database to create/drop (override with script arg)
ODOO_DB_NAME=odoo
# Comma-separated module list for install/rebuild (optional; script has default list)
# ODOO_REBUILD_MODULES=plasticos_base,plasticos_intake,...

# Test script (run-odoo-tests.sh): test database name and optional default module list
ODOO_TEST_DB=odoo_test
# ODOO_TEST_MODULES=plasticos_base,plasticos_transaction,...
