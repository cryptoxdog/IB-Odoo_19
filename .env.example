# =============================================================================
# PlasticOS / Odoo 19 Environment Configuration
# Scrap Management Recycled Polymers Platform
#
# Copy to .env and set values. Scripts source .env when present.
# Docker Compose uses these for service configuration.
#
# ⚠️  CRITICAL: NO INLINE COMMENTS ALLOWED
#     Pydantic-settings parses entire line as value
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database (Odoo)
# -----------------------------------------------------------------------------
POSTGRES_USER=odoo
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=odoo

# -----------------------------------------------------------------------------
# Odoo Connection (Docker service names, NOT localhost)
# -----------------------------------------------------------------------------
ODOO_DB_HOST=db
ODOO_DB_PORT=5432
ODOO_COMPOSE_PROJECT=odoo19
ODOO_DB_NAME=odoo
ODOO_ADMIN_PASSWD=your_strong_random_admin_password_here

# -----------------------------------------------------------------------------
# Odoo Scripts Configuration
# -----------------------------------------------------------------------------
# Comma-separated module list for install/rebuild (optional; script has default)
# ODOO_REBUILD_MODULES=plasticos_base,plasticos_intake,...

# Test database name
ODOO_TEST_DB=odoo_test
# ODOO_TEST_MODULES=plasticos_base,plasticos_transaction,...

# -----------------------------------------------------------------------------
# Memory Substrate Database (L9 Integration)
# -----------------------------------------------------------------------------
MEMORY_POSTGRES_USER=postgres
MEMORY_POSTGRES_PASSWORD=your_memory_db_password_here
MEMORY_POSTGRES_DB=l9_memory
MEMORY_DSN=postgresql://${MEMORY_POSTGRES_USER}:${MEMORY_POSTGRES_PASSWORD}@l9-postgres:5432/${MEMORY_POSTGRES_DB}
DATABASE_URL=${MEMORY_DSN}

# -----------------------------------------------------------------------------
# Neo4j Graph Database
# -----------------------------------------------------------------------------
NEO4J_URL=bolt://neo4j:7687
NEO4J_URI=${NEO4J_URL}
NEO4J_USER=your_neo4j_user_here
NEO4J_PASSWORD=your_neo4j_password_here

# -----------------------------------------------------------------------------
# API Keys (External Services)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your_openai_key_here
PERPLEXITY_API_KEY=pplx-your_perplexity_key_here
