<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Odoo 19: Category → Privilege → Group -->
        <record id="module_category_transaction" model="ir.module.category">
            <field name="name">Transactions</field>
            <field name="sequence">230</field>
        </record>

        <record id="privilege_transaction" model="res.groups.privilege">
            <field name="name">Transactions</field>
            <field name="category_id" ref="module_category_transaction"/>
        </record>

        <record id="group_plasticos_manager" model="res.groups">
            <field name="name">Plasticos Manager</field>
            <field name="privilege_id" ref="privilege_transaction"/>
        </record>

        <record id="rule_plasticos_close_restrict" model="ir.rule">
            <field name="name">Plasticos Close Restrict</field>
            <field name="model_id" ref="plasticos_transaction.model_plasticos_transaction"/>
            <field name="groups" eval="[(4, ref('plasticos_transaction.group_plasticos_manager'))]"/>
            <field name="domain_force">[(1,'=',1)]</field>
        </record>

    </data>
</odoo>
