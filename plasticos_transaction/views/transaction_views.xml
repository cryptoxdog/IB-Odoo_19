<odoo>
    <record id="view_transaction_tree" model="ir.ui.view">
        <field name="name">plasticos.transaction.tree</field>
        <field name="model">plasticos.transaction</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id" optional="show"/>
                <field name="sale_order_id" optional="show"/>
                <field name="line_count" optional="hide"/>
                <field name="historical_sale_total" optional="show" sum="Historical Sale"/>
                <field name="historical_purchase_total" optional="show" sum="Historical Purchase"/>
                <field name="historical_margin" optional="show" sum="Historical Margin"/>
                <field name="revenue_total" optional="hide" sum="Total Revenue"/>
                <field name="cost_total" optional="hide" sum="Total Cost"/>
                <field name="gross_margin" optional="hide" sum="Total Margin"/>
                <field name="compliance_status"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_transaction_form" model="ir.ui.view">
        <field name="name">plasticos.transaction.form</field>
        <field name="model">plasticos.transaction</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'active'" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Orders">
                            <field name="user_id"/>
                            <field name="sale_order_id"/>
                            <field name="purchase_order_ids" widget="many2many_tags"/>
                            <field name="load_id"/>
                        </group>
                        <group string="Revenue">
                            <field name="revenue_total"/>
                        </group>
                    </group>
                    <group>
                        <group string="Costs">
                            <field name="purchase_cost_total"/>
                            <field name="freight_cost_total"/>
                            <field name="other_expenses"/>
                            <field name="cost_total"/>
                        </group>
                        <group string="Recoveries &amp; Margin">
                            <field name="freight_chargebacks"/>
                            <field name="lightweight_penalties"/>
                            <field name="gross_margin"/>
                            <field name="net_margin"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Invoices &amp; Bills">
                            <group>
                                <group string="Customer">
                                    <field name="customer_invoice_id"/>
                                </group>
                                <group string="Vendors">
                                    <field name="vendor_bill_ids" widget="many2many_tags"/>
                                    <field name="freight_bill_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>
                        <page string="Commission">
                            <group>
                                <field name="commission_rule_id"/>
                                <field name="commission_amount"/>
                                <field name="commission_locked"/>
                                <field name="commission_locked_amount" invisible="not commission_locked"/>
                            </group>
                        </page>
                        <page string="Compliance">
                            <group>
                                <field name="compliance_status"/>
                            </group>
                        </page>
                        <!-- Claims page moved to plasticos_claims module which extends this view -->
                        <page string="Historical Lines" invisible="line_count == 0">
                            <group>
                                <group string="Historical Totals (from cieTrade)">
                                    <field name="historical_sale_total"/>
                                    <field name="historical_purchase_total"/>
                                    <field name="historical_margin"/>
                                    <field name="line_count"/>
                                </group>
                            </group>
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="detail_id"/>
                                    <field name="grade_id"/>
                                    <field name="description"/>
                                    <field name="sale_weight"/>
                                    <field name="weight_uom"/>
                                    <field name="sale_price"/>
                                    <field name="sale_amount" sum="Total Sale"/>
                                    <field name="purchase_price"/>
                                    <field name="purchase_amount" sum="Total Purchase"/>
                                    <field name="margin" sum="Total Margin"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_transaction" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">plasticos.transaction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
