<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         SEARCH VIEW
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_transaction_search" model="ir.ui.view">
        <field name="name">plasticos.transaction.search</field>
        <field name="model">plasticos.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="sale_order_id"/>
                <field name="supplier_id"/>
                <field name="buyer_id"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_active" string="Active"
                        domain="[('state', '=', 'active')]"/>
                <filter name="filter_closed" string="Closed"
                        domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="filter_my_transactions" string="My Transactions"
                        domain="[('user_id', '=', uid)]"/>
                <filter name="filter_compliant" string="Compliant"
                        domain="[('compliance_status', '=', 'compliant')]"/>
                <filter name="filter_non_compliant" string="Non-Compliant"
                        domain="[('compliance_status', '!=', 'compliant')]"/>
                <separator/>
                <group name="group_by">
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_user" string="Salesperson"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_supplier" string="Supplier"
                            context="{'group_by': 'supplier_id'}"/>
                    <filter name="group_buyer" string="Buyer"
                            context="{'group_by': 'buyer_id'}"/>
                    <filter name="group_compliance" string="Compliance"
                            context="{'group_by': 'compliance_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         LIST VIEW
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_transaction_tree" model="ir.ui.view">
        <field name="name">plasticos.transaction.tree</field>
        <field name="model">plasticos.transaction</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'"
                  decoration-success="state == 'active'"
                  decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="user_id" optional="show" widget="many2one_avatar_user"/>
                <field name="sale_order_id" optional="show"/>
                <field name="line_count" optional="hide"/>
                <field name="historical_sale_total" optional="show" sum="Historical Sale"/>
                <field name="historical_purchase_total" optional="show" sum="Historical Purchase"/>
                <field name="historical_margin" optional="show" sum="Historical Margin"/>
                <field name="revenue_total" optional="hide" sum="Total Revenue"/>
                <field name="cost_total" optional="hide" sum="Total Cost"/>
                <field name="gross_margin" optional="hide" sum="Total Margin"/>
                <field name="compliance_status"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         PIVOT VIEW
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_transaction_pivot" model="ir.ui.view">
        <field name="name">plasticos.transaction.pivot</field>
        <field name="model">plasticos.transaction</field>
        <field name="arch" type="xml">
            <pivot string="Transaction Analysis">
                <field name="state" type="col"/>
                <field name="user_id" type="row"/>
                <field name="revenue_total" type="measure"/>
                <field name="cost_total" type="measure"/>
                <field name="gross_margin" type="measure"/>
                <field name="historical_margin" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         GRAPH VIEW
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_transaction_graph" model="ir.ui.view">
        <field name="name">plasticos.transaction.graph</field>
        <field name="model">plasticos.transaction</field>
        <field name="arch" type="xml">
            <graph string="Transactions by Salesperson" type="bar">
                <field name="user_id"/>
                <field name="gross_margin" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         FORM VIEW
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_transaction_form" model="ir.ui.view">
        <field name="name">plasticos.transaction.form</field>
        <field name="model">plasticos.transaction</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'active'" class="btn-success"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Orders" name="orders">
                            <field name="user_id"/>
                            <field name="sale_order_id"/>
                            <field name="purchase_order_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Revenue">
                            <field name="revenue_total"/>
                        </group>
                    </group>
                    <group>
                        <group string="Costs">
                            <field name="purchase_cost_total"/>
                            <field name="freight_cost_total"/>
                            <field name="other_expenses"/>
                            <field name="cost_total"/>
                        </group>
                        <group string="Recoveries &amp; Margin">
                            <field name="freight_chargebacks"/>
                            <field name="lightweight_penalties"/>
                            <field name="gross_margin"/>
                            <field name="net_margin"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Invoices &amp; Bills">
                            <group>
                                <group string="Customer">
                                    <field name="customer_invoice_id"/>
                                </group>
                                <group string="Vendors">
                                    <field name="vendor_bill_ids" widget="many2many_tags"/>
                                    <field name="freight_bill_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>
                        <page string="Commission">
                            <group>
                                <field name="commission_rule_id"/>
                                <field name="commission_amount"/>
                                <field name="commission_locked"/>
                                <field name="commission_locked_amount" invisible="not commission_locked"/>
                            </group>
                        </page>
                        <page string="Compliance">
                            <group>
                                <field name="compliance_status"/>
                            </group>
                        </page>
                        <!-- Claims page moved to plasticos_claims module which extends this view -->
                        <page string="Historical Lines" invisible="line_count == 0">
                            <group>
                                <group string="Historical Totals (from cieTrade)">
                                    <field name="historical_sale_total"/>
                                    <field name="historical_purchase_total"/>
                                    <field name="historical_margin"/>
                                    <field name="line_count"/>
                                </group>
                            </group>
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="detail_id"/>
                                    <field name="grade_id"/>
                                    <field name="description"/>
                                    <field name="sale_weight"/>
                                    <field name="weight_uom"/>
                                    <field name="sale_price"/>
                                    <field name="sale_amount" sum="Total Sale"/>
                                    <field name="purchase_price"/>
                                    <field name="purchase_amount" sum="Total Purchase"/>
                                    <field name="margin" sum="Total Margin"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_transaction" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">plasticos.transaction</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_transaction_search"/>
        <field name="context">{'search_default_filter_draft': 1, 'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No transactions yet
            </p>
            <p>
                Transactions link sales orders, purchase orders, and loads together
                to track revenue, costs, and margins.
            </p>
        </field>
    </record>
</odoo>
