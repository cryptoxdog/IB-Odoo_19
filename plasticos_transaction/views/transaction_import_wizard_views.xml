<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Transaction Import Wizard Form View -->
    <record id="view_transaction_import_wizard_form" model="ir.ui.view">
        <field name="name">plasticos.transaction.import.wizard.form</field>
        <field name="model">plasticos.transaction.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Transactions">
                <!-- Configuration State -->
                <group invisible="state != 'draft'">
                    <group string="Import Options">
                        <field name="use_default_file"/>
                        <field name="dry_run"/>
                        <field name="skip_existing"/>
                    </group>
                    <group string="Custom File" invisible="use_default_file">
                        <field name="csv_file" filename="csv_filename"/>
                        <field name="csv_filename" invisible="1"/>
                    </group>
                </group>

                <group invisible="state != 'draft'">
                    <div class="alert alert-info" role="alert">
                        <strong>Default File:</strong>
                        <code>cieTrade.WksDetail.csv</code>
                        <br/>
                        This file is located in the <code>plasticos_transaction</code> module directory.
                        <br/><br/>
                        <strong>CSV Format:</strong> cieTrade WksDetail export with columns:
                        <ul>
                            <li><code>BuySellNo</code> - Transaction reference (groups lines)</li>
                            <li><code>GradeID</code> - Material grade code</li>
                            <li><code>InvoiceDesc</code> - Material description</li>
                            <li><code>SWeight/SPrice/SAmount</code> - Sale data</li>
                            <li><code>PWeight/PPrice/PAmount</code> - Purchase data</li>
                        </ul>
                    </div>
                </group>

                <!-- Preview State -->
                <group invisible="state != 'preview'" string="Import Preview">
                    <group>
                        <field name="preview_tx_count" readonly="1"/>
                        <field name="preview_line_count" readonly="1"/>
                        <field name="preview_skip_count" readonly="1" invisible="preview_skip_count == 0"/>
                    </group>
                </group>

                <!-- Results (Preview and Done states) -->
                <group invisible="state == 'draft'">
                    <field name="result_message" readonly="1" nolabel="1"
                           widget="text" style="font-family: monospace; white-space: pre-wrap;"/>
                </group>

                <field name="state" invisible="1"/>

                <footer>
                    <!-- Draft state buttons -->
                    <button name="action_preview" type="object" string="Preview"
                            class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_import" type="object" string="Import"
                            class="btn-primary" invisible="state != 'draft'"/>

                    <!-- Preview state buttons -->
                    <button name="action_back" type="object" string="Back"
                            class="btn-secondary" invisible="state != 'preview'"/>
                    <button name="action_import" type="object" string="Confirm Import"
                            class="btn-primary" invisible="state != 'preview'"
                            context="{'force_import': True}"/>

                    <!-- Done state buttons -->
                    <button name="action_view_transactions" type="object" string="View Transactions"
                            class="btn-secondary" invisible="state != 'done'"/>

                    <!-- Always show close -->
                    <button name="action_close" type="object" string="Close"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_transaction_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Transactions (CSV)</field>
        <field name="res_model">plasticos.transaction.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item under Transactions -->
    <menuitem id="menu_transaction_import_wizard"
              name="Import Transactions (CSV)"
              parent="plasticos_intake.plasticos_root_menu"
              action="action_transaction_import_wizard"
              sequence="95"/>

</odoo>
