<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CieTrade has no quotes. A confirmed sale order is a sales order.
         Odoo 19 leaves these actions unfiltered, so confirmed orders also
         open under Quotations. Keep that menu to draft and sent only. -->
    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field name="domain">[('state', 'in', ('draft', 'sent'))]</field>
    </record>
    <record id="sale.action_quotations" model="ir.actions.act_window">
        <field name="domain">[('state', 'in', ('draft', 'sent'))]</field>
    </record>
    <record id="sale.action_quotations_salesteams" model="ir.actions.act_window">
        <field name="domain">[('state', 'in', ('draft', 'sent'))]</field>
    </record>
</odoo>
