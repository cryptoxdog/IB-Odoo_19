<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transaction_reopen_wizard_form" model="ir.ui.view">
        <field name="name">plasticos.transaction.reopen.wizard.form</field>
        <field name="model">plasticos.transaction.reopen.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="transaction_id" readonly="1"/>
                    <field name="reason" required="1" placeholder="Why this historical transaction is being reopened"/>
                </group>
                <footer>
                    <button name="action_reopen" type="object" string="Reopen" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
