<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <!-- Root category for scrap plastics (standalone root - no parent dependency) -->
    <record id="product_category_scrap" model="product.category">
      <field name="name">Scrap Plastics</field>
      <!-- No parent_id - this becomes a root category to avoid dependency on product.product_category_all -->
    </record>

    <!-- Polymer-based subcategories -->
    <record id="product_category_hdpe" model="product.category">
      <field name="name">HDPE</field>
      <field name="parent_id" ref="product_category_scrap"/>
    </record>
    <record id="product_category_ldpe" model="product.category">
      <field name="name">LDPE</field>
      <field name="parent_id" ref="product_category_scrap"/>
    </record>
    <record id="product_category_pp" model="product.category">
      <field name="name">PP</field>
      <field name="parent_id" ref="product_category_scrap"/>
    </record>
    <record id="product_category_pet" model="product.category">
      <field name="name">PET</field>
      <field name="parent_id" ref="product_category_scrap"/>
    </record>
    <record id="product_category_pvc" model="product.category">
      <field name="name">PVC</field>
      <field name="parent_id" ref="product_category_scrap"/>
    </record>
    <record id="product_category_ps" model="product.category">
      <field name="name">PS/HIPS/EPS</field>
      <field name="parent_id" ref="product_category_scrap"/>
    </record>
    <record id="product_category_engineering" model="product.category">
      <field name="name">Engineering Plastics</field>
      <field name="parent_id" ref="product_category_scrap"/>
    </record>
    <record id="product_category_mixed" model="product.category">
      <field name="name">Mixed/MRP</field>
      <field name="parent_id" ref="product_category_scrap"/>
    </record>
    <record id="product_category_pallets" model="product.category">
      <field name="name">Pallets &amp; Containers</field>
      <field name="parent_id" ref="product_category_scrap"/>
    </record>
    <record id="product_category_other" model="product.category">
      <field name="name">Other Materials</field>
      <field name="parent_id" ref="product_category_scrap"/>
    </record>
  </data>
</odoo>
