<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         SEARCH VIEW
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_offer_search" model="ir.ui.view">
        <field name="name">plasticos.offer.search</field>
        <field name="model">plasticos.offer</field>
        <field name="arch" type="xml">
            <search>
                <field name="intake_id"/>
                <field name="supplier_id"/>
                <field name="buyer_id"/>
                <field name="polymer"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_sent" string="Sent"
                        domain="[('state', '=', 'sent')]"/>
                <filter name="filter_responded" string="Responded"
                        domain="[('state', '=', 'responded')]"/>
                <filter name="filter_accepted" string="Accepted"
                        domain="[('state', '=', 'accepted')]"/>
                <filter name="filter_rejected" string="Rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="filter_pending_response" string="Pending Response"
                        domain="[('state', 'in', ('sent', 'responded'))]"/>
                <filter name="filter_expiring_soon" string="Expiring Soon"
                        domain="[('valid_until', '&lt;=', context_today() + relativedelta(days=7)),
                                 ('state', 'in', ('draft', 'sent', 'responded'))]"/>
                <separator/>
                <group name="group_by">
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_supplier" string="Supplier"
                            context="{'group_by': 'supplier_id'}"/>
                    <filter name="group_buyer" string="Buyer"
                            context="{'group_by': 'buyer_id'}"/>
                    <filter name="group_polymer" string="Polymer"
                            context="{'group_by': 'polymer'}"/>
                    <filter name="group_intake" string="Intake"
                            context="{'group_by': 'intake_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         LIST VIEW
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_offer_list" model="ir.ui.view">
        <field name="name">plasticos.offer.list</field>
        <field name="model">plasticos.offer</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'accepted'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state in ('expired','cancelled')">
                <field name="intake_id"/>
                <field name="polymer"/>
                <field name="form"/>
                <field name="supplier_id"/>
                <field name="buyer_id"/>
                <field name="price_per_lb"/>
                <field name="quantity_lbs" sum="Total Quantity"/>
                <field name="delivery_terms" optional="show"/>
                <field name="valid_until" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'sent')"
                       decoration-warning="state == 'responded'"
                       decoration-success="state == 'accepted'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state in ('expired', 'cancelled')"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         KANBAN VIEW
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_offer_kanban" model="ir.ui.view">
        <field name="name">plasticos.offer.kanban</field>
        <field name="model">plasticos.offer</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="intake_id"/>
                <field name="supplier_id"/>
                <field name="buyer_id"/>
                <field name="polymer"/>
                <field name="price_per_lb"/>
                <field name="quantity_lbs"/>
                <field name="valid_until"/>
                <field name="state"/>
                <progressbar field="state"
                             colors='{"draft": "secondary", "sent": "info", "responded": "warning", "accepted": "success", "rejected": "danger", "expired": "muted", "cancelled": "muted"}'/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="intake_id"/>
                                </strong>
                            </div>
                            <span class="badge bg-primary">
                                <field name="polymer"/>
                            </span>
                        </div>
                        <div class="o_kanban_record_body">
                            <div><strong>Supplier:</strong> <field name="supplier_id"/></div>
                            <div><strong>Buyer:</strong> <field name="buyer_id"/></div>
                            <div class="mt-2">
                                <span class="badge bg-success">$<field name="price_per_lb"/>/lb</span>
                                <span class="badge bg-secondary"><field name="quantity_lbs"/> lbs</span>
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left">
                                <span t-if="record.valid_until.raw_value" class="text-muted">
                                    Valid: <field name="valid_until"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         CALENDAR VIEW
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_offer_calendar" model="ir.ui.view">
        <field name="name">plasticos.offer.calendar</field>
        <field name="model">plasticos.offer</field>
        <field name="arch" type="xml">
            <calendar string="Offer Deadlines"
                      date_start="valid_until"
                      color="state"
                      mode="month"
                      quick_create="0">
                <field name="intake_id"/>
                <field name="buyer_id"/>
                <field name="polymer"/>
                <field name="price_per_lb"/>
            </calendar>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         PIVOT VIEW
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_offer_pivot" model="ir.ui.view">
        <field name="name">plasticos.offer.pivot</field>
        <field name="model">plasticos.offer</field>
        <field name="arch" type="xml">
            <pivot string="Offer Analysis">
                <field name="state" type="col"/>
                <field name="polymer" type="row"/>
                <field name="quantity_lbs" type="measure"/>
                <field name="price_per_lb" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         GRAPH VIEW
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_offer_graph" model="ir.ui.view">
        <field name="name">plasticos.offer.graph</field>
        <field name="model">plasticos.offer</field>
        <field name="arch" type="xml">
            <graph string="Offers by Status" type="bar">
                <field name="state"/>
                <field name="quantity_lbs" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         FORM VIEW
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_offer_form" model="ir.ui.view">
        <field name="name">plasticos.offer.form</field>
        <field name="model">plasticos.offer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" type="object"
                            string="Send" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_mark_responded" type="object"
                            string="Mark Responded" class="btn-primary"
                            invisible="state != 'sent'"/>
                    <button name="action_accept" type="object"
                            string="Accept" class="btn-success"
                            invisible="state not in ('sent','responded')"/>
                    <button name="action_reject" type="object"
                            string="Reject" class="btn-danger"
                            invisible="state in ('accepted','cancelled','expired')"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-secondary"
                            invisible="state in ('accepted','cancelled','expired')"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state not in ('rejected','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,responded,accepted"/>
                </header>
                <sheet>
                    <group>
                        <group string="Origin" name="origin">
                            <field name="match_result_id"/>
                            <field name="intake_id"/>
                        </group>
                        <group string="Parties">
                            <field name="supplier_id"/>
                            <field name="buyer_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Commercial Terms" name="commercial_terms">
                            <group>
                                <group string="Pricing">
                                    <field name="price_per_lb"/>
                                    <field name="currency_id"/>
                                    <field name="quantity_lbs"/>
                                    <field name="loads"/>
                                </group>
                                <group string="Terms">
                                    <field name="delivery_terms"/>
                                    <field name="payment_terms"/>
                                    <field name="valid_until"/>
                                </group>
                            </group>
                            <group string="Notes">
                                <field name="notes"/>
                            </group>
                        </page>

                        <page string="Response" name="response">
                            <group>
                                <group>
                                    <field name="response_notes"/>
                                    <field name="counter_price_per_lb"/>
                                </group>
                                <group>
                                    <field name="accepted_by"
                                           invisible="state != 'accepted'"/>
                                    <field name="accepted_date"
                                           invisible="state != 'accepted'"/>
                                    <field name="rejection_reason"
                                           invisible="state != 'rejected'"/>
                                </group>
                            </group>
                        </page>

                        <page string="Material">
                            <group>
                                <group>
                                    <field name="polymer"/>
                                    <field name="form"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         ACTION
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="action_offer" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">plasticos.offer</field>
        <field name="view_mode">kanban,list,calendar,pivot,graph,form</field>
        <field name="search_view_id" ref="view_offer_search"/>
        <field name="context">{'search_default_filter_pending_response': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No offers yet
            </p>
            <p>
                Offers are created from match results to propose pricing to buyers.
            </p>
        </field>
    </record>

    <!-- Menu under PlasticOS root -->
    <menuitem id="menu_offer_root"
              name="Offers"
              parent="plasticos_intake.plasticos_root_menu"
              sequence="25"/>
    <menuitem id="menu_offers"
              name="All Offers"
              parent="menu_offer_root"
              action="action_offer"
              sequence="1"/>

</odoo>
