<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_intake_form_offer_bridge" model="ir.ui.view">
        <field name="name">plasticos.intake.form.offer.bridge</field>
        <field name="model">plasticos.intake</field>
        <field name="inherit_id" ref="plasticos_intake.view_plasticos_intake_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_mark_processing']" position="before">
                <button
                    name="action_send_offers"
                    type="object"
                    string="Send Offer"
                    class="btn-primary"
                    invisible="status != 'matched' or selected_count == 0"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_offers"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-tag"
                    invisible="status not in ('offer_sent', 'processing', 'won')"
                >
                    <field name="offer_count" widget="statinfo" string="Offers"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
