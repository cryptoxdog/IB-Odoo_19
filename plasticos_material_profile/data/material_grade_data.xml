    <field name="sequence">210</field>
  </record>
  <record id="material_grade_sheet" model="plasticos.material.grade">
    <field name="name">Sheet</field>
    <field name="code">SHEET</field>
    <field name="description">Sheet goods as supplied (distinct from the Sheet form).</field>
    <field name="sequence">220</field>
  </record>
</odoo>
