<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <!--
    Material Forms - Current physical state of the material

    This is what the material IS now (not what it was, not how it's packaged)
    Examples: "LDPE Film" or "HDPE Regrind" or "PP Pellets"

    Origin Forms (Drums, Buckets, Bottles) are separate - use origin_form_id
    Packaging (Bales, Gaylords) are separate - use packaging_type_id
    -->
    <record id="form_bale" model="plasticos.material.form">
      <field name="name">Bales</field>
      <field name="code">BALES</field>
      <field name="description">Compressed bales of material (common for scrap).</field>
      <field name="sequence">5</field>
    </record>
    <record id="form_film" model="plasticos.material.form">
      <field name="name">Film</field>
      <field name="code">FILM</field>
      <field name="description">Thin plastic film sheets or rolls.</field>
      <field name="sequence">10</field>
    </record>
    <record id="form_regrind" model="plasticos.material.form">
      <field name="name">Regrind</field>
      <field name="code">REGRIND</field>
      <field name="description">Ground plastic from production scrap or post-consumer material.</field>
      <field name="sequence">20</field>
    </record>
    <record id="form_flake" model="plasticos.material.form">
      <field name="name">Flake</field>
      <field name="code">FLAKE</field>
      <field name="description">Washed and processed plastic chips, typically from bottles or containers.</field>
      <field name="sequence">30</field>
    </record>
    <record id="form_rollstock" model="plasticos.material.form">
      <field name="name">Rollstock</field>
      <field name="code">ROLLSTOCK</field>
      <field name="description">Rolls of plastic film or sheet material.</field>
      <field name="sequence">40</field>
    </record>
    <record id="form_pellets" model="plasticos.material.form">
      <field name="name">Pellets</field>
      <field name="code">PELLETS</field>
      <field name="description">Extruded and cut plastic pellets ready for molding.</field>
      <field name="sequence">50</field>
    </record>
    <record id="form_purge" model="plasticos.material.form">
      <field name="name">Purge</field>
      <field name="code">PURGE</field>
      <field name="description">Material purged from extruders or molding machines during color/material changes.</field>
      <field name="sequence">60</field>
    </record>
    <record id="form_chopped" model="plasticos.material.form">
      <field name="name">Chopped</field>
      <field name="code">CHOPPED</field>
      <field name="description">Chopped material, larger than regrind.</field>
      <field name="sequence">70</field>
    </record>
    <record id="form_shred" model="plasticos.material.form">
      <field name="name">Shred</field>
      <field name="code">SHRED</field>
      <field name="description">Shredded material.</field>
      <field name="sequence">80</field>
    </record>
    <record id="form_densified" model="plasticos.material.form">
      <field name="name">Densified</field>
      <field name="code">DENSIFIED</field>
      <field name="description">Densified material blocks.</field>
      <field name="sequence">90</field>
    </record>
    <record id="form_parts" model="plasticos.material.form">
      <field name="name">Parts</field>
      <field name="code">PARTS</field>
      <field name="description">Whole or broken plastic parts, often from manufacturing rejects.</field>
      <field name="sequence">100</field>
    </record>
    <record id="form_sheet" model="plasticos.material.form">
      <field name="name">Sheet</field>
      <field name="code">SHEET</field>
      <field name="description">Rigid plastic sheets or panels.</field>
      <field name="sequence">110</field>
    </record>
    <record id="form_powder" model="plasticos.material.form">
      <field name="name">Powder</field>
      <field name="code">POWDER</field>
      <field name="description">Finely ground plastic powder, typically for rotomolding.</field>
      <field name="sequence">120</field>
    </record>
    <record id="form_logs" model="plasticos.material.form">
      <field name="name">Logs</field>
      <field name="code">LOGS</field>
      <field name="description">Cylindrical logs of densified material.</field>
      <field name="sequence">130</field>
    </record>
    <record id="form_floorsweep" model="plasticos.material.form">
      <field name="name">Floorsweep</field>
      <field name="code">FLOORSWEEP</field>
      <field name="description">Factory floor sweepings, mixed contamination.</field>
      <field name="sequence">140</field>
    </record>
    <record id="form_drums" model="plasticos.material.form">
      <field name="name">Drums</field>
      <field name="code">DRUMS</field>
      <field name="description">Plastic drums and barrels (55-gallon, etc.). Use as Origin Form.</field>
      <field name="sequence">160</field>
    </record>
    <record id="form_buckets" model="plasticos.material.form">
      <field name="name">Buckets</field>
      <field name="code">BUCKETS</field>
      <field name="description">Plastic buckets and pails (5-gallon, etc.). Use as Origin Form.</field>
      <field name="sequence">170</field>
    </record>
    <record id="form_bottles" model="plasticos.material.form">
      <field name="name">Bottles</field>
      <field name="code">BOTTLES</field>
      <field name="description">Plastic bottles (milk jugs, detergent, water, etc.). Use as Origin Form.</field>
      <field name="sequence">180</field>
    </record>
    <record id="form_other" model="plasticos.material.form">
      <field name="name">Other</field>
      <field name="code">OTHER</field>
      <field name="description">Other material forms not listed above.</field>
      <field name="sequence">999</field>
    </record>
    <record id="form_loose" model="plasticos.material.form">
      <field name="name">Loose</field>
      <field name="code">LOOSE</field>
      <field name="description">Loose bulk material (unbaled).</field>
      <field name="sequence">155</field>
    </record>
    <record id="form_pallets" model="plasticos.material.form">
      <field name="name">Pallets</field>
      <field name="code">PALLETS</field>
      <field name="description">Plastic pallets or pallet parts.</field>
      <field name="sequence">165</field>
    </record>
    <record id="form_crates" model="plasticos.material.form">
      <field name="name">Crates</field>
      <field name="code">CRATES</field>
      <field name="description">Injection molded crates (dairy, produce, etc.).</field>
      <field name="sequence">175</field>
    </record>
    <record id="form_corrugated" model="plasticos.material.form">
      <field name="name">Corrugated</field>
      <field name="code">CORRUGATED</field>
      <field name="description">Corrugated plastic sheet or board material.</field>
      <field name="sequence">185</field>
    </record>
  </data>
</odoo>
