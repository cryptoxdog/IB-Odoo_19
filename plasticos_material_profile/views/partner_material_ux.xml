<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         PARTNER FORM — Material Profiles Tab
         Shows all material profiles for this company/facility.
         Visible for any company (supplier or buyer can both
         have material specifications on file).
         ═══════════════════════════════════════════════════════════ -->

    <record id="view_partner_form_material_tab" model="ir.ui.view">
        <field name="name">res.partner.form.material.profiles.tab</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">10</field>
        <field name="arch" type="xml">

            <!-- Priority 10 places this block above Locations (priority 16) and Notes (priority 99). -->
            <xpath expr="//notebook[page[@name='internal_notes']]" position="before">

                <separator string="Material Profile" invisible="not is_company"/>

                <div class="alert alert-light text-muted"
                     role="status"
                     invisible="not is_company or material_profile_count > 0">
                    <i class="fa fa-info-circle" title="Info"/>
                    No material profiles yet. Click "Add a line" to define what
                    materials this company supplies or accepts.
                </div>

                <field name="material_profile_ids"
                       invisible="not is_company"
                       context="{'default_partner_id': id,
                                 'form_view_ref': 'plasticos_material_profile.view_material_profile_form'}">
                    <list editable="bottom" open_form_view="1" class="o_material_profile_lines">
                        <field name="polymer_id"/>
                        <field name="material_grade_id" optional="show"/>
                        <field name="form_id"/>
                        <field name="color_id" optional="show"/>
                        <field name="source_type_id" optional="show"/>
                        <field name="packaging_type_id" string="Packaging Type" optional="show"/>
                    </list>
                </field>

            </xpath>

        </field>
    </record>

</odoo>
