<odoo>

  <!-- ═══════════════════════════════════════════════════════════════════
       LIST VIEW
       ═══════════════════════════════════════════════════════════════════ -->

  <record id="view_material_profile_list" model="ir.ui.view">
    <field name="name">plasticos.material.profile.list</field>
    <field name="model">plasticos.material.profile</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="polymer_id"/>
        <field name="form_id"/>
        <field name="color_id"/>
        <field name="source_type_id"/>
        <field name="monthly_volume_lbs" sum="Total Monthly Volume"/>
        <field name="contamination_percent"/>
      </list>
    </field>
  </record>

  <!-- ═══════════════════════════════════════════════════════════════════
       FORM VIEW (Standalone)
       ═══════════════════════════════════════════════════════════════════ -->

  <record id="view_material_profile_form" model="ir.ui.view">
    <field name="name">plasticos.material.profile.form</field>
    <field name="model">plasticos.material.profile</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <!-- Create Intake button added by plasticos_intake module -->
          <button name="action_create_purchase_order"
                  string="Make PO"
                  type="object"
                  class="btn-secondary"
                  icon="fa-shopping-cart"/>
          <button name="action_email_images"
                  string="Email Images"
                  type="object"
                  class="btn-secondary"
                  icon="fa-envelope-o"
                  invisible="image_count == 0"/>
        </header>
        <sheet>
          <!-- ═══ Smart Buttons (Jump To) ═══ -->
          <div class="oe_button_box" name="button_box">
            <!-- Intakes button added by plasticos_intake module -->
            <button name="action_view_po_lines"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-shopping-cart">
              <field name="po_line_count" string="PO Lines" widget="statinfo"/>
            </button>
            <button name="action_view_so_lines"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-truck">
              <field name="so_line_count" string="SO Lines" widget="statinfo"/>
            </button>
            <button name="action_view_facility"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-industry"
                    invisible="not partner_id">
              <span class="o_stat_text">Facility</span>
            </button>
            <button name="action_view_company"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-building"
                    invisible="not company_id">
              <span class="o_stat_text">Company</span>
            </button>
          </div>
          <!-- ═══ Material Images ═══ -->
          <field name="image_count" invisible="1"/>
          <group string="Material Images" invisible="image_count == 0">
            <field name="image_ids" nolabel="1" widget="many2many_binary"/>
          </group>

          <notebook>
            <page string="Profile">
              <!-- Row 1: Source + Packaging -->
              <group>
                <group string="Source">
                  <field name="partner_id" string="Facility"/>
                  <field name="company_id" string="Company" readonly="1"/>
                  <field name="source_type_id" string="Source Type"/>
                  <field name="polymer_id"/>
                  <field name="sub_grade" invisible="1"/>
                  <field name="form_id"/>
                  <field name="color_id"/>
                  <!-- color_flexibility moved to Buyer Fields tab -->
                </group>
                <group string="Packaging">
                  <field name="packaging_type_id" string="Packaging"/>
                  <field name="filler_type_id"/>
                  <field name="filler_pct" invisible="not filler_type_id"/>
                  <field name="origin_process_type" string="Process"/>
                  <!-- Hidden booleans used for matching downstream -->
                  <field name="previously_washed" invisible="1"/>
                  <field name="previously_pelletized" invisible="1"/>
                  <field name="material_attribute_ids" widget="many2many_tags" string="Attributes"/>
                </group>
              </group>

              <!-- Row 2: Volume / Supply + Specs -->
              <group>
                <group string="Volume / Supply Profile">
                  <field name="quantity_per_load_lbs"/>
                  <field name="loads_per_month"/>
                  <field name="avg_lot_size_lbs" string="Avg Weight Lbs"/>
                  <!-- min/max lot sizes removed per mockup -->
                  <field name="min_lot_size_lbs" invisible="1"/>
                  <field name="max_lot_size_lbs" invisible="1"/>
                  <field name="monthly_volume_lbs"/>
                  <field name="frequency" string="Load Frequency"/>
                  <field name="origin_form_id" string="Origin Form"/>
                </group>
                <group string="Geography">
                  <field name="lat"/>
                  <field name="lon"/>
                </group>
                <group string="Specs">
                  <field name="melt_flow_index"/>
                  <field name="density"/>
                  <field name="moisture_percent"/>
                  <field name="contamination_percent"/>
                </group>
              </group>

              <!-- Row 3: Notes (full width) -->
              <group>
                <field name="freeform_notes" nolabel="1" placeholder="Freeform Notes..."/>
              </group>
            </page>

            <page string="Buyer Fields">
              <group>
                <group string="Compliance">
                  <field name="food_grade"/>
                  <field name="medical_grade"/>
                  <field name="certification_notes"/>
                </group>
                <group string="Preferences">
                  <field name="color_flexibility"/>
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ═══════════════════════════════════════════════════════════════════
       PARTNER FORM EXTENSION — Smart Buttons Only
       NOTE: Material Profiles TAB is defined in partner_material_ux.xml
             This view only adds the stat button to button_box
       ═══════════════════════════════════════════════════════════════════ -->

  <record id="view_partner_form_material_tab_base" model="ir.ui.view">
    <field name="name">res.partner.form.material.stat.button</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">

      <!-- ═══ Smart Button: Material Profiles count ═══ -->
      <xpath expr="//div[@name='button_box']" position="inside">
        <field name="is_facility" invisible="1"/>
        <button name="action_view_material_profiles"
                type="object"
                class="oe_stat_button"
                icon="fa-cubes"
                invisible="material_profile_count == 0">
          <field name="material_profile_count" string="Profiles" widget="statinfo"/>
        </button>
      </xpath>

    </field>
  </record>

</odoo>
