<odoo>

  <!-- ═══════════════════════════════════════════════════════════════════
       LIST VIEW
       ═══════════════════════════════════════════════════════════════════ -->

  <record id="view_material_profile_list" model="ir.ui.view">
    <field name="name">plasticos.material.profile.list</field>
    <field name="model">plasticos.material.profile</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="polymer_id"/>
        <field name="form_id"/>
        <field name="color_id"/>
        <field name="source_type_id"/>
        <field name="monthly_volume_lbs" sum="Total Monthly Volume"/>
        <field name="contamination_percent"/>
      </list>
    </field>
  </record>

  <!-- ═══════════════════════════════════════════════════════════════════
       FORM VIEW (Standalone)
       ═══════════════════════════════════════════════════════════════════ -->

  <record id="view_material_profile_form" model="ir.ui.view">
    <field name="name">plasticos.material.profile.form</field>
    <field name="model">plasticos.material.profile</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <!-- Create Intake button added by plasticos_intake module -->
          <button name="action_create_purchase_order"
                  string="Make PO"
                  type="object"
                  class="btn-secondary"
                  icon="fa-shopping-cart"/>
        </header>
        <sheet>
          <!-- ═══ Smart Buttons (Jump To) ═══ -->
          <div class="oe_button_box" name="button_box">
            <!-- Intakes button added by plasticos_intake module -->
            <button name="action_view_po_lines"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-shopping-cart">
              <field name="po_line_count" string="PO Lines" widget="statinfo"/>
            </button>
            <button name="action_view_so_lines"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-truck">
              <field name="so_line_count" string="SO Lines" widget="statinfo"/>
            </button>
            <button name="action_view_facility"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-industry"
                    invisible="not partner_id">
              <span class="o_stat_text">Facility</span>
            </button>
            <button name="action_view_company"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-building"
                    invisible="not company_id">
              <span class="o_stat_text">Company</span>
            </button>
          </div>
          <notebook>
            <page string="Identity">
              <group>
                <group string="Source">
                  <field name="partner_id" string="Facility"/>
                  <field name="company_id" string="Company" readonly="1"/>
                </group>
                <group string="Material">
                  <field name="polymer_id"/>
                  <field name="sub_grade"/>
                  <field name="form_id"/>
                  <field name="origin_form_id"/>
                </group>
              </group>
              <group>
                <group string="Appearance">
                  <field name="color_id"/>
                  <field name="color_flexibility"/>
                </group>
              </group>
              <group string="Attributes">
                <field name="material_attribute_ids" widget="many2many_tags"/>
              </group>
            </page>

            <page string="Source &amp; Process">
              <group>
                <group>
                  <field name="source_type_id"/>
                  <field name="origin_process_type"/>
                </group>
                <group>
                  <field name="previously_washed"/>
                  <field name="previously_pelletized"/>
                </group>
              </group>
            </page>

            <page string="Quality">
              <group>
                <group string="Physical Properties">
                  <field name="melt_flow_index"/>
                  <field name="density"/>
                  <field name="moisture_percent"/>
                </group>
                <group string="Contamination">
                  <field name="contamination_percent"/>
                  <field name="has_metal"/>
                  <field name="is_metalized"/>
                  <field name="contains_fr"/>
                </group>
              </group>
              <group>
                <group string="Filler / Additives">
                  <field name="filler_type_id"/>
                  <field name="filler_pct" invisible="not filler_type_id"/>
                </group>
              </group>
            </page>

            <page string="Volume &amp; Packaging">
              <group>
                <group string="Volume">
                  <field name="avg_lot_size_lbs"/>
                  <field name="min_lot_size_lbs"/>
                  <field name="max_lot_size_lbs"/>
                  <field name="monthly_volume_lbs"/>
                  <field name="frequency"/>
                </group>
                <group string="Packaging">
                  <field name="packaging_type_id"/>
                  <field name="avg_truckloads_per_month"/>
                </group>
              </group>
            </page>

            <page string="Compliance &amp; Notes">
              <group>
                <group string="Compliance">
                  <field name="food_grade"/>
                  <field name="medical_grade"/>
                  <field name="certification_notes"/>
                </group>
                <group string="Notes">
                  <field name="freeform_notes"/>
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ═══════════════════════════════════════════════════════════════════
       PARTNER FORM EXTENSION (Material Profiles Tab)
       Uses view reference to avoid duplication
       ═══════════════════════════════════════════════════════════════════ -->

  <record id="view_partner_form_material_tab" model="ir.ui.view">
    <field name="name">res.partner.form.material.tab</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">

      <!-- ═══ Header: Create Intake button added by plasticos_intake module ═══ -->

      <!-- ═══ Smart Buttons (Jump To) for Facilities ═══ -->
      <xpath expr="//div[@name='button_box']" position="inside">
        <field name="is_facility" invisible="1"/>
        <button name="action_view_material_profiles"
                type="object"
                class="oe_stat_button"
                icon="fa-cubes"
                invisible="material_profile_count == 0">
          <field name="material_profile_count" string="Profiles" widget="statinfo"/>
        </button>
        <!-- Intakes button added by plasticos_intake module -->
      </xpath>

      <xpath expr="//sheet/notebook" position="inside">

        <page string="Material Profiles"
              invisible="not is_facility">

          <field name="material_profile_ids"
                 context="{'form_view_ref': 'plasticos_material_profile.view_material_profile_form'}">
            <list editable="bottom">
              <field name="polymer_id"/>
              <field name="form_id"/>
              <field name="color_id"/>
              <field name="source_type_id"/>
              <field name="monthly_volume_lbs" sum="Total Monthly Volume"/>
              <field name="contamination_percent"/>
            </list>
          </field>

        </page>

      </xpath>

    </field>
  </record>

</odoo>
