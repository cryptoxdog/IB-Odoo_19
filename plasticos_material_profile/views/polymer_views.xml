<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- ── List View ───────────────────────────────────────── -->
  <record id="plasticos_polymer_view_list" model="ir.ui.view">
    <field name="name">plasticos.polymer.list</field>
    <field name="model">plasticos.polymer</field>
    <field name="arch" type="xml">
      <list editable="bottom" default_group_by="category">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="code"/>
        <field name="full_name"/>
        <field name="resin_id_code"/>
        <field name="category"/>
        <field name="product_id" string="Product" optional="show"/>
      </list>
    </field>
  </record>

  <!-- ── Search View (filter/group by category) ─────────── -->
  <record id="plasticos_polymer_view_search" model="ir.ui.view">
    <field name="name">plasticos.polymer.search</field>
    <field name="model">plasticos.polymer</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="code"/>
        <field name="full_name"/>
        <separator/>
        <filter name="commodity" string="Commodity" domain="[('category', '=', 'commodity')]"/>
        <filter name="engineering" string="Engineering" domain="[('category', '=', 'engineering')]"/>
        <filter name="specialty" string="Specialty" domain="[('category', '=', 'specialty')]"/>
        <separator/>
        <group expand="0" string="Group By">
          <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ── Form View ─────────────────────────────────────────── -->
  <record id="plasticos_polymer_view_form" model="ir.ui.view">
    <field name="name">plasticos.polymer.form</field>
    <field name="model">plasticos.polymer</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_create_products"
                  string="Create Product"
                  type="object"
                  class="btn-primary"
                  icon="fa-cube"
                  invisible="product_id"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="code"/>
              <field name="full_name"/>
            </group>
            <group>
              <field name="resin_id_code"/>
              <field name="category"/>
              <field name="sequence"/>
            </group>
          </group>
          <group string="Linked Product">
            <field name="product_id" readonly="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ── Server Action: Create Products for Selected ────────── -->
  <record id="plasticos_polymer_action_create_products" model="ir.actions.server">
    <field name="name">Create Products</field>
    <field name="model_id" ref="plasticos_material_profile.model_plasticos_polymer"/>
    <field name="binding_model_id" ref="plasticos_material_profile.model_plasticos_polymer"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">
if records:
    records.action_create_products()
    </field>
  </record>

  <!-- ── Action ──────────────────────────────────────────── -->
  <record id="plasticos_polymer_action" model="ir.actions.act_window">
    <field name="name">Polymer Types</field>
    <field name="res_model">plasticos.polymer</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
