<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- ── List View ───────────────────────────────────────── -->
  <record id="plasticos_polymer_view_list" model="ir.ui.view">
    <field name="name">plasticos.polymer.list</field>
    <field name="model">plasticos.polymer</field>
    <field name="arch" type="xml">
      <list editable="bottom" default_group_by="category">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="code"/>
        <field name="full_name"/>
        <field name="resin_id_code"/>
        <field name="category"/>
      </list>
    </field>
  </record>

  <!-- ── Search View (filter/group by category) ─────────── -->
  <record id="plasticos_polymer_view_search" model="ir.ui.view">
    <field name="name">plasticos.polymer.search</field>
    <field name="model">plasticos.polymer</field>
    <field name="arch" type="xml">
      <search>
        <filter name="commodity" string="Commodity" domain="[('category', '=', 'commodity')]"/>
        <filter name="engineering" string="Engineering" domain="[('category', '=', 'engineering')]"/>
        <filter name="specialty" string="Specialty" domain="[('category', '=', 'specialty')]"/>
        <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
      </search>
    </field>
  </record>

  <!-- ── Form View ─────────────────────────────────────────── -->
  <record id="plasticos_polymer_view_form" model="ir.ui.view">
    <field name="name">plasticos.polymer.form</field>
    <field name="model">plasticos.polymer</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="code"/>
              <field name="full_name"/>
            </group>
            <group>
              <field name="resin_id_code"/>
              <field name="category"/>
              <field name="sequence"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ── Action ──────────────────────────────────────────── -->
  <record id="plasticos_polymer_action" model="ir.actions.act_window">
    <field name="name">Polymer Types</field>
    <field name="res_model">plasticos.polymer</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
