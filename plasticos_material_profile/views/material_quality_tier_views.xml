<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="plasticos_material_quality_tier_view_list" model="ir.ui.view">
    <field name="name">plasticos.material.quality.tier.list</field>
    <field name="model">plasticos.material.quality.tier</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="code"/>
        <field name="description"/>
        <field name="active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <record id="plasticos_material_quality_tier_action" model="ir.actions.act_window">
    <field name="name">Quality Tiers</field>
    <field name="res_model">plasticos.material.quality.tier</field>
    <field name="view_mode">list</field>
    <field name="context">{'active_test': False}</field>
  </record>

  <menuitem id="menu_material_quality_tiers"
            name="Quality Tiers"
            parent="menu_plasticos_config"
            action="plasticos_material_quality_tier_action"
            sequence="6"/>
</odoo>
