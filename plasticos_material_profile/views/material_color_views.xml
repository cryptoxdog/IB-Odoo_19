<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- ── List View ───────────────────────────────────────── -->
  <record id="plasticos_material_color_view_list" model="ir.ui.view">
    <field name="name">plasticos.material.color.list</field>
    <field name="model">plasticos.material.color</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="code"/>
        <field name="hex_code"/>
      </list>
    </field>
  </record>

  <!-- ── Action ──────────────────────────────────────────── -->
  <record id="plasticos_material_color_action" model="ir.actions.act_window">
    <field name="name">Material Colors</field>
    <field name="res_model">plasticos.material.color</field>
    <field name="view_mode">list</field>
  </record>
</odoo>
