<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_material_specification_list" model="ir.ui.view">
    <field name="name">plasticos.material.specification.list</field>
    <field name="model">plasticos.material.specification</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="status"/>
        <field name="version"/>
        <field name="polymer_id"/>
        <field name="form_id"/>
        <field name="color_id"/>
        <field name="company_id"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_material_specification_form" model="ir.ui.view">
    <field name="name">plasticos.material.specification.form</field>
    <field name="model">plasticos.material.specification</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="status"/>
              <field name="version"/>
              <field name="supersedes_id"/>
              <field name="active"/>
            </group>
            <group>
              <field name="canonical_uuid" readonly="1"/>
              <field name="company_id"/>
              <field name="contract_version"/>
              <field name="legacy_material_profile_id"/>
            </group>
          </group>
          <group string="Identity">
            <field name="polymer_id"/>
            <field name="form_id"/>
            <field name="color_id"/>
            <field name="source_type_id"/>
            <field name="filler_type_id"/>
            <field name="attribute_ids" widget="many2many_tags"/>
          </group>
          <group string="Ranges">
            <group>
              <field name="mfi_min"/>
              <field name="mfi_max"/>
              <field name="density_min"/>
              <field name="density_max"/>
            </group>
            <group>
              <field name="contamination_max_pct"/>
              <field name="moisture_max_pct"/>
              <field name="filler_min_pct"/>
              <field name="filler_max_pct"/>
              <field name="food_grade_required"/>
              <field name="medical_grade_required"/>
            </group>
          </group>
          <group string="Lineage">
            <field name="effective_from"/>
            <field name="effective_to"/>
            <field name="source_system"/>
            <field name="source_record_ref"/>
            <field name="migration_batch_id"/>
            <field name="notes"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_material_specification_search" model="ir.ui.view">
    <field name="name">plasticos.material.specification.search</field>
    <field name="model">plasticos.material.specification</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="canonical_uuid"/>
        <field name="polymer_id"/>
        <filter name="active_only" string="Active Status" domain="[('status', '=', 'active')]"/>
        <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
      </search>
    </field>
  </record>

  <record id="action_material_specification" model="ir.actions.act_window">
    <field name="name">Material Specifications</field>
    <field name="res_model">plasticos.material.specification</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
